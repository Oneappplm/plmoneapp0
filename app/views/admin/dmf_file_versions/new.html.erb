<div class="container mt-4">
  <h3>Upload SSA Death Master File</h3>

  <p class="text-muted">
    Upload the prepared compressed Death Master TSV artifact.
    The file will be uploaded directly to IDrive and then imported
    in the background.
  </p>

  <div class="card mt-4">
    <div class="card-body">

      <div class="mb-3">
        <label
          for="dmf-publication-date"
          class="form-label fw-bold"
        >
          DMF Publication Date
        </label>

        <input
          type="date"
          id="dmf-publication-date"
          class="form-control"
          value="<%= Date.current.strftime('%Y-%m-%d') %>"
          required
        >
      </div>

      <div class="mb-3">
        <label
          for="dmf-file-input"
          class="form-label fw-bold"
        >
          Death Master Artifact (.tsv.gz)
        </label>

        <input
          type="file"
          id="dmf-file-input"
          class="form-control"
          accept=".tsv.gz,application/gzip"
        >
      </div>

      <div
        id="dmf-file-details"
        class="alert alert-secondary d-none"
      ></div>

      <div class="mt-3">
        <button
          type="button"
          id="dmf-upload-button"
          class="btn btn-primary"
        >
          Upload &amp; Import DMF
        </button>

        <%= link_to(
              "Cancel",
              admin_dmf_file_versions_path,
              class: "btn btn-secondary"
            ) %>
      </div>

      <div
        id="dmf-progress-section"
        class="mt-4 d-none"
      >
        <h5>DMF Upload Progress</h5>

        <div class="progress">
          <div
            id="dmf-progress-bar"
            class="progress-bar progress-bar-striped progress-bar-animated"
            role="progressbar"
            style="width: 0%"
            aria-valuenow="0"
            aria-valuemin="0"
            aria-valuemax="100"
          >
            0%
          </div>
        </div>

        <div
          id="dmf-progress-status"
          class="small text-muted mt-2"
        ></div>
      </div>

      <div
        id="dmf-success-message"
        class="alert alert-success mt-3 d-none"
      ></div>

      <div
        id="dmf-error-message"
        class="alert alert-danger mt-3 d-none"
      ></div>

      <div
        id="dmf-duplicate-message"
        class="alert alert-warning mt-3 d-none"
      ></div>

    </div>
  </div>
</div>

<script>
(function () {
  function initializeDmfUpload() {
    const fileInput =
      document.getElementById("dmf-file-input");

    const publicationDateInput =
      document.getElementById("dmf-publication-date");

    const uploadButton =
      document.getElementById("dmf-upload-button");

    const fileDetails =
      document.getElementById("dmf-file-details");

    const progressSection =
      document.getElementById("dmf-progress-section");

    const progressBar =
      document.getElementById("dmf-progress-bar");

    const progressStatus =
      document.getElementById("dmf-progress-status");

    const successMessage =
      document.getElementById("dmf-success-message");

    const errorMessage =
      document.getElementById("dmf-error-message");

    const duplicateMessage =
      document.getElementById("dmf-duplicate-message");

    if (!fileInput || !uploadButton) {
      return;
    }

    if (uploadButton.dataset.initialized === "true") {
      return;
    }

    uploadButton.dataset.initialized = "true";

    function csrfToken() {
      return document
        .querySelector('meta[name="csrf-token"]')
        ?.getAttribute("content");
    }

    function escapeHtml(value) {
      const div =
        document.createElement("div");

      div.textContent =
        value == null
          ? ""
          : String(value);

      return div.innerHTML;
    }

    function formatBytes(bytes) {
      if (!bytes) {
        return "0 Bytes";
      }

      const units = [
        "Bytes",
        "KB",
        "MB",
        "GB",
        "TB"
      ];

      const index =
        Math.floor(
          Math.log(bytes) /
          Math.log(1024)
        );

      const value =
        bytes /
        Math.pow(1024, index);

      return (
        value.toFixed(
          index === 0 ? 0 : 2
        ) +
        " " +
        units[index]
      );
    }

    function formatRows(value) {
      if (
        value === null ||
        value === undefined
      ) {
        return "Not Available";
      }

      try {
        return new Intl
          .NumberFormat()
          .format(value);
      } catch (_) {
        return String(value);
      }
    }

    function hideMessages() {
      successMessage.classList.add(
        "d-none"
      );

      errorMessage.classList.add(
        "d-none"
      );

      duplicateMessage.classList.add(
        "d-none"
      );

      successMessage.innerHTML = "";
      errorMessage.innerHTML = "";
      duplicateMessage.innerHTML = "";
    }

    function resetProgress() {
      progressSection.classList.add(
        "d-none"
      );

      progressBar.style.width = "0%";
      progressBar.textContent = "0%";

      progressBar.setAttribute(
        "aria-valuenow",
        "0"
      );

      progressStatus.textContent = "";
    }

    function showError(message) {
      duplicateMessage.classList.add(
        "d-none"
      );

      successMessage.classList.add(
        "d-none"
      );

      errorMessage.innerHTML =
        escapeHtml(
          message ||
          "Unable to upload DMF."
        );

      errorMessage.classList.remove(
        "d-none"
      );
    }

    function showSuccess(message) {
      errorMessage.classList.add(
        "d-none"
      );

      duplicateMessage.classList.add(
        "d-none"
      );

      successMessage.innerHTML =
        escapeHtml(
          message ||
          "DMF uploaded successfully."
        );

      successMessage.classList.remove(
        "d-none"
      );
    }

    function setProgress(percent, message) {
      progressSection.classList.remove(
        "d-none"
      );

      const safePercent =
        Math.max(
          0,
          Math.min(
            100,
            Number(percent) || 0
          )
        );

      progressBar.style.width =
        `${safePercent}%`;

      progressBar.textContent =
        `${safePercent}%`;

      progressBar.setAttribute(
        "aria-valuenow",
        String(safePercent)
      );

      progressStatus.textContent =
        message || "";
    }

    async function parseJsonResponse(response) {
      const text =
        await response.text();

      if (!text) {
        return {};
      }

      try {
        return JSON.parse(text);
      } catch (_) {
        return {
          success: false,
          message: text
        };
      }
    }

    async function calculateSha256(file) {
      setProgress(
        2,
        "Calculating SHA256 checksum..."
      );

      const buffer =
        await file.arrayBuffer();

      const digest =
        await crypto.subtle.digest(
          "SHA-256",
          buffer
        );

      return Array
        .from(
          new Uint8Array(digest)
        )
        .map(
          byte =>
            byte
              .toString(16)
              .padStart(2, "0")
        )
        .join("");
    }

    async function checkDuplicate(sha256) {
      setProgress(
        5,
        "Checking whether this DMF has already been uploaded..."
      );

      const response =
        await fetch(
          "<%= check_duplicate_admin_dmf_file_versions_path %>",
          {
            method: "POST",

            headers: {
              "Content-Type":
                "application/json",

              "Accept":
                "application/json",

              "X-CSRF-Token":
                csrfToken()
            },

            credentials:
              "same-origin",

            body:
              JSON.stringify({
                sha256: sha256
              })
          }
        );

      const data =
        await parseJsonResponse(
          response
        );

      if (
        !response.ok ||
        !data.success
      ) {
        throw new Error(
          data.message ||
          "Unable to check DMF duplicate status."
        );
      }

      return data;
    }

    function showDuplicate(data) {
      progressSection.classList.add(
        "d-none"
      );

      errorMessage.classList.add(
        "d-none"
      );

      successMessage.classList.add(
        "d-none"
      );

      const publicationDate =
        data.publication_date
          ? escapeHtml(
              data.publication_date
            )
          : "Not Available";

      const sourceFilename =
        data.source_filename
          ? escapeHtml(
              data.source_filename
            )
          : "Not Available";

      const status =
        data.status
          ? escapeHtml(
              String(data.status)
            )
          : "Not Available";

      const active =
        data.active === true
          ? "Yes"
          : "No";

      const rows =
        formatRows(
          data.row_count
        );

      const versionId =
        data.version_id != null
          ? escapeHtml(
              data.version_id
            )
          : "Not Available";

      const viewButton =
        data.redirect_url
          ? `
              <div class="mt-3">
                <a
                  href="${escapeHtml(
                    data.redirect_url
                  )}"
                  class="btn btn-sm btn-outline-dark"
                >
                  View Existing Version
                </a>
              </div>
            `
          : "";

      duplicateMessage.innerHTML = `
        <div>
          <strong>
            Duplicate DMF File
          </strong>
        </div>

        <div class="mt-2">
          ${escapeHtml(
            data.message ||
            "This DMF file has already been uploaded."
          )}
        </div>

        <hr>

        <div>
          <strong>
            Existing Version:
          </strong>
          #${versionId}
        </div>

        <div>
          <strong>
            Source File:
          </strong>
          ${sourceFilename}
        </div>

        <div>
          <strong>
            Publication Date:
          </strong>
          ${publicationDate}
        </div>

        <div>
          <strong>
            Rows:
          </strong>
          ${escapeHtml(rows)}
        </div>

        <div>
          <strong>
            Status:
          </strong>
          ${status}
        </div>

        <div>
          <strong>
            Active:
          </strong>
          ${active}
        </div>

        ${viewButton}
      `;

      duplicateMessage.classList.remove(
        "d-none"
      );
    }

    async function presignUpload(file) {
      setProgress(
        10,
        "Preparing secure IDrive upload..."
      );

      const contentType =
        file.type ||
        "application/gzip";

      const response =
        await fetch(
          "<%= presign_upload_admin_dmf_file_versions_path %>",
          {
            method: "POST",

            headers: {
              "Content-Type":
                "application/json",

              "Accept":
                "application/json",

              "X-CSRF-Token":
                csrfToken()
            },

            credentials:
              "same-origin",

            body:
              JSON.stringify({
                filename:
                  file.name,

                content_type:
                  contentType
              })
          }
        );

      const data =
        await parseJsonResponse(
          response
        );

      if (
        !response.ok ||
        !data.success ||
        !data.url ||
        !data.key
      ) {
        throw new Error(
          data.message ||
          "Unable to prepare DMF upload."
        );
      }

      return data;
    }

    async function uploadToIdrive(
      url,
      file
    ) {
      return new Promise(
        (resolve, reject) => {
          const xhr =
            new XMLHttpRequest();

          xhr.open(
            "PUT",
            url,
            true
          );

          xhr.setRequestHeader(
            "Content-Type",
            file.type ||
            "application/gzip"
          );

          xhr.upload.onprogress =
            function (event) {
              if (
                !event.lengthComputable
              ) {
                return;
              }

              const uploadPercent =
                Math.round(
                  (
                    event.loaded /
                    event.total
                  ) *
                  100
                );

              const overallPercent =
                Math.min(
                  90,
                  15 +
                    Math.round(
                      uploadPercent *
                      0.75
                    )
                );

              setProgress(
                overallPercent,
                `Uploading to IDrive... ${uploadPercent}%`
              );
            };

          xhr.onload =
            function () {
              if (
                xhr.status >= 200 &&
                xhr.status < 300
              ) {
                resolve();
              } else {
                reject(
                  new Error(
                    `IDrive upload failed (${xhr.status}).`
                  )
                );
              }
            };

          xhr.onerror =
            function () {
              reject(
                new Error(
                  "IDrive upload failed. Please check the network or CORS configuration."
                )
              );
            };

          xhr.onabort =
            function () {
              reject(
                new Error(
                  "IDrive upload was cancelled."
                )
              );
            };

          xhr.send(file);
        }
      );
    }

    async function registerUpload({
      file,
      artifactKey,
      publicationDate,
      sha256
    }) {
      setProgress(
        95,
        "Registering DMF and starting background import..."
      );

      const response =
        await fetch(
          "<%= register_upload_admin_dmf_file_versions_path %>",
          {
            method: "POST",

            headers: {
              "Content-Type":
                "application/json",

              "Accept":
                "application/json",

              "X-CSRF-Token":
                csrfToken()
            },

            credentials:
              "same-origin",

            body:
              JSON.stringify({
                filename:
                  file.name,

                artifact_key:
                  artifactKey,

                publication_date:
                  publicationDate,

                sha256:
                  sha256
              })
          }
        );

      const data =
        await parseJsonResponse(
          response
        );

      /*
       * This is a second duplicate protection.
       *
       * Normally duplicate is detected before IDrive upload.
       * However two users could upload the same file at exactly
       * the same time, so backend can still return duplicate here.
       */
      if (data.duplicate) {
        showDuplicate(
          data
        );

        return {
          duplicate: true,
          data: data
        };
      }

      if (
        !response.ok ||
        !data.success
      ) {
        throw new Error(
          data.message ||
          "Unable to register DMF."
        );
      }

      return {
        duplicate: false,
        data: data
      };
    }

    fileInput.addEventListener(
      "change",
      function () {
        hideMessages();
        resetProgress();

        const file =
          fileInput.files[0];

        if (!file) {
          fileDetails.classList.add(
            "d-none"
          );

          fileDetails.innerHTML = "";

          return;
        }

        fileDetails.innerHTML = `
          <strong>File:</strong>
          ${escapeHtml(file.name)}
          <br>

          <strong>Size:</strong>
          ${escapeHtml(
            formatBytes(file.size)
          )}
        `;

        fileDetails.classList.remove(
          "d-none"
        );
      }
    );

    uploadButton.addEventListener(
      "click",
      async function () {
        hideMessages();
        resetProgress();

        const file =
          fileInput.files[0];

        const publicationDate =
          publicationDateInput.value;

        if (!file) {
          showError(
            "Please select a .tsv.gz DMF file."
          );

          return;
        }

        if (
          !file.name
            .toLowerCase()
            .endsWith(".tsv.gz")
        ) {
          showError(
            "Only .tsv.gz DMF files are allowed."
          );

          return;
        }

        if (!publicationDate) {
          showError(
            "Please select the DMF publication date."
          );

          return;
        }

        uploadButton.disabled =
          true;

        const originalButtonText =
          uploadButton.innerHTML;

        uploadButton.innerHTML =
          "Processing...";

        try {
          /*
           * STEP 1
           * Calculate file checksum BEFORE upload.
           */
          const sha256 =
            await calculateSha256(
              file
            );

          console.log(
            "[DMF UPLOAD] SHA256:",
            sha256
          );

          /*
           * STEP 2
           * Check duplicate BEFORE requesting
           * presigned URL and BEFORE uploading
           * anything to IDrive.
           */
          const duplicateResult =
            await checkDuplicate(
              sha256
            );

          if (
            duplicateResult.duplicate
          ) {
            console.warn(
              "[DMF UPLOAD] Duplicate detected:",
              duplicateResult
            );

            showDuplicate(
              duplicateResult
            );

            return;
          }

          /*
           * STEP 3
           * Get secure presigned upload URL.
           */
          const presigned =
            await presignUpload(
              file
            );

          /*
           * STEP 4
           * Upload directly from browser
           * to IDrive object storage.
           */
          await uploadToIdrive(
            presigned.url,
            file
          );

          /*
           * STEP 5
           * Register uploaded artifact
           * and queue Sidekiq import.
           */
          const registration =
            await registerUpload({
              file:
                file,

              artifactKey:
                presigned.key,

              publicationDate:
                publicationDate,

              sha256:
                sha256
            });

          if (
            registration.duplicate
          ) {
            return;
          }

          setProgress(
            100,
            "Upload completed. DMF import has been queued."
          );

          showSuccess(
            registration.data.message ||
            "DMF uploaded successfully. Import has been queued."
          );

          /*
           * Only NEW DMF versions redirect automatically.
           *
           * Duplicate versions do not redirect.
           */
          if (
            registration.data
              .redirect_url
          ) {
            window.setTimeout(
              function () {
                window.location.href =
                  registration.data
                    .redirect_url;
              },
              1000
            );
          }

        } catch (error) {
          console.error(
            "[DMF UPLOAD]",
            error
          );

          setProgress(
            0,
            "Upload failed."
          );

          showError(
            error.message ||
            "Unable to upload DMF."
          );

        } finally {
          uploadButton.disabled =
            false;

          uploadButton.innerHTML =
            originalButtonText;
        }
      }
    );
  }

  document.addEventListener(
    "DOMContentLoaded",
    initializeDmfUpload
  );

  document.addEventListener(
    "turbo:load",
    initializeDmfUpload
  );

  /*
   * In case script is loaded after DOMContentLoaded.
   */
  if (
    document.readyState === "interactive" ||
    document.readyState === "complete"
  ) {
    initializeDmfUpload();
  }
})();
</script>