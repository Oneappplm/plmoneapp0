<div class="container-fluid mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h3>SSA Death Master Management</h3>

    <%= link_to(
          "Register New DMF",
          new_admin_dmf_file_version_path,
          class: "btn btn-primary"
        ) %>
  </div>

  <div class="card mb-4">
    <div class="card-header">
      <strong>Current Active Death Master File</strong>
    </div>

    <div class="card-body">
      <% if @current_version.present? %>

        <div class="row">
          <div class="col-md-3">
            <strong>Status</strong>
            <div>
              <span class="badge bg-success">
                READY
              </span>
            </div>
          </div>

          <div class="col-md-3">
            <strong>Publication Date</strong>
            <div>
              <%= @current_version.publication_date || "Not available" %>
            </div>
          </div>

          <div class="col-md-3">
            <strong>Records</strong>
            <div>
              <%= number_with_delimiter(
                    @current_version.row_count
                  ) %>
            </div>
          </div>

          <div class="col-md-3">
            <strong>Imported</strong>
            <div>
              <%= @current_version.import_completed_at || "Not available" %>
            </div>
          </div>
        </div>

      <% else %>

        <div class="alert alert-warning mb-0">
          No active SSA Death Master dataset is currently available.
        </div>

      <% end %>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <strong>DMF Import History</strong>
    </div>

    <div class="card-body">
      <table class="table table-bordered table-hover">
        <thead>
          <tr>
            <th class="text-white">ID</th>
            <th class="text-white">Publication Date</th>
            <th class="text-white">Source File</th>
            <th class="text-white">Rows</th>
            <th class="text-white">Status</th>
            <th class="text-white">Active</th>
            <th class="text-white"></th>
          </tr>
        </thead>

        <tbody>
          <% @versions.each do |version| %>
            <tr>
              <td><%= version.id %></td>

              <td>
                <%= version.publication_date %>
              </td>

              <td>
                <%= version.source_filename %>
              </td>

              <td>
                <% if version.row_count.present? %>
                  <%= number_with_delimiter(
                        version.row_count
                      ) %>
                <% else %>
                  -
                <% end %>
              </td>

              <td>
                <%= version.status.humanize %>
              </td>

              <td>
                <%= version.active? ? "Yes" : "No" %>
              </td>

              <td>
                <%= link_to(
                      "View",
                      admin_dmf_file_version_path(version),
                      class: "btn btn-sm btn-outline-primary"
                    ) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>