<div class="container mt-3">
  <h3 class="text-center mb-3">License Webcrawler Discrepancy</h3>

  <div class="d-flex justify-content-end mb-2">
    <% if @licenses.present? %>
      <%= link_to 'Print',
          license_verification_webcrawler_discrepancy_mhc_work_ticklers_path(format: :csv),
          class: 'btn btn-primary btn-sm text-end' %>
    <% end %>
  </div>

  <table class="table table-bordered mt-3">
    <thead>
      <tr>
        <th class="text-white">Sr.</th>
        <th class="text-white">Practitioner Name</th>
        <th class="text-white">License Type</th>
        <th class="text-white">State</th>
        <th class="text-white">License Number</th>
        <th class="text-white">Expiration Date</th>
        <th class="text-white">Credentials Contact Name</th>
        <th class="text-white">Credentials Contact Phone</th>
        <th class="text-white">Credentials Contact Fax</th>
        <th class="text-white">Department/Division</th>
      </tr>
    </thead>

    <tbody>
      <% if @licenses.present? %>

        <% @licenses.each_with_index do |license, index| %>

          <% provider = license.provider_attest.provider_personal_informations.first %>

          <tr>
            <td><%= index + 1 %></td>

            <td>
              <%= link_to provider.fullname,
                mhc_verification_platform_path(
                  provider.provider_attest.id,
                  page_tab: 'licensure'
                ),
                class: "text-primary fw-semibold" %>
            </td>

            <td>
              <%= license.license_type || "N/A" %>
            </td>

            <td><%= license.state&.alpha_code %></td>
            <td><%= license.license_number %></td>
            <td><%= license.license_expiration_date&.strftime("%m/%d/%Y") || "-" %></td>
            <td><%= provider&.fullname || 'N/A' %></td>
            <td><%= provider&.cell_phone_number || 'N/A' %></td>
            <td><%= provider&.fax_number || 'N/A' %></td>
            <td>-</td>
          </tr>

        <% end %>

      <% else %>

      <tr>
      <td colspan="9" class="text-center text-danger fw-bold">
      No practitioners match the condition
      </td>
      </tr>

      <% end %>
      </tbody>
  </table>
  <% if @licenses %>
    <div class="col-lg-12 mt-3 mb-3">
      <div class="d-flex justify-content-between bg-medium-grey rounded align-items-center py-3">
        <div class="page_info ms-3 text-black">
          <%= page_entries_info @licenses %>
        </div>
        <% if params[:per_page ].present? %>
          <%= will_paginate @licenses, :params =>  {per_page: @per_page }, renderer: WillPaginate::ActionView::BootstrapLinkRenderer %>
        <% else %>
          <%= will_paginate @licenses, renderer: WillPaginate::ActionView::BootstrapLinkRenderer %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>