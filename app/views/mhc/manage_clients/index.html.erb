 <!-- image upload Modal -->
<div class="modal fade" id="imageUploadModal" tabindex="-1" aria-labelledby="downloadModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title" id="downloadModalLabel">Image Management</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <%= form_for(@document, url: provider_personal_uploaded_docs_mhc_manage_clients_path, html: { multipart: true, id: "editDocumentForm" }) do |f| %>
            <%= hidden_field_tag :_method, '', id: 'hidden_method_field' %>
            <%= hidden_field_tag :document_id %>
            <%= hidden_field_tag :authenticity_token,
            form_authenticity_token,                    # <— actual token value
            id: 'auth_token_field' %>

          <% if @document.errors.any? %>
            <div id="error_explanation" class="row my-2 text-red">
              <div class="col-lg-12">
                <h2><%= pluralize(@document.errors.count, "error") %> prohibited this document from being saved:</h2>
                <ul>
                  <% @document.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          <% end %>

          <%= f.hidden_field :provider_personal_information_id, value: '' %>

          <div class="form-group my-2">
            <label for="">Image Classification: </label>
            <%= f.select :image_classification, options_for_select(['', ''] + ProviderPersonalUploadedDoc.image_classifications.keys.map(&:titleize), f.object.image_classification), {}, class: 'form-select', placeholder: 'Image Classification' %>
          </div>

          <div class="form-group my-2">
            <label for="">Sub Section: </label>
            <%= f.select :sub_section, options_for_select(['', ''] + ProviderPersonalUploadedDoc.enum_list('sub_sections'), f.object.sub_section), {}, class: 'form-select', placeholder: 'Sub Section' %>
          </div>

          <div class="form-group my-2">
            <label for="">Description: </label>
            <%= f.text_area :description, class: 'form-control' %>
          </div>

          <div class="form-group my-2">
            <label for="">Exclude From Profile: </label>
            <%= f.check_box :exclude_from_profile %>
          </div>

          <div class="form-group my-2">
            <label for="">File Upload:</label>
            <%= f.file_field :file_upload, class: 'form-control', id: 'fileUploadInput', direct_upload: true %>
            <div id="uploadLoader" class="d-none mt-2">
              <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
              Uploading...
            </div>
            <div id="uploadedFilePreview" class="mt-2"></div>
          </div>

           <div class="form-group my-2">
              <%= link_to 'Back', manage_clients_path, class: 'btn btn-default'  %>
              <%= f.submit "Upload & Save", class: 'btn btn-success' %>
            </div>

        <% end %>
      </div>
    </div>
  </div>
</div>
<!-- view document Modal -->
<div class="modal fade" id="viewDocumentModal" tabindex="-1" aria-labelledby="viewDocumentModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title" id="viewDocumentModalLabel">View Document List</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <table class="table table-striped table-bordered table-responsive">
          <thead>
            <tr>
              <th scope="col" class="bg-primary text-white">Image Classification</th>
              <th scope="col" class="bg-primary text-white">Sub Section</th>
              <th scope="col" class="bg-primary text-white">File</th>
              <th scope="col" class="bg-primary text-white">Create Date</th>
              <th scope="col" class="bg-primary text-white">Action</th>
            </tr>
          </thead>
          <tbody>
            
          </tbody>
        </table>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <!-- <button type="button" class="btn btn-primary">Save changes</button> -->
      </div>
    </div>
  </div>
</div>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    let imageUploadModal = document.getElementById("imageUploadModal");
    const formEl  = document.getElementById("editDocumentForm");
    const token = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
    const methodField = document.getElementById("hidden_method_field"); //

    // Helper to turn "client_uploaded_documents" → "Client Uploaded Documents"
    function humanize(str) {
      if (!str) return "";
      return str
        .split("_")
        .map(w => w.charAt(0).toUpperCase() + w.slice(1))
        .join(" ");
    }


    // Delegate click handling to the container or body
    document.body.addEventListener("click", function (e) {
      const btn = e.target.closest(".edit-doc-btn");
      let personalInformationId = btn.getAttribute("data-personal-information-id");
      if (!btn) return; // not an edit button

      // --- run only when an edit button is clicked ---
      const docId = btn.dataset.docId;

      // Prepare the form for PATCH
      formEl.action = `/mhc/manage-clients/${docId}/update_uploaded_doc`;
      formEl.method = "post";          // HTML form stays POST
      methodField.value = "patch";     // Rails will treat as PATCH
      document.getElementById("provider_personal_uploaded_doc_provider_personal_information_id").value = personalInformationId;

      // Fetch the existing document details
      fetch(`/mhc/manage-clients/${docId}/show_uploaded_doc`, {
        method: "GET",
        headers: { "X-Requested-With": "XMLHttpRequest" }
      })
      .then(resp => {
        if (!resp.ok) throw new Error("Network error");
        return resp.json();
      })
      .then(data => {
        // Fill modal fields
        document.getElementById("provider_personal_uploaded_doc_image_classification")
          .value = humanize(data.image_classification);
        document.getElementById("provider_personal_uploaded_doc_sub_section")
          .value = data.sub_section;
        document.getElementById("provider_personal_uploaded_doc_description")
          .value = data.description;
        document.getElementById("provider_personal_uploaded_doc_exclude_from_profile")
          .checked = data.exclude_from_profile;
        document.getElementById("document_id")
          .value = data.id;

        // Show link to current file
        document.getElementById("uploadedFilePreview").innerHTML =
          `<a href="${data.file_url}" target="_blank">${data.file_name}</a>`;

        // Finally open the modal (if not using data-bs-toggle on the button)
        const modal = new bootstrap.Modal(document.getElementById("imageUploadModal"));
        modal.show();
      })
      .catch(err => console.error("Error loading document:", err));
    });

    imageUploadModal.addEventListener("show.bs.modal", function (event) {
      let button = event.relatedTarget; // Button that triggered the modal
      let personalInformationId = button.getAttribute("data-personal-information-id");
      // Set the values in the hidden fields inside the modal
      let modal = event.target;
      modal.querySelector("input[name='provider_personal_uploaded_doc[provider_personal_information_id]']").value = personalInformationId;
    });

    let viewDocumentModal = document.getElementById("viewDocumentModal");

    viewDocumentModal.addEventListener("show.bs.modal", function (event) {
      let button = event.relatedTarget; // Button that triggered the modal
      let personalInformationId = button.getAttribute("data-personal-information-id");

      let modalBody = viewDocumentModal.querySelector(".modal-body tbody");

      // Clear previous content
      modalBody.innerHTML = `<tr><td colspan="5" class="text-center">Loading...</td></tr>`;

      // Fetch uploaded documents via AJAX
      fetch(`/mhc/manage-clients/get_provider_uploaded_docs?id=${personalInformationId}`, {
        method: "GET",
        headers: {
          "X-Requested-With": "XMLHttpRequest",
        },
      })
        .then(response => response.json())
        .then(data => {
          modalBody.innerHTML = "";
          console.log(data);

          if (data.length > 0) {
            data.forEach(doc => {
              modalBody.innerHTML += `
                <tr>
                  <td>${doc.image_classification}</td>
                  <td>${doc.sub_section}</td>
                  <td><a href="${doc.file_url}" target="_blank">${doc.file_name}</a></td>
                  <td>${new Date(doc.created_at).toLocaleDateString()}</td>
                  <td style="    display: inline-flex;column-gap: 7px;">
                    <button type="button"
                      class="btn btn-primary btn-sm edit-doc-btn"
                      data-doc-id="${doc.id}"
                      data-bs-toggle="modal"
                      data-bs-target="#imageUploadModal"
                      data-personal-information-id="${doc.personal_information_id}">
                      <i class="bi bi-pencil"></i>
                    </button>

                    <form action="/mhc/manage-clients/delete_provider_personal_docs" method="POST" onsubmit="return confirm('Are you sure you want to delete?')">
                      <input type="hidden" name="authenticity_token" value="${token}">
                      <input type="hidden" name="_method" value="delete">
                      <input type="hidden" name="doc_id" value="${doc.id}">
                      <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-trash"></i></button>
                    </form>
                  </td>
                </tr>
              `;
            });
          } else {
            modalBody.innerHTML = `<tr><td colspan="5" class="text-center">No documents found.</td></tr>`;
          }
        })
        .catch(error => {
          console.error("Error fetching documents:", error);
          modalBody.innerHTML = `<tr><td colspan="5" class="text-center text-danger">Error loading documents.</td></tr>`;
        });
    });
  });
  // Use turbo:load if you have turbo-rails; otherwise DOMContentLoaded works.
  document.addEventListener("turbo:load", attachFileUploader);
  document.addEventListener("DOMContentLoaded", attachFileUploader);

  function attachFileUploader() {
    const fileInput      = document.getElementById("fileUploadInput");
    const previewDiv     = document.getElementById("uploadedFilePreview");
    const loader         = $("#uploadLoader");
    const providerInfoId = document.getElementById(
      "provider_personal_uploaded_doc_provider_personal_information_id"
    );
    const documentIdEl   = document.getElementById("document_id");

    if (!fileInput || fileInput.dataset.bound === "true") return;
    fileInput.dataset.bound = "true";

    let uploadInProgress = false;

    fileInput.addEventListener("change", function () {
      if (uploadInProgress || fileInput.files.length === 0) return;
      uploadInProgress = true;

      const file = fileInput.files[0];
      const formData = new FormData();
      formData.append("provider_personal_uploaded_doc[file_upload]", file);
      formData.append(
        "provider_personal_uploaded_doc[provider_personal_information_id]",
        providerInfoId.value
      );

      // ✅ if we already have a document id, send it so the controller knows to update
      if (documentIdEl.value) {
        formData.append("provider_personal_uploaded_doc[id]", documentIdEl.value);
      }

      loader.removeClass("d-none");

      fetch("/mhc/manage-clients/ajax_upload", {
        method: "POST",
        headers: {
          "X-CSRF-Token": document.querySelector("meta[name=csrf-token]").content
        },
        body: formData
      })
        .then(resp => resp.json())
        .then(data => {
          loader.addClass("d-none");
          previewDiv.innerHTML = "";

          if (data.success) {
            const link = document.createElement("a");
            link.href = data.file_url;
            link.target = "_blank";
            link.textContent = data.file_url;
            previewDiv.appendChild(link);
            // store the id returned so subsequent uploads update instead of create
            documentIdEl.value = data.document_id;
          } else {
            previewDiv.textContent = "Upload failed: " + data.errors.join(", ");
          }
        })
        .catch(err => {
          console.error("Upload error", err);
          previewDiv.textContent = "Upload failed.";
        })
        .finally(() => {
          uploadInProgress = false;
        });
    });
  }

</script>

<style>
  #viewDocumentModal .table td {
    white-space: normal !important;
    word-break: break-word;        
    max-width: 200px;              
  }
  #uploadedFilePreview {
    word-wrap: break-word;
  }
</style>
