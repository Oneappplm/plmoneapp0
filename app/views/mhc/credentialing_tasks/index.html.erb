<div class="container-fluid px-4 py-4 credentialing-task-page">
  <div class=" mb-4">
    <div class="row">
      <div class="col-lg-10">
        <h2 class="mb-1">Today's Tasks</h2>
        <p class="text-muted mb-0">Manage credentialing follow-ups that are due today, overdue, or upcoming.</p>
      </div>

      <div class="col-lg-2">
        <% if current_user.user_role.in?(%w[super_administrator administrator]) %>
          <% pending_resolution_count=FollowUp.where(resolution_status: :awaiting_manager_approval).count %>

          <%= link_to mhc_resolution_requests_path,class:"btn #{request.path.start_with?('/mhc/resolution_requests') ? 'btn-primary' : 'btn-light'}" do %>
            <i class="bi bi-check2-square me-1"></i>
            Resolution Requests

            <% if pending_resolution_count.positive? %>
              <span class="badge bg-danger ms-1"><%= pending_resolution_count %></span>
            <% end %>
          <% end %>
        <% end %>
      </div>      
    </div>
  </div>

  <!-- Summary Cards -->
  <div class="row g-3 mb-4">
    <!-- Overdue -->
    <div class="col-md-4">
      <div class="card shadow-sm h-100 task-summary-card overdue-summary-card">
        <div class="card-body d-flex justify-content-between align-items-center">
          <div>
            <p class="text-muted mb-1">Overdue Follow-ups</p>
            <h2 class="mb-0"><%= @overdue.count %></h2>
          </div>
          <div class="task-summary-icon">
            <i class="bi bi-exclamation-triangle"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- Due Today -->
    <div class="col-md-4">
      <div class="card shadow-sm h-100 task-summary-card due-summary-card">
        <div class="card-body d-flex justify-content-between align-items-center">
          <div>
            <p class="text-muted mb-1">Due Today</p>
            <h2 class="mb-0"><%= @due_today.count %></h2>
          </div>
          <div class="task-summary-icon">
            <i class="bi bi-calendar-check"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- Upcoming -->
    <div class="col-md-4">
      <div class="card shadow-sm h-100 task-summary-card upcoming-summary-card">
        <div class="card-body d-flex justify-content-between align-items-center">
          <div>
            <p class="text-muted mb-1">Upcoming Follow-ups</p>
            <h2 class="mb-0"><%= @upcoming_count %></h2>
          </div>
          <div class="task-summary-icon">
            <i class="bi bi-calendar3"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Overdue Follow Ups -->
  <div class="card shadow-sm mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
      <h5 class="mb-0 text-danger"><i class="bi bi-exclamation-circle me-2"></i>Overdue Follow-ups</h5>
      <span class="badge bg-danger"><%= @overdue.count %></span>
    </div>

    <div class="card-body p-0">
      <% if @overdue.any? %>
        <div class="table-responsive">
          <table class="table align-middle mb-0 credentialing-task-table">
            <thead>
              <tr>
                <th>Provider</th>
                <th>Payer</th>
                <th>Last Follow-up Date</th>
                <th>Follow-up Due Date</th>
                <th>Assigned To</th>
                <th>Status</th>
                <th class="text-end">Action</th>
              </tr>
            </thead>
            <tbody>
              <% @overdue.each do |detail| %>
                <% enrollment = detail.enrollment_provider %>
                <% last_follow_up = detail.follow_ups.where.not(followed_up_at: nil).order(followed_up_at: :desc).first %>
                <tr>
                  <!-- Provider -->
                  <td>
                    <div class="fw-semibold"><%= enrollment.provider&.fullname.presence || "-" %></div>
                    <% if enrollment.email_address.present? %>
                      <small class="text-muted"><%= enrollment.email_address %></small>
                    <% end %>
                  </td>

                  <!-- Payer -->
                  <td><%= detail.enrollment_payer.presence || "N/A" %></td>

                  <!-- Last Follow-up -->
                  <td>
                    <% if last_follow_up&.followed_up_at.present? %>
                      <%= last_follow_up.followed_up_at.strftime("%d %b %Y") %>
                    <% else %>
                      N/A
                    <% end %>
                  </td>

                  <!-- Due Date -->
                  <td><%= detail.next_follow_up_date.present? ? detail.next_follow_up_date.strftime("%d %b %Y") : "N/A" %></td>

                  <!-- Assigned User -->
                  <td><%= detail.assigned_user&.full_name.presence || "Unassigned" %></td>

                  <!-- Status -->
                  <td>
                    <span class="badge rounded-pill bg-danger"><%= (Date.current - detail.next_follow_up_date).to_i %> days overdue</span>
                  </td>

                  <!-- Action -->
                  <td class="text-end">
                    <%= link_to new_mhc_enrollment_provider_follow_up_path(enrollment, detail_id: detail.id), class: "btn btn-primary btn-sm px-3" do %>
                      <i class="bi bi-telephone me-1"></i>Follow Up
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="empty-task-state">
          <i class="bi bi-check-circle"></i>
          <h5>No overdue follow-ups</h5>
          <p class="text-muted mb-0">All credentialing follow-ups are up to date.</p>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Due Today -->
  <div class="card shadow-sm mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
      <h5 class="mb-0"><i class="bi bi-calendar-event me-2"></i>Follow-ups Due Today</h5>
      <span class="badge bg-primary"><%= @due_today.count %></span>
    </div>

    <div class="card-body p-0">
      <% if @due_today.any? %>
        <div class="table-responsive">
          <table class="table align-middle mb-0 credentialing-task-table">
            <thead>
              <tr>
                <th>Provider</th>
                <th>Payer</th>
                <th>Last Follow-up Date</th>
                <th>Follow-up Due Date</th>
                <th>Assigned To</th>
                <th>Status</th>
                <th class="text-end">Action</th>
              </tr>
            </thead>
            <tbody>
              <% @due_today.each do |detail| %>
                <% enrollment = detail.enrollment_provider %>
                <% last_follow_up = detail.follow_ups.where.not(followed_up_at: nil).order(followed_up_at: :desc).first %>
                <tr>
                  <!-- Provider -->
                  <td>
                    <div class="fw-semibold"><%= enrollment.provider&.fullname.presence || "-" %></div>
                    <% if enrollment.email_address.present? %>
                      <small class="text-muted"><%= enrollment.email_address %></small>
                    <% end %>
                  </td>

                  <!-- Payer -->
                  <td><%= detail.enrollment_payer.presence || "N/A" %></td>

                  <!-- Last Follow-up -->
                  <td>
                    <% if last_follow_up&.followed_up_at.present? %>
                      <%= last_follow_up.followed_up_at.strftime("%d %b %Y") %>
                    <% else %>
                      N/A
                    <% end %>
                  </td>

                  <!-- Due Date -->
                  <td><%= detail.next_follow_up_date.present? ? detail.next_follow_up_date.strftime("%d %b %Y") : "N/A" %></td>

                  <!-- Assigned User -->
                  <td><%= detail.assigned_user&.full_name.presence || "Unassigned" %></td>

                  <!-- Status -->
                  <td>
                    <span class="badge rounded-pill bg-warning text-dark">Due Today</span>
                  </td>

                  <!-- Action -->
                  <td class="text-end">
                    <%= link_to new_mhc_enrollment_provider_follow_up_path(enrollment, detail_id: detail.id), class: "btn btn-primary btn-sm px-3" do %>
                      <i class="bi bi-telephone me-1"></i>Follow Up
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="empty-task-state">
          <i class="bi bi-calendar-check"></i>
          <h5>No follow-ups due today</h5>
          <p class="text-muted mb-0">There are currently no credentialing follow-ups scheduled for today.</p>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Upcoming -->
  <div class="card shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
      <h5 class="mb-0"><i class="bi bi-calendar3 me-2"></i>Upcoming Follow-ups</h5>
      <span class="badge bg-secondary"><%= @upcoming_count %></span>
    </div>

    <div class="card-body p-0">
      <% if @upcoming.any? %>
        <div class="table-responsive">
          <table class="table align-middle mb-0 credentialing-task-table">
            <thead>
              <tr>
                <th>Provider</th>
                <th>Payer</th>
                <th>Last Follow-up Date</th>
                <th>Next Follow-up Date</th>
                <th>Assigned To</th>
                <th>Status</th>
                <th class="text-end">Action</th>
              </tr>
            </thead>
            <tbody>
              <% @upcoming.each do |detail| %>
                <% enrollment = detail.enrollment_provider %>
                <% last_follow_up = detail.follow_ups.where.not(followed_up_at: nil).order(followed_up_at: :desc).first %>
                <tr>
                  <!-- Provider -->
                  <td>
                    <div class="fw-semibold"><%= enrollment.provider&.fullname.presence || "-" %></div>
                    <% if enrollment.email_address.present? %>
                      <small class="text-muted"><%= enrollment.email_address %></small>
                    <% end %>
                  </td>

                  <!-- Payer -->
                  <td><%= detail.enrollment_payer.presence || "N/A" %></td>

                  <!-- Last Follow-up -->
                  <td>
                    <% if last_follow_up&.followed_up_at.present? %>
                      <%= last_follow_up.followed_up_at.strftime("%d %b %Y") %>
                    <% else %>
                      N/A
                    <% end %>
                  </td>

                  <!-- Next Follow-up -->
                  <td><%= detail.next_follow_up_date.present? ? detail.next_follow_up_date.strftime("%d %b %Y") : "N/A" %></td>

                  <!-- Assigned User -->
                  <td><%= detail.assigned_user&.full_name.presence || "Unassigned" %></td>

                  <!-- Status -->
                  <td>
                    <span class="badge rounded-pill bg-info text-dark">Upcoming</span>
                  </td>

                  <!-- Action -->
                  <td class="text-end">
                    <%= link_to new_mhc_enrollment_provider_follow_up_path(enrollment, detail_id: detail.id), class: "btn btn-outline-primary btn-sm px-3" do %>
                      <i class="bi bi-eye me-1"></i>View
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="empty-task-state">
          <i class="bi bi-calendar3"></i>
          <h5>No upcoming follow-ups</h5>
          <p class="text-muted mb-0">There are no future credentialing follow-ups scheduled.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>

<style>
  .credentialing-task-page {
    max-width: 1500px;
  }

  .task-summary-card {
    border-radius: 12px;
    transition: all 0.2s ease;
  }

  .task-summary-card:hover {
    transform: translateY(-2px);
  }

  .task-summary-icon {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
  }

  /* Overdue */
  .overdue-summary-card {
    border-left: 4px solid #dc3545 !important;
  }

  .overdue-summary-card .task-summary-icon {
    background: rgba(220, 53, 69, 0.1);
    color: #dc3545;
  }

  /* Due Today */
  .due-summary-card {
    border-left: 4px solid #0d6efd !important;
  }

  .due-summary-card .task-summary-icon {
    background: rgba(13, 110, 253, 0.1);
    color: #0d6efd;
  }

  /* Upcoming */
  .upcoming-summary-card {
    border-left: 4px solid #6c757d !important;
  }

  .upcoming-summary-card .task-summary-icon {
    background: rgba(108, 117, 125, 0.1);
    color: #6c757d;
  }

  /* Table */
  .credentialing-task-table thead th {
    border-bottom: 1px solid #e9ecef;
    color: #ffffff;
    font-size: 13px;
    font-weight: 600;
    padding: 14px 20px;
    white-space: nowrap;
  }

  .credentialing-task-table tbody td {
    padding: 16px 20px;
    vertical-align: middle;
  }

  .credentialing-task-table tbody tr:hover {
    background: #fafafa;
  }

  /* Empty State */
  .empty-task-state {
    padding: 45px 20px;
    text-align: center;
  }

  .empty-task-state i {
    display: block;
    font-size: 34px;
    color: #adb5bd;
    margin-bottom: 10px;
  }

  .empty-task-state h5 {
    margin-bottom: 5px;
  }
</style>
