<div class="container-fluid px-4 py-4">

  <div class="mb-4">
    <h2 class="mb-1">Resolution Requests</h2>

    <p class="text-muted mb-0">
      Review credentialing applications requested to be marked as resolved.
    </p>
  </div>

  <div class="card shadow-sm">

    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
      <h5 class="mb-0">
        Pending Manager Approval
      </h5>

      <span class="badge bg-warning text-dark">
        <%= @resolution_requests.count %>
      </span>
    </div>

    <div class="card-body p-0">

      <% if @resolution_requests.any? %>

        <div class="table-responsive">
          <table class="table align-middle mb-0">

            <thead>
              <tr>
                <th class="text-white">Provider</th>
                <th class="text-white">Payer</th>
                <th class="text-white">Requested By</th>
                <th class="text-white">Requested Date</th>
                <th class="text-white">Notes</th>
                <th class="text-white">Status</th>
                <th class="text-white">Action</th>
              </tr>
            </thead>

            <tbody>
              <% @resolution_requests.each do |follow_up| %>

                <% enrollment = follow_up.enrollment_provider %>

                <tr>

                  <td>
                    <strong>
                      <%= enrollment.provider&.fullname.presence || "N/A" %>
                    </strong>
                  </td>

                  <td>
                    <%= follow_up.enrollment_providers_detail&.enrollment_payer.presence || "N/A" %>
                  </td>

                  <td>
                    <%= follow_up.user.try(:fullname) ||
                        follow_up.user.try(:name) ||
                        "User" %>
                  </td>

                  <td>
                    <%= follow_up.created_at.strftime("%d %b %Y %I:%M %p") %>
                  </td>

                  <td style="max-width: 320px;">
                    <%= follow_up.notes %>
                  </td>

                  <td>
                    <span class="badge bg-warning text-dark">
                      Awaiting Manager Approval
                    </span>
                  </td>

                  <td class="text-end">

                    <div class="d-flex justify-content-end gap-2">

                      <%= button_to "Approve",
                                    approve_mhc_resolution_request_path(follow_up),
                                    method: :patch,
                                    class: "btn btn-success btn-sm",
                                    form: {
                                      data: {
                                        turbo_confirm: "Are you sure you want to approve this resolution?"
                                      }
                                    } %>

                      <%= button_to "Reject",
                                    reject_mhc_resolution_request_path(follow_up),
                                    method: :patch,
                                    class: "btn btn-outline-danger btn-sm",
                                    form: {
                                      data: {
                                        turbo_confirm: "Are you sure you want to reject this resolution?"
                                      }
                                    } %>

                    </div>

                  </td>

                </tr>

              <% end %>
            </tbody>

          </table>
        </div>

      <% else %>

        <div class="text-center py-5">

          <i class="bi bi-check-circle fs-1 text-muted"></i>

          <h5 class="mt-3">
            No pending resolution requests
          </h5>

          <p class="text-muted mb-0">
            All resolution requests have been reviewed.
          </p>

        </div>

      <% end %>

    </div>

  </div>

</div>
