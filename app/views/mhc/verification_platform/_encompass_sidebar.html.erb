<div class="enc-sidebar-new">
   <div class="enc-sidebar-title">
      <h6>Client Organization Tree</h6>
   </div>
   <div class="enc-sidebar-content">
      <div>
         <%= search_form_for @q, url: mhc_manage_clients_path, method: :get, html: { class: 'form_search_with_icon' } do |f| %>
	  <%= hidden_field_tag :client_name, params[:client_name] %>
            <div class="input-group mb-3">
              <%= f.text_field :name_or_attest_id_cont, 
                  value: "#{params.dig(:q, :name_or_attest_id_cont)}", 
                  placeholder: 'Search Name or Attest ID', 
                  class: "form-control py-1 border-dark"  %>
              <%= f.submit class: "btn btn-primary" %>
            </div>
         <% end %>
      </div>
      <div class="form-row mt-3">

         <div class="enc-sidebar-content-heading">
            <ul class="client-tree-list list-unstyled mb-0">
              <li>
                <i class='bx bx-buildings' ></i>
                <%= link_to "CUAN",
                    mhc_verification_platform_index_path(client_name: "CUAN"),
                    class: "client-tree-link" %>
              </li>

              <li>
                <i class='bx bx-buildings' ></i>
                <%= link_to "PRIMARY PARTNERSCARE",
                    mhc_verification_platform_index_path(client_name: "Primary PartnersCare"),
                    class: "client-tree-link" %>
              </li>

              <li>
                <i class='bx bx-buildings'></i>
                <%= link_to "BROWARD HEALTH",
                    mhc_verification_platform_index_path(client_name: "Broward Health"),
                    class: "client-tree-link" %>
              </li>
            </ul>
         </div>

         <div class="enc-sidebar-content-heading">
            <h6>
              <%= link_to mhc_reports_path, class: "text-dark fs-5" do %>
                <i class="bi bi-bar-chart-fill me-2"></i>
                  REPORTS
              <% end %>
            </h6>
        </div>

         <%# <div>
          <button
            type="button"
            id="generate-dea-bulk-report-btn"
            class="btn btn-primary">
            Generate Report
          </button>

          <a
            href="#"
            id="download-dea-bulk-report-btn"
            class="btn btn-success d-none"
            target="_blank"
            rel="noopener">
            Download CSV
          </a>
        </div> %>

         <div class="enc-sidebar-content-heading">
           <% if @client_organizations.present? %>
             <ul class="list-unstyled">
               <% @client_organizations.each do |client_organization| %>
                 <li class="mb-2 d-flex align-items-center">
                   <i class='bx bx-buildings me-2'></i>
                   <span><%= client_organization.organization_name %></span>
                 </li>
               <% end %>
             </ul>
           <% end %>
         </div>

         <%# <hr class="text-dark"> %>

         <%# <ul class="enc-sidebar-content-submenu">
            <li>Providers</li>
         </ul> %>
      </div>
   </div>
</div>


<script>
  document.addEventListener("DOMContentLoaded", function () {
    const button = document.getElementById("generate-dea-bulk-report-btn");
    const downloadBtn = document.getElementById("download-dea-bulk-report-btn");

    if (!button) return;

    button.addEventListener("click", async function () {
      button.disabled = true;
      const originalText = button.innerText;
      button.innerText = "Generating...";

      try {
        const response = await fetch("/webscrapers/quality_audits/generate_dea_bulk_report", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content
          }
        });

        const data = await response.json();

        if (!response.ok || !data.success) {
          throw new Error(data.message || "Failed to generate DEA bulk report.");
        }

        downloadBtn.href = data.download_url;
        downloadBtn.classList.remove("d-none");

        alert(`${data.message} Total rows: ${data.total_rows}`);
      } catch (error) {
        alert(error.message);
      } finally {
        button.disabled = false;
        button.innerText = originalText;
      }
    });
  });
</script>

<style>
  .client-tree-list li {
    margin-bottom: 8px;
    position: relative;
  }

  .client-tree-list li::before {
    position: absolute;
    left: -14px;
    color: #0d6efd;
  }

  .client-tree-link {
    text-decoration: none;
    color: #212529;
    font-size: 14px;
  }
</style>
