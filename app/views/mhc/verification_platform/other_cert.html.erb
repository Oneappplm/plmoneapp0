<% applicability = section_applicability(@provider_personal_information, "other_cert") %>
<% other_cert_not_applicable = section_not_applicable?(@provider_personal_information, "other_cert") %>

<style>
  #other_cert-section .page-applicable {
    <%= "display: none !important;" if other_cert_not_applicable %>
  }

  #other_cert-section .page-not-applicable {
    <%= "display: none !important;" unless other_cert_not_applicable %>
  }
</style>
<div class="enc-content section-applicability-container"
     id="other_cert-section"
     data-section-key="other_cert">
    <div class="container">
        <%= render "top_nav_buttons"%>

        <div class="mt-4 d-flex align-items-end justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <h4 class="page-heading">Other Certifications</h4>
                <%= render "section_applicability", section_key: "other_cert" %>
            </div>
            <a class="btn btn-primary py-1 page-applicable" href="<%= mhc_verification_platform_index_path(page_tab: 'add_other_cert')%>" id="AddNewEducation">
                <i class='bx bx-plus'></i>
                Add New Other Certification
            </a>
        </div>
        <div class="mt-2 page-applicable">
            <span class="page-note">
                <i class='bx bx-error-circle font-red'></i> <span>Please list all other current certifications.
                    Required fields are marked with the symbol “<span class="font-red">*</span>”.</span>
            </span>
            <span class="page-note">
                <i class='bx bx-error-circle font-red'></i> <span>Please check the Not Applicable button if you do
                    not hold any other certifications.</span>
            </span>
        </div>
        <table class="table table-bordered practice-table mt-3 page-applicable ">
            <thead>
                <tr>
                    <th scope="col">Type</th>
                    <th>Certification Number</th>
                    <th>Issue Date</th>
                    <th>Certification Expiration Date</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><a href="<%= mhc_verification_platform_path(page_tab: 'other_cert_info')%>" id=""
                            class="text-dark text-start bg-transparent border-0 fw-bold text-decoration-none">Lorem
                            ipsum dolor sit amet consectetur adipisicing elit. </a></td>
                    <td>Lorem.</td>
                    <td>1/7/2004</td>
                    <td>1/1/2008</td>
                </tr>
            </tbody>
        </table>
        <%= render "section_applicability_explanation",
           section_key: "other_cert" %>
    </div>
</div>
