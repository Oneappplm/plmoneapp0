<div class="enc-content">
  <div class="container">
    <%= render "top_nav_buttons"%>
     
    <div class="add-license-content mt-4">
      <div class="row">
        <div class="col-xl-6 d-flex align-items-center">
            <div class="d-flex align-items-center gap-3">
                <a href="<%= mhc_verification_platform_path(page_tab: 'facilities')%>" class="link-back">
                    <i class='bx bx-left-arrow-alt'></i>
                </a>
                <h4 class="page-heading">Add New Facility</h4>
            </div>
        </div>
        <%= form_with model: [:mhc, @facility] do |form| %>
          <%= form.hidden_field :caqh_provider_attest_id %>
          <%= form.hidden_field :provider_attest_id, value: params[:id]  %>
          <div class="col-xl-12 right-pane mt-3">
            <div class="d-flex align-items-center gap-10">
              <span class="page-note">
                <i class='bx bx-error-circle font-blue'></i> <span>To search for a Facility name, please click the Search button..</span>
              </span>
            </div>

              <div class="form-row row mt-2">
                <div class="col-xl-5">
                  <%= form.label :facility_name, "Facility Name:" %>
                  <%= form.text_field :facility_name, class: 'form-control border border-dark', placeholder: 'Type here...' %>
                </div>
                <%# <div class="col-xl-1"> %>
                  <%# <div class="d-flex align-items-center gap-10"> %>
                      <%# <button class="btn-search_add_facility" type="submit">
                          Search
                      </button> %>
                      <%# <button type="button" class="btn btn-primary" id="openModal">Search</button>
                  </div>
                </div> %>
                <div class="col-xl-1 d-flex align-items-center">
                  <button type="button" class="btn btn-primary px-4 py-2 mt-3" id="openModal" style="border-radius: 8px; font-weight: bold;">
                    Search
                  </button>
                </div>

                <!-- Search modal popup start here -->
                <div id="myModal" class="modal">	
                  <div class="modal-content">
                    <p>
                      To search for an existing Facility, please select the Country, State or Province, City and Facility Name from the drop down lists. If your Facility is not on the list, click the New button. Complete the requested address information of the department or office that may verify your affiliation/privileges status.. Click the Save button. Click the Close button to populate the record with the new address information.
                    </p>

                    <div class="search-group">
                      <div class="form-group">
                        <label for="country">By Country:</label>
                        <select id="country-select" name="country" class="form-control">
                          <option value="">Select Country</option>
                        </select>
                      </div>
                      <div class="form-group">
                        <label for="state">By State/Province:</label>
                        <select id="state-select" name="state" class="form-control">
                          <option value="">Select State</option>
                        </select>
                      </div>
                      
                      <div class="form-group">
                        <label>By City:</label>
                        <input type="text" class="form-control" placeholder="Enter City Name" id="input-city" />
                      </div>

                      <div class="form-group">
                        <label>By Facility:</label>
                        <input type="text" class="form-control" placeholder="Enter Carrier Name" id="input-carrier" />
                        <button class="btn btn-primary mt-2">Search</button>
                      </div>
                    </div>

                    <div class="form-section">
                      <div class="form-section-header">Facility Information -Address of Department/Office Verifying Affiliation/Privileges.</div>
                      <div class="form-group">
                        <label>Facility:</label>
                        <input type="text" id="auto-carrier-name" />
                      </div>
                      <div class="form-group">
                        <label>Address:</label><input type="text" />
                      </div>
                      <div class="form-group">
                        <label>Contact:</label><input type="text" />
                      </div>
                      <div class="form-group">
                        <label>Additional Address:</label><input type="text" />
                      </div>
                      <div class="form-group">
                        <label>City:</label>
                        <input type="text" id="auto-city" />
                      </div>
                      <div class="form-group">
                        <label>County:</label>
                        <input type="text" id="county-input" />
                      </div>
                      <div class="form-group">
                        <label>State/Province:</label>
                        <select id="lower-state-select">
                          <option value="">Select State</option>
                        </select>
                      </div>
                      <div class="form-group">
                        <label>Zip/Postal Code:</label>
                        <input type="text" id="county-input" />
                      </div>
                      <div class="form-group">
                        <label>Contact Method:</label>
                        <select>
                          <option>Letter</option>
                          <option>Phone</option>
                          <option>Email</option>
                        </select>
                      </div>
                      <div class="form-group">
                        <label>Phone:</label><input type="text" placeholder="(xxx-xxx-xxxx)" />
                      </div>
                      <div class="form-group">
                        <label>Fax:</label><input type="text" placeholder="(xxx-xxx-xxxx)" />
                      </div>
                      <div class="form-group">
                        <label>Email:</label><input type="email" />
                      </div>
                    </div>

                    <div class="form-actions">
                      <button>New</button>
                      <button type="button" id="modal-close-btn">Close</button>
                    </div>
                  </div>
                </div>
                <!-- Search modal popup end here -->
              </div>

              <div class="col-xl-6">
                <%= form.label :contact, "Contact:" %>
                <%= form.select :contact, options_for_select(["Fax", "Email", "Letter"]), { prompt: "Select option" }, class: "form-select" %>
              </div>

              <div class="form-row row mt-2">
                <div class="col-xl-6">
                  <%= form.label :address, "Address:" %>
                  <%= form.text_field :address, class: 'form-control border border-dark', placeholder: 'Type here...' %>
                </div>
                <div class="col-xl-6">
                  <%= form.label :addition_address, "Additional Address:" %>
                  <%= form.text_field :addition_address, class: 'form-control border border-dark', placeholder: 'Type here...' %>
                </div>
              </div>

              <div class="form-row row mt-2">
                <div class="col-xl-6">
                  <%= form.label :city, "City:" %>
                  <%= form.text_field :city, class: 'form-control border border-dark', placeholder: 'Type here...' %>
                </div>
                <div class="col-xl-6">
                  <%= form.label :county, "County:" %>
                  <%= form.text_field :county, class: 'form-control border border-dark', placeholder: 'Type here...' %>
                </div>
              </div>

              <div class="form-row row mt-2">
                <div class="col-xl-4">
                  <%= form.label :state, "State/Province:" %>
                  <%= form.collection_select :state, State.all, :id, :name, { include_blank: "Select State" }, class: "form-select form-select-lg" %>
                </div>
                <div class="col-xl-4">
                  <%= form.label :zip_code, "Zip/Postal Code:" %>
                  <%= form.text_field :zip_code, class: 'form-control border border-dark', placeholder: 'Type here...' %>
                </div>
                <div class="col-xl-4">
                  <%= form.label :country, "Country:" %>
                  <%= form.text_field :country, class: 'form-control border border-dark', placeholder: 'Type here...' %>
                </div>
              </div>

              <div class="form-row row mt-2">
                <div class="col-xl-4">
                  <%= form.label :facility_office_pnone, "Medical Staff Office Phone:" %>
                  <%= form.text_field :facility_office_pnone, class: 'form-control border border-dark', placeholder: 'Type here...' %>
                </div>
                <div class="col-xl-4">
                  <%= form.label :facility_office_fax, "Medical Staff Office Fax:" %>
                  <%= form.text_field :facility_office_fax, class: 'form-control border border-dark', placeholder: 'Type here...' %>
                </div>
                <div class="col-xl-4">
                  <%= form.label :facility_office_email, "Medical Staff Office Email Address:" %>
                  <%= form.text_field :facility_office_email, class: 'form-control border border-dark', placeholder: 'Type here...' %>
                </div>
              </div>
          </div>

          <div class="form-row row mt-2">
            <div class="col-xl-4">
              <%= form.label :appointment_date, "Appointment Date:" %>
              <%= form.date_field :appointment_date, class: 'form-control border border-dark', placeholder: 'Type here...' %>
            </div>
            <div class="col-xl-4">
              <%= form.label :department, "Department:" %>
              <%= form.text_field :department, class: 'form-control border border-dark', placeholder: 'Type here...' %>
            </div>
            <div class="col-xl-4">
              <%= form.label :section_name, "Section Name:" %>
              <%= form.text_field :section_name, class: 'form-control border border-dark', placeholder: 'Type here...' %>
            </div>
          </div>

          <div class="form-row row mt-2">
            <div class="col-xl-4">
              <%= form.label :facility_chair, "Department Chair:" %>
              <%= form.text_field :facility_chair, class: 'form-control border border-dark', placeholder: 'Type here...' %>
            </div>
            <div class="col-xl-4">
              <%= form.label :facility_chair_title, "Department Chair Title:" %>
              <%= form.text_field :facility_chair_title, class: 'form-control border border-dark', placeholder: 'Type here...' %>
            </div>
            <div class="col-xl-4">
              <%= form.label :status, "Status:" %>
              <%= form.text_field :status, class: 'form-control border border-dark', placeholder: 'Type here...' %>
            </div>
          </div>

          <div class="col-xl-4">
            <%= form.label :expiration_date, "Expiration Date:" %>
            <%= form.date_field :expiration_date, class: 'form-control border border-dark', placeholder: 'Type here...' %>
          </div>

          <div class="form-row row mt-3">
            <div class="col-xl-6">
              <div class="d-flex align-items-center gap-3">
                <%= form.label :is_current, "Current" %>
                <div class="form-check">
                  <%= form.radio_button :is_current, true, class: "form-check-input border border-dark", id: "current-yes" %>
                  <%= form.label :is_current, "Yes", class: "form-check-label", for: "current-yes" %>
                </div>
                <div class="form-check">
                  <%= form.radio_button :is_current, false, class: "form-check-input border border-dark", id: "current-no", checked: true %>
                  <%= form.label :is_current, "No", class: "form-check-label", for: "current-no" %>
                </div>
              </div>
            </div>

            <div class="col-xl-6">
              <div class="d-flex align-items-center gap-3">
                <%= form.label :is_primary_admitting_facility, "Is this your primary admitting facility?" %>
                <div class="form-check">
                  <%= form.radio_button :is_primary_admitting_facility, true, class: "form-check-input border border-dark", id: "primary-admitting-yes" %>
                  <%= form.label :is_primary_admitting_facility, "Yes", class: "form-check-label", for: "primary-admitting-yes" %>
                </div>
                <div class="form-check">
                  <%= form.radio_button :is_primary_admitting_facility, false, class: "form-check-input border border-dark", id: "primary-admitting-no", checked: true %>
                  <%= form.label :is_primary_admitting_facility, "No", class: "form-check-label", for: "primary-admitting-no" %>
                </div>
              </div>
            </div>
          </div>

          <div class="form-row row mt-2">
            <div class="col-xl-6">
              <div class="d-flex align-items-center gap-3">
                <%= form.label :is_admit_patients_facility, "If No, do you admit patients to this facility?" %>
                <div class="form-check">
                  <%= form.radio_button :is_admit_patients_facility, true, class: "form-check-input border border-dark", id: "admit-patient-yes" %>
                  <%= form.label :is_admit_patients_facility, "Yes", class: "form-check-label", for: "admit-patient-yes" %>
                </div>
                <div class="form-check">
                  <%= form.radio_button :is_admit_patients_facility, false, class: "form-check-input border border-dark", id: "admit-patient-no", checked: true %>
                  <%= form.label :is_admit_patients_facility, "No", class: "form-check-label", for: "admit-patient-no" %>
                </div>
              </div>
            </div>

            <div class="col-xl-6">
              <div class="d-flex align-items-center gap-3">
                <%= form.label :is_restriction_of_privileges, "Any past or present restriction of privileges at this
                      facility?" %>
                <div class="form-check">
                  <%= form.radio_button :is_restriction_of_privileges, true, class: "form-check-input border border-dark", id: "restriction-yes" %>
                  <%= form.label :is_restriction_of_privileges, "Yes", class: "form-check-label", for: "restriction-yes" %>
                </div>
                <div class="form-check">
                  <%= form.radio_button :is_restriction_of_privileges, false, class: "form-check-input border border-dark", id: "restriction-no", checked: true %>
                  <%= form.label :is_restriction_of_privileges, "No", class: "form-check-label", for: "restriction-no" %>
                </div>
              </div>
            </div>
          </div>

          <div class="form-row row mt-3 mb-3">
            <div class="col-xl-4">
              <%= form.label :faciltiy_percentage, "If Yes, please indicate percentage of admissions:" %>
              <span class="fac-percent input-holder">
                <%= form.text_field :faciltiy_percentage, class: 'form-control border border-dark', max:"100", accuracy:"2", min:"0", id:"inputRRPDiscount", style:"text-align:left;" %>
                <!-- <input type="number" name="fac-percent" max="100" accuracy="2" min="0" id="inputRRPDiscount" style="text-align:left;"> -->
              </span>
            </div>
          </div>

          <div class="form-row row mt-2">
            <div class="col-xl-5">
              <%= form.check_box :is_hospital_based_practitioner, class: "form-check-input-license border border-dark" %>
              <%= form.label :is_hospital_based_practitioner, "I am a hospital-based practitioner and do not admit patients", class: "form-check-label" %>
            </div>
          </div>

          <div class="form-row row mt-2">
            <div class="col-xl-4">
              <%= form.check_box :is_admitting_arrangements, class: "form-check-input-license border border-dark" %>
              <%= form.label :is_admitting_arrangements, "My admitting arrangements are as follows:", class: "form-check-label" %>
            </div>
          </div>

          <div class="form-row row mt-2">
            <div class="col-xl-4">
              <%= form.check_box :is_following_physician, class: "form-check-input-license border border-dark" %>
              <%= form.label :is_following_physician, "The following physician(s) admit on my behalf:", class: "form-check-label" %>
            </div>
          </div>


          <div class="form-row row mt-3">
            <div class="form-row row mt-3">
              <div class="col-xl-6">
                <div class="d-flex align-items-center gap-3">
                  <%= form.label :show_on_tickler, "Show on tickler?" %>
                  <div class="form-check">
                    <%= form.radio_button :show_on_tickler, true, class: "form-check-input border border-dark", id: "show-on-tickler-yes" %>
                    <%= form.label :show_on_tickler, "Yes", class: "form-check-label", for: "show-on-tickler-yes" %>
                  </div>
                  <div class="form-check">
                    <%= form.radio_button :show_on_tickler, false, class: "form-check-input border border-dark", id: "show-on-tickler-no", checked: true %>
                    <%= form.label :show_on_tickler, "No", class: "form-check-label", for: "show-on-tickler-no" %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="form-row row mt-2">
            <div class="col-xl-25">
              <%= form.label :comments, "Please List any comments:" %>
              <%= form.text_area :comments, placeholder:"Type here...", class:"form-control border border-dark" %>
            </div>
          </div>

          <div class="form-row mt-1 d-flex justify-content-end">
            <%= form.submit class: "btn btn-facility-save btn-primary mt-3" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
	
	// JavaScript to handle modal
	document.getElementById("openModal").onclick = function () {
    document.getElementById("myModal").style.display = "block";
  };

  // Close the modal function (used in onclick)
  function closeModal() {
    document.getElementById("myModal").style.display = "none";
  }

  // Close if user clicks outside the modal content
  window.onclick = function (event) {
    const modal = document.getElementById("myModal");
    if (event.target == modal) {
      modal.style.display = "none";
    }
  };
	
	document.addEventListener("DOMContentLoaded", function () {
    // --- Load Countries ---
    fetch("/multi_select_data/countries")
      .then(response => response.json())
      .then(data => {
        const select = document.getElementById("country-select");
        data.result.forEach(country => {
          const option = document.createElement("option");
          option.value = country.value;
          option.textContent = country.label;
          select.appendChild(option);
        });
      })
      .catch(error => {
        console.error("Error loading countries:", error);
      });

    // --- Load States ---
    fetch("/multi_select_data/states")
      .then(response => response.json())
      .then(data => {
        const select = document.getElementById("state-select");
        data.result.forEach(state => {
          const option = document.createElement("option");
          option.value = state.value;
          option.textContent = state.label;
          select.appendChild(option);
        });
      })
      .catch(error => {
        console.error("Error loading states:", error);
      });

    // --- Auto-fill for City and Carrier ---
    const cityInput = document.getElementById('input-city');
    const carrierInput = document.getElementById('input-carrier');
    const autoCity = document.getElementById('auto-city');
    const autoCarrierName = document.getElementById('auto-carrier-name');

    if (cityInput && autoCity) {
      cityInput.addEventListener('input', () => {
        autoCity.value = cityInput.value;
      });
    }

    if (carrierInput && autoCarrierName) {
      carrierInput.addEventListener('input', () => {
        autoCarrierName.value = carrierInput.value;
      });
    }

    // --- Country select to County input ---
    const countrySelect = document.getElementById('country-select');
    if (countrySelect) {
      countrySelect.addEventListener('change', function () {
        const selectedCountry = this.value;
        const countyInput = document.getElementById('county-input');
        if (countyInput) {
          countyInput.value = selectedCountry;
        }
      });
    }

    // --- State select to Lower state ---
		const stateSelect = document.getElementById('state-select');
			if (stateSelect) {
				stateSelect.addEventListener('change', function () {
					const selectedOption = stateSelect.options[stateSelect.selectedIndex];
					const fullLabel = selectedOption.textContent; // e.g., "Colorado - CO"
					const stateName = fullLabel.split(' - ')[0];  // Only "Colorado"

					const lowerStateSelect = document.getElementById('lower-state-select');
					if (lowerStateSelect) {
						lowerStateSelect.innerHTML = '';

						const option = document.createElement('option');
						option.value = stateName;
						option.text = stateName;
						option.selected = true;

						lowerStateSelect.appendChild(option);
					}
				});
			}

		// --- Modal Close Button ---
		const closeBtn = document.getElementById("modal-close-btn");

			if (closeBtn) {
				closeBtn.addEventListener("click", function () {
					// Get values from modal
					const carrierName = document.getElementById("auto-carrier-name")?.value;
					const country = document.getElementById("country-select")?.value;
					const state = document.getElementById("lower-state-select")?.value;
					const city = document.getElementById("auto-city")?.value;

					// Get outside form elements
					const mainCarrier = document.getElementById("main-carrier-name");
					const mainCountry = document.getElementById("practice_info_country_country_name");
					const mainState = document.getElementById("practice_info_state");
					const mainCity = document.getElementById("practice_info_city");

					// Set values to outside form
					if (mainCarrier && carrierName) mainCarrier.value = carrierName;
					if (mainCountry && country) mainCountry.value = country;
					if (mainState && state) mainState.value = state;
					if (mainCity && city) mainCity.value = city;

					// Hide modal
					const modal = document.getElementById("myModal");
					if (modal) {
						modal.style.display = "none";
					}
				});
			}
  });
</script>
<style>
  #myModal {
      font-family: Arial, sans-serif;
      padding: 20px;
      background-color: white;
      position: fixed;
      top: 10%;
      left: 50%;
      transform: translateX(-50%);
      z-index: 1000;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
      width: 80%;
      max-width: 800px;
      display: none; /* initially hidden */
    }

    #myModal select,
    #myModal input[type="text"],
    #myModal input[type="email"] {
      width: 300px;
      padding: 5px;
      margin-bottom: 10px;
    }

    #myModal .form-section {
      border: 1px solid #ccc;
      padding: 15px;
      margin-top: 20px;
    }

    #myModal .form-section-header {
      background-color: #2c5aa0;
      color: #fff;
      padding: 8px;
      font-weight: bold;
    }

    #myModal .form-group {
      margin-bottom: 8px;
    }

    #myModal label {
      display: inline-block;
      width: 180px;
    }

    #myModal .form-actions {
      margin-top: 20px;
    }

    #myModal button {
      padding: 6px 16px;
      margin-right: 10px;
    }

    #myModal .search-group input[type="text"] {
      width: 180px;
    }
    #myModal .close-btn {
      position: absolute;
      top: 10px;
      right: 15px;
      font-size: 24px;
      font-weight: bold;
      color: #333;
      cursor: pointer;
    }

    #myModal .form-actions {
      margin-top: 20px;
      text-align: right;
    }

    #myModal .form-actions button {
      padding: 8px 16px;
      background-color: #2c5aa0;
      color: white;
      border: none;
      border-radius: 4px;
      margin-left: 10px;
      cursor: pointer;
      margin-bottom: 61px;
    }

    #myModal .form-actions button:hover {
      background-color: #20457e;
    }
    #myModal .search-group input[type="text"] {
        width: 300px;
    }
</style>
