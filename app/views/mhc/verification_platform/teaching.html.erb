<% applicability = section_applicability(@provider_personal_information, "teaching") %>
<% teaching_not_applicable = section_not_applicable?(@provider_personal_information, "teaching") %>

<style>
  #teaching-section .page-applicable {
    <%= "display: none !important;" if teaching_not_applicable %>
  }

  #teaching-section .page-not-applicable {
    <%= "display: none !important;" unless teaching_not_applicable %>
  }
</style>
<div class="enc-content section-applicability-container"
     id="teaching-section"
     data-section-key="teaching">
        <div class="container">
    <%= render "top_nav_buttons"%>

            <div class="mt-4 d-flex align-items-end justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <h4 class="page-heading">Teaching Appointments</h4>
                    <%= render "section_applicability", section_key: "teaching" %>
                </div>
                <a href="<%= mhc_verification_platform_index_path(page_tab: 'add_new_teaching')%>" class="btn btn-primary py-1">
                    <i class='bx bx-plus'></i>
                    Add New Teaching Appointment
                </a>
            </div>
            <div class="mt-2 page-applicable">
                <span class="page-note">
                    <i class='bx bx-error-circle font-red'></i> <span>Please list all teaching appointments, past and
                        present, in chronological order. Required fields are marked with the symbol “<span
                            class="font-red">*</span>”.</span>
                </span>
                <span class="page-note">
                    <i class='bx bx-error-circle font-red'></i> <span>Please check the Not Applicable box if you are not
                        currently and have never been affiliated with a facility.</span>
                </span>
            </div>
            <table class="table table-bordered practice-table mt-3 page-applicable ">
                <thead>
                    <tr>
                        <th class="text-white" scope="col">Institution</th>
                        <th class="text-white">Specialty</th>
                        <th class="text-white">Appointment From</th>
                        <th class="text-white">Appointment To</th>
                        <th class="text-white">Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><a href="<%= mhc_verification_platform_path(page_tab: 'teaching_record')%>">Lorem</a></td>
                        <td>Lorem ipsum</td>
                        <td>11/11/2011</td>
                        <td>0</td>
                        <td>No Material</td>
                    </tr>

                </tbody>
            </table>
            <%= render "section_applicability_explanation",
           section_key: "teaching" %>
        </div>
    </div>