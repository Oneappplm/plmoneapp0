<div class="enc-content">
  <div class="container">
    <%= render "top_nav_buttons"%>
    <div class="cont">
      <div class="mt-4 d-flex align-items-end justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
          <h4 class="page-heading">Standard Disclosures</h4>
          <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" id="disclosure-switch">
            <label class="form-check-label" for="education-switch">Not Applicable</label>
          </div>
          <%# <a class="btn btn-primary py-1 page-applicable" href="" id="EditDisclosure">
          Edit
          </a> %>
        </div>
      </div>
      <div class="mt-2 page-applicable">
        <span class="page-note">
        <i class='bx bx-error-circle font-red'></i> <span>Please answer each of the following questions.
        You must provide an explanation for each "Yes" answer to questions 1-26.</span>
        </span>
      </div>
      <div class="page-applicable">
        <div class="right-pane">
          <div class="d-flex align-items-center justify-content-between">
            <h6 class="offset-md-5">Message Board</h6>
            <button class="btn btn-primary py-1" data-bs-toggle="modal" data-bs-target="#addCommentModal">
            Add Comment
            </button>
          </div>
          <div class="form-row mt-2">
            <span class="btn span-pane bg-alt-grey  py-1" data-bs-toggle="modal" data-bs-target="#deleteCommentModal">
            Subject: Incomplete Record
            </span>
          </div>
        </div>
        <!-- <div class="col-xl-12">
          <div class="card p-2">
              <div class="input-group d-flex align-items-center justify-content-between gap-2">
                  <label class="offset-md-5">Message Board</label>
                  <button class="btn btn-primary py-1 rounded" data-bs-toggle="modal"
                      data-bs-target="#addCommentModal">
                      Add Comment
                  </button>
              </div>
              <div class="form-row mt-2 mb-lg-5">
                  <span class="btn span-pane" data-bs-toggle="modal" data-bs-target="#deleteCommentModal">
                      Subject: Incomplete Record
                  </span>
              </div>
          </div>
          </div> -->
      </div>
      <%= form_with model: @provider_attest,
              url: mhc_provider_disclosures_path(id: @provider_personal_information.id),
              method: :post,
              local: true,
              id: "disclosure-form-1" do |f| %>

        <% counter = 0 %>

        <% QUESTIONS_DISCLOSURE.each do |heading, questions| %>
          <div class="form-row row mt-4 page-applicable">
            <div class="col-xl-12">
              <div class="card p-3">
                <h6 class="fw-bold mb-4"><%= heading %></h6>

                <% questions.each do |q| %>
                  <% counter += 1 %>
                  <% disclosure = @provider_attest.provider_disclosures
                                      .find { |d| d.disclosure_question_disclosure_summary == q } ||
                                  @provider_attest.provider_disclosures.build(
                                    disclosure_question_disclosure_summary: q
                                  ) %>

                  <%= f.fields_for :provider_disclosures, disclosure do |d| %>
                    <%= d.hidden_field :disclosure_question_disclosure_summary %>

                    <div class="row mb-3 disclosure-item">
                      <div class="col-md-2">
                        <%= d.select :disclosure_answer_flag,
                              [["-- Select --", ""], ["Yes", true], ["No", false]],
                              {},
                              {
                                id:    "disclosure-select-#{counter}",
                                class: "form-select disclosure-select",
                                data:  { target: "#explain#{counter}" }
                              } %>
                      </div>

                      <div class="col-md-10">
                        <label>
                          <span class="text-danger">*</span>
                          <%= "#{counter}. #{q}" %>
                        </label>
                        <%= d.text_area :disclosure_explanation,
                              id:    "explain#{counter}",
                              class: "form-control mt-2 #{'d-none' unless d.object.disclosure_answer_flag}",
                              rows: 3,
                              placeholder: "Please explain..." %>
                      </div>
                    </div>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>

        <div class="form-row mt-4 d-flex justify-content-end page-applicable">
          <%= f.submit "Save", class: "btn btn-primary py-1" %>
        </div>
      <% end %>

      <form action="" class="page-applicable">
        <div class="form-row">
          <label for="">If Yes, please explain:</label>
          <textarea name="" id="" cols="30" rows="5" class="form-control" required></textarea>
        </div>
      </form>
      <form action="" class="page-not-applicable">
        <div class="form-row mt-4">
          <label for="">Please explain:<span class="font-red">*</span></label>
          <textarea name="" id="" cols="30" rows="5" class="form-control" required></textarea>
        </div>
        <div class="form-row mt-2 d-flex justify-content-end">
          <button type="submit" class="btn btn-primary py-1">
          Save
          </button>
        </div>
      </form>
    </div>
    <!-- Add Comment Modal -->
    <div class="modal fade" id="addCommentModal" tabindex="-1" aria-labelledby="exampleModalLabel"
      aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-body">
            <div class="content">
              <div class="modal-title">
                <h6 class="offset-md-5">Add Comment</h6>
                <button class="btn btn-cancel" data-bs-dismiss="modal">Cancel</button>
              </div>
              <form action="">
                <div class="form-row mt-3">
                  <label for="">Subject:</label>
                  <input type="text" class="form-control">
                </div>
                <div class="form-row">
                  <label for="">Message:</label>
                  <textarea name="" id="" cols="30" rows="5" class="form-control"></textarea>
                </div>
              </form>
              <div class="form-row mt-3 d-flex justify-content-center">
                <button class="btn btn-primary py-1">Post Comment</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Delete Comment Modal -->
    <div class="modal fade" id="deleteCommentModal" tabindex="-1" aria-labelledby="exampleModalLabel"
      aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-body">
            <div class="content">
              <div class="modal-title">
                <h6 class="offset-md-5">Comment</h6>
                <button class="btn btn-cancel" data-bs-dismiss="modal">Cancel</button>
              </div>
              <form action="">
                <div class="form-row mt-3">
                  <label for="">Subject:</label>
                  <input type="text" class="form-control">
                </div>
                <div class="form-row">
                  <label for="">Message:</label>
                  <textarea name="" id="" cols="30" rows="5" class="form-control"></textarea>
                </div>
              </form>
              <div class="form-row mt-3 d-flex justify-content-center">
                <button class="btn btn-danger">Delete Comment</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.disclosure-select').forEach(select => {
      select.addEventListener('change', e => {
        const id    = select.id;     // e.g. "disclosure-select-3"
        const value = select.value;  // "true" | "false" | ""
        console.log(`Changed: ${id} => ${value}`);

        const target = document.querySelector(select.dataset.target);
        if (!target) return;

        if (value === 'true') {
          target.classList.remove('d-none');
        } else {
          target.classList.add('d-none');
          target.value = '';
        }
      });
    });
  });


</script>
