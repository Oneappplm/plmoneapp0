<div class="enc-content">
  <div class="container">
    <%= render "top_nav_buttons"%>
     
    <div class="add-license-content mt-4">
      <div class="row">
        <div class="col-xl-6 d-flex align-items-center">
            <div class="d-flex align-items-center gap-3">
                <a href="<%= mhc_verification_platform_path(page_tab: 'facilities')%>" class="link-back">
                    <i class='bx bx-left-arrow-alt'></i>
                </a>
                <h4 class="page-heading">Add New Facility</h4>
            </div>
        </div>
        <%= form_with model: [:mhc, @facility] do |form| %>
          <%= form.hidden_field :caqh_provider_attest_id %>
          <%= form.hidden_field :provider_attest_id, value: params[:id]  %>
          <div class="col-xl-12 right-pane mt-3">
            <div class="d-flex align-items-center gap-10">
              <span class="page-note">
                <i class='bx bx-error-circle font-blue'></i> <span>To search for a Facility name, please click the Search button..</span>
              </span>
            </div>

              <div class="form-row row mt-2">
                <div class="col-xl-5">
                  <%= form.label :facility_name, "Facility Name:" %>
                  <%= form.text_field :facility_name, class: 'form-control border border-dark', placeholder: 'Type here...' , id: "facility_facility_name"%>
                </div>
                <%# <div class="col-xl-1"> %>
                  <%# <div class="d-flex align-items-center gap-10"> %>
                      <%# <button class="btn-search_add_facility" type="submit">
                          Search
                      </button> %>
                      <%# <button type="button" class="btn btn-primary" id="openModal">Search</button>
                  </div>
                </div> %>
                <div class="col-xl-1 d-flex align-items-center">
                  <button type="button" class="btn btn-primary px-4 py-2 mt-3" id="openModal" style="border-radius: 8px; font-weight: bold;">
                    Search
                  </button>
                </div>

                <!-- Search modal popup start here -->
                  <div id="myModal" class="modal">
                    <div class="modal-content">
                      <p>
                        To search for an existing Facility, please select the Country, State or Province, City and Facility Name from the drop down lists. If your Facility is not on the list, click the New button. Complete the requested address information of the department or office that may verify your affiliation/privileges status.. Click the Save button. Click the Close button to populate the record with the new address information.
                      </p>

                      <div class="search-group">
                        <!-- Country -->
                        <div class="form-group">
                          <label>By Country:</label>
                          <%= form.select :country,
                            options_for_select(ISO3166::Country.all.map { |c| [c.translations['en'] || c.name, c.alpha2] }, form.object.country),
                            { include_blank: "Select Country" },
                            class: "form-control", id: "modal-country" %>
                        </div>

                        <!-- State -->
                        <div class="form-group">
                          <%= form.label :state, "By State/Province:" %>
                          <%= form.select :state,
                                          [],
                                          { include_blank: "Select State" },
                                          class: "form-control",
                                          id: "state-select" %>
                        </div>

                        <!-- City -->
                        <div class="form-group">
                          <label for="modal-city-select">By City:</label>
                          <%= form.select :city,
                                          options_for_select(
                                            ProviderPersonalInformationFacility.where(form_type: 'popup')
                                                                              .distinct
                                                                              .pluck(:city)
                                                                              .compact
                                                                              .sort,
                                            form.object.city
                                          ),
                                          { include_blank: "Select City" },
                                          class: "form-control",
                                          id: "modal-city-select" %>
                        </div>

                        <!-- Facility -->
                        <div class="form-group">
                          <label>By Facility:</label>
                          <input type="text" id="facility-search-input" class="form-control mb-2" placeholder="Type to search Facility...">

                          <%= form.select :facility_name,
                            options_for_select(
                              ProviderPersonalInformationFacility.where(form_type: 'popup').map { |fc|
                                [
                                  fc.facility_name,
                                  fc.facility_name,
                                  {
                                    "data-city": fc.city,
                                    "data-address": fc.address,
                                    "data-additional-address": fc.addition_address,
                                    "data-county": fc.county,
                                    "data-state": fc.state,
                                    "data-zip": fc.zip_code,
                                    "data-phone": fc.facility_office_pnone,
                                    "data-fax": fc.facility_office_fax,
                                    "data-email": fc.facility_office_email,
                                    "data-country": fc.country || ""
                                  }
                                ]
                              },
                              form.object.facility_name
                            ),
                            { include_blank: "Select Facility" },
                            class: "form-control", id: "modal-facility-select" %>
                          <button type="button" class="btn btn-primary mt-2" id="facility-search-btn">Search</button>
                        </div>
                      </div>

                      <!-- Facility Information -->
                      <div class="form-section">
                        <div class="form-section-header"> Facility Information -Address of Department/Office Verifying Affiliation/Privileges.</div>

                        <div class="form-group">
                          <label>Facility Name:</label>
                          <%= form.text_field :facility_name, class: "form-control", id: "modal-facility-name" %>
                        </div>
                        <div class="form-group">
                          <label>Address:</label>
                          <%= form.text_field :address, class: "form-control", id: "modal-address" %>
                        </div>
                        <div class="form-group">
                          <label>Additional Address:</label>
                          <%= form.text_field :addition_address, class: "form-control", id: "modal-additional-address" %>
                        </div>
                        <div class="form-group">
                          <label>City:</label>
                          <%= form.text_field :city, class: "form-control", id: "modal-city" %>
                        </div>
                        <div class="form-group">
                          <label>County:</label>
                          <%= form.text_field :county, class: "form-control", id: "modal-county" %>
                        </div>
                        <div class="form-group">
                          <label>State:</label>
                          <%= form.text_field :state, class: "form-control", id: "modal-state" %>
                        </div>
                        <div class="form-group">
                          <label>Postal Code:</label>
                          <%= form.text_field :zip_code, class: "form-control", id: "modal-zip" %>
                        </div>
                        <div class="form-group">
                          <label>Country:</label>
                          <%= form.text_field :country, class: "form-control", id: "modal-country-name" %>
                        </div>
                        <div class="form-group">
                          <label>Phone:</label>
                          <%= form.text_field :facility_office_pnone, class: "form-control", id: "modal-phone" %>
                        </div>
                        <div class="form-group">
                          <label>Fax:</label>
                          <%= form.text_field :facility_office_fax, class: "form-control", id: "modal-fax" %>
                        </div>
                        <div class="form-group">
                          <label>Email:</label>
                          <%= form.text_field :facility_office_email, class: "form-control", id: "modal-email" %>
                        </div>
                      </div>

                      <div class="form-actions mt-3 d-flex justify-content-center gap-3">
                        <button type="button" class="btn btn-success" id="new-btn">New</button>
                        <%= form.submit 'Save', class: 'btn btn-success', name: 'commit', value: 'Save', id: 'popup-save-btn', style: 'display:none;' %>
                        <button type="button" class="btn btn-secondary" id="modal-close-btn">Close</button>
                      </div>
                    </div>
                  </div>
                <!-- Search modal popup end here -->
              </div>

              <div class="col-xl-6">
                <%= form.label :contact, "Contact:" %>
                <%= form.select :contact, options_for_select(["Fax", "Email", "Letter"]), { prompt: "Select option" }, class: "form-select" %>
              </div>

              <div class="form-row row mt-2">
                <div class="col-xl-6">
                  <%= form.label :address, "Address:" %>
                  <%= form.text_field :address, class: 'form-control border border-dark', placeholder: 'Type here...', id: "facility_address" %>
                </div>
                <div class="col-xl-6">
                  <%= form.label :addition_address, "Additional Address:" %>
                  <%= form.text_field :addition_address, class: 'form-control border border-dark', placeholder: 'Type here...', id: "facility_addition_address" %>
                </div>
              </div>

              <div class="form-row row mt-2">
                <div class="col-xl-6">
                  <%= form.label :city, "City:" %>
                  <%= form.text_field :city, class: 'form-control border border-dark', placeholder: 'Type here...', id: "facility_city"  %>
                </div>
                <div class="col-xl-6">
                  <%= form.label :county, "County:" %>
                  <%= form.text_field :county, class: 'form-control border border-dark', placeholder: 'Type here...' , id: "facility_county"%>
                </div>
              </div>

              <div class="form-row row mt-2">
                <div class="col-xl-4">
                  <%= form.label :state, "State/Province:" %>
                  <%= form.text_field :state, class: 'form-control border border-dark', placeholder: 'Type here...' , id: "facility_state"%>
                </div>
                <div class="col-xl-4">
                  <%= form.label :zip_code, "Zip/Postal Code:" %>
                  <%= form.text_field :zip_code, class: 'form-control border border-dark', placeholder: 'Type here...', id: "facility_zip_code"  %>
                </div>
                <div class="col-xl-4">
                  <%= form.label :country, "Country:" %>
                  <%= form.text_field :country, class: 'form-control border border-dark', placeholder: 'Type here...' , id: "facility_country" %>
                </div>
              </div>

              <div class="form-row row mt-2">
                <div class="col-xl-4">
                  <%= form.label :facility_office_pnone, "Medical Staff Office Phone:" %>
                  <%= form.text_field :facility_office_pnone, class: 'form-control border border-dark', placeholder: 'Type here...', id: "facility_facility_office_pnone" %>
                </div>
                <div class="col-xl-4">
                  <%= form.label :facility_office_fax, "Medical Staff Office Fax:" %>
                  <%= form.text_field :facility_office_fax, class: 'form-control border border-dark', placeholder: 'Type here...' , id: "facility_facility_office_fax" %>
                </div>
                <div class="col-xl-4">
                  <%= form.label :facility_office_email, "Medical Staff Office Email Address:" %>
                  <%= form.text_field :facility_office_email, class: 'form-control border border-dark', placeholder: 'Type here...', id: "facility_facility_office_email" %>
                </div>
              </div>
          </div>

          <div class="form-row row mt-2">
            <div class="col-xl-4">
              <%= form.label :appointment_date, "Appointment Date:" %>
              <%= form.date_field :appointment_date, class: 'form-control border border-dark', placeholder: 'Type here...' %>
            </div>
            <div class="col-xl-4">
              <%= form.label :department, "Department:" %>
              <%= form.text_field :department, class: 'form-control border border-dark', placeholder: 'Type here...' %>
            </div>
            <div class="col-xl-4">
              <%= form.label :section_name, "Section Name:" %>
              <%= form.text_field :section_name, class: 'form-control border border-dark', placeholder: 'Type here...' %>
            </div>
          </div>

          <div class="form-row row mt-2">
            <div class="col-xl-4">
              <%= form.label :facility_chair, "Department Chair:" %>
              <%= form.text_field :facility_chair, class: 'form-control border border-dark', placeholder: 'Type here...' %>
            </div>
            <div class="col-xl-4">
              <%= form.label :facility_chair_title, "Department Chair Title:" %>
              <%= form.text_field :facility_chair_title, class: 'form-control border border-dark', placeholder: 'Type here...' %>
            </div>
            <div class="col-xl-4">
              <%= form.label :status, "Status:" %>
              <%= form.text_field :status, class: 'form-control border border-dark', placeholder: 'Type here...' %>
            </div>
          </div>

          <div class="col-xl-4">
            <%= form.label :expiration_date, "Expiration Date:" %>
            <%= form.date_field :expiration_date, class: 'form-control border border-dark', placeholder: 'Type here...' %>
          </div>

          <div class="form-row row mt-3">
            <div class="col-xl-6">
              <div class="d-flex align-items-center gap-3">
                <%= form.label :is_current, "Current" %>
                <div class="form-check">
                  <%= form.radio_button :is_current, true, class: "form-check-input border border-dark", id: "current-yes" %>
                  <%= form.label :is_current, "Yes", class: "form-check-label", for: "current-yes" %>
                </div>
                <div class="form-check">
                  <%= form.radio_button :is_current, false, class: "form-check-input border border-dark", id: "current-no", checked: true %>
                  <%= form.label :is_current, "No", class: "form-check-label", for: "current-no" %>
                </div>
              </div>
            </div>

            <div class="col-xl-6">
              <div class="d-flex align-items-center gap-3">
                <%= form.label :is_primary_admitting_facility, "Is this your primary admitting facility?" %>
                <div class="form-check">
                  <%= form.radio_button :is_primary_admitting_facility, true, class: "form-check-input border border-dark", id: "primary-admitting-yes" %>
                  <%= form.label :is_primary_admitting_facility, "Yes", class: "form-check-label", for: "primary-admitting-yes" %>
                </div>
                <div class="form-check">
                  <%= form.radio_button :is_primary_admitting_facility, false, class: "form-check-input border border-dark", id: "primary-admitting-no", checked: true %>
                  <%= form.label :is_primary_admitting_facility, "No", class: "form-check-label", for: "primary-admitting-no" %>
                </div>
              </div>
            </div>
          </div>

          <div class="form-row row mt-2">
            <div class="col-xl-6">
              <div class="d-flex align-items-center gap-3">
                <%= form.label :is_admit_patients_facility, "If No, do you admit patients to this facility?" %>
                <div class="form-check">
                  <%= form.radio_button :is_admit_patients_facility, true, class: "form-check-input border border-dark", id: "admit-patient-yes" %>
                  <%= form.label :is_admit_patients_facility, "Yes", class: "form-check-label", for: "admit-patient-yes" %>
                </div>
                <div class="form-check">
                  <%= form.radio_button :is_admit_patients_facility, false, class: "form-check-input border border-dark", id: "admit-patient-no", checked: true %>
                  <%= form.label :is_admit_patients_facility, "No", class: "form-check-label", for: "admit-patient-no" %>
                </div>
              </div>
            </div>

            <div class="col-xl-6">
              <div class="d-flex align-items-center gap-3">
                <%= form.label :is_restriction_of_privileges, "Any past or present restriction of privileges at this
                      facility?" %>
                <div class="form-check">
                  <%= form.radio_button :is_restriction_of_privileges, true, class: "form-check-input border border-dark", id: "restriction-yes" %>
                  <%= form.label :is_restriction_of_privileges, "Yes", class: "form-check-label", for: "restriction-yes" %>
                </div>
                <div class="form-check">
                  <%= form.radio_button :is_restriction_of_privileges, false, class: "form-check-input border border-dark", id: "restriction-no", checked: true %>
                  <%= form.label :is_restriction_of_privileges, "No", class: "form-check-label", for: "restriction-no" %>
                </div>
              </div>
            </div>
          </div>

          <div class="form-row row mt-3 mb-3">
            <div class="col-xl-4">
              <%= form.label :faciltiy_percentage, "If Yes, please indicate percentage of admissions:" %>
              <span class="fac-percent input-holder">
                <%= form.text_field :faciltiy_percentage, class: 'form-control border border-dark', max:"100", accuracy:"2", min:"0", id:"inputRRPDiscount", style:"text-align:left;" %>
                <!-- <input type="number" name="fac-percent" max="100" accuracy="2" min="0" id="inputRRPDiscount" style="text-align:left;"> -->
              </span>
            </div>
          </div>

          <div class="form-row row mt-2">
            <div class="col-xl-5">
              <%= form.check_box :is_hospital_based_practitioner, class: "form-check-input-license border border-dark" %>
              <%= form.label :is_hospital_based_practitioner, "I am a hospital-based practitioner and do not admit patients", class: "form-check-label" %>
            </div>
          </div>

          <div class="form-row row mt-2">
            <div class="col-xl-4">
              <%= form.check_box :is_admitting_arrangements, class: "form-check-input-license border border-dark" %>
              <%= form.label :is_admitting_arrangements, "My admitting arrangements are as follows:", class: "form-check-label" %>
            </div>
          </div>

          <div class="form-row row mt-2">
            <div class="col-xl-4">
              <%= form.check_box :is_following_physician, class: "form-check-input-license border border-dark" %>
              <%= form.label :is_following_physician, "The following physician(s) admit on my behalf:", class: "form-check-label" %>
            </div>
          </div>


          <div class="form-row row mt-3">
            <div class="form-row row mt-3">
              <div class="col-xl-6">
                <div class="d-flex align-items-center gap-3">
                  <%= form.label :show_on_tickler, "Show on tickler?" %>
                  <div class="form-check">
                    <%= form.radio_button :show_on_tickler, true, class: "form-check-input border border-dark", id: "show-on-tickler-yes" %>
                    <%= form.label :show_on_tickler, "Yes", class: "form-check-label", for: "show-on-tickler-yes" %>
                  </div>
                  <div class="form-check">
                    <%= form.radio_button :show_on_tickler, false, class: "form-check-input border border-dark", id: "show-on-tickler-no", checked: true %>
                    <%= form.label :show_on_tickler, "No", class: "form-check-label", for: "show-on-tickler-no" %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="form-row row mt-2">
            <div class="col-xl-25">
              <%= form.label :comments, "Please List any comments:" %>
              <%= form.text_area :comments, placeholder:"Type here...", class:"form-control border border-dark" %>
            </div>
          </div>

          <div class="form-row mt-1 d-flex justify-content-end">
            <%= form.submit 'Save', class: 'btn btn-primary', name: 'commit', value: 'Create', id: 'main-save-btn' %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    // -------------------- Modal Open/Close --------------------
    const modal = document.getElementById("myModal");
    const openBtn = document.getElementById("openModal");
    const closeBtn = document.getElementById("modal-close-btn");
    const newBtn = document.getElementById("new-btn");
    const saveBtn = document.getElementById("popup-save-btn");

    openBtn?.addEventListener("click", () => modal.style.display = "block");
    window.onclick = (e) => { if (e.target === modal) modal.style.display = "none"; };

    // -------------------- Facility Search + Filter --------------------
    const searchInput = document.getElementById("facility-search-input");
    const facilitySelect = document.getElementById("modal-facility-select");
    const searchBtn = document.getElementById("facility-search-btn");
    const citySelect = document.getElementById("modal-city-select");

    let allOptions = [];
    if (facilitySelect) {
      allOptions = Array.from(facilitySelect.options).map(opt => opt.cloneNode(true));
    }

    // -------------------- Keep Main Form and Modal in Sync --------------------
    const mainFacilityName = document.getElementById("facility_facility_name");
    const modalFacilityName = document.getElementById("modal-facility-name");

    // main → modal sync
    mainFacilityName?.addEventListener("input", function () {
      if (modalFacilityName) modalFacilityName.value = this.value;
    });

    // modal → main sync (already handled in fillMainFormFromModal, but extra live sync)
    modalFacilityName?.addEventListener("input", function () {
      if (mainFacilityName) mainFacilityName.value = this.value;
    });

    function filterOptions() {
      if (!facilitySelect) return;

      const selectedCity = (citySelect?.value || "").toLowerCase();
      const term = (searchInput?.value || "").toLowerCase();

      facilitySelect.innerHTML = "";

      let filtered = allOptions.filter(opt => {
        const facCity = (opt.getAttribute("data-city") || "").toLowerCase();
        const facName = opt.textContent.toLowerCase();
        return (!selectedCity || facCity === selectedCity) &&
              (!term || facName.includes(term));
      });

      if (filtered.length === 0) {
        let opt = document.createElement("option");
        opt.value = "";
        opt.text = "No matching facility found";
        facilitySelect.appendChild(opt);
      } else {
        filtered.forEach(opt => facilitySelect.appendChild(opt.cloneNode(true)));
      }

      facilitySelect.value = "";
    }

    searchBtn?.addEventListener("click", filterOptions);
    searchInput?.addEventListener("input", filterOptions);
    citySelect?.addEventListener("change", filterOptions);

    // -------------------- Autofill Modal Fields on Facility Change --------------------
    facilitySelect?.addEventListener("change", function () {
      const selected = this.options[this.selectedIndex];
      if (!selected) return;

      document.getElementById("modal-facility-name").value = selected.text;
      document.getElementById("modal-address").value = selected.dataset.address || "";
      document.getElementById("modal-additional-address").value = selected.dataset.additionalAddress || "";
      document.getElementById("modal-city").value = selected.dataset.city || "";
      document.getElementById("modal-county").value = selected.dataset.county || "";
      document.getElementById("modal-state").value = selected.dataset.state || "";
      document.getElementById("modal-zip").value = selected.dataset.zip || "";
      document.getElementById("modal-phone").value = selected.dataset.phone || "";
      document.getElementById("modal-fax").value = selected.dataset.fax || "";
      document.getElementById("modal-email").value = selected.dataset.email || "";
      document.getElementById("modal-country-name").value = selected.dataset.country || "";
    });

    // -------------------- Copy Modal → Main Form --------------------
    function fillMainFormFromModal() {
      const fieldMap = {
        "facility_address": "modal-address",
        "facility_addition_address": "modal-additional-address",
        "facility_city": "modal-city",
        "facility_county": "modal-county",
        "facility_state": "modal-state",
        "facility_zip_code": "modal-zip",
        "facility_country": "modal-country-name",
        "facility_facility_office_pnone": "modal-phone",
        "facility_facility_office_fax": "modal-fax",
        "facility_facility_office_email": "modal-email"
      };

      Object.keys(fieldMap).forEach(mainId => {
        const modalId = fieldMap[mainId];
        const mainEl = document.getElementById(mainId) || document.querySelector(`[name='facility[${mainId.replace("facility_","")}]']`);
        const modalEl = document.getElementById(modalId);
        if (mainEl && modalEl) mainEl.value = modalEl.value || "";
      });

      // facility_name explicitly
      const modalFacility = document.getElementById("modal-facility-name");
      const mainFacility = document.getElementById("facility_facility_name") || document.querySelector("[name='facility[facility_name]']");
      if (modalFacility && mainFacility) mainFacility.value = modalFacility.value || "";
    }

    closeBtn?.addEventListener("click", function () {
      fillMainFormFromModal();
      modal.style.display = "none";
    });
    newBtn?.addEventListener("click", () => saveBtn.style.display = "inline-block");
    saveBtn?.addEventListener("click", fillMainFormFromModal);

    // -------------------- Country → State Dropdown --------------------
    const countrySelect = document.getElementById("modal-country");
    const stateSelect = document.getElementById("state-select");

    countrySelect?.addEventListener("change", function () {
      const countryCode = this.value;
      stateSelect.innerHTML = '<option value="">Select State</option>';

      if (countryCode) {
        fetch(`/mhc/verification_platform/states?country=${countryCode}`)
          .then(res => res.json())
          .then(states => {
            states.forEach(st => {
              let opt = document.createElement("option");
              opt.value = st;
              opt.text = st;
              stateSelect.appendChild(opt);
            });
          });
      }
    });
  });
</script>
<style>
  #myModal {
      font-family: Arial, sans-serif;
      padding: 20px;
      background-color: white;
      position: fixed;
      top: 10%;
      left: 50%;
      transform: translateX(-50%);
      z-index: 1000;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
      width: 80%;
      max-width: 800px;
      display: none; /* initially hidden */
    }
    
    .btn-success {
        height: 45px;
    }

    #myModal select,
    #myModal input[type="text"],
    #myModal input[type="email"] {
      width: 300px;
      padding: 5px;
