<script>
	
	// JavaScript to handle modal
	document.getElementById("openModal").onclick = function () {
    document.getElementById("myModal").style.display = "block";
  };

  // Close the modal function (used in onclick)
  function closeModal() {
    document.getElementById("myModal").style.display = "none";
  }

  // Close if user clicks outside the modal content
  window.onclick = function (event) {
    const modal = document.getElementById("myModal");
    if (event.target == modal) {
      modal.style.display = "none";
    }
  };
	
	document.addEventListener("DOMContentLoaded", function () {
    // --- Load Countries ---
    fetch("/multi_select_data/countries")
      .then(response => response.json())
      .then(data => {
        const select = document.getElementById("country-select");
        data.result.forEach(country => {
          const option = document.createElement("option");
          option.value = country.value;
          option.textContent = country.label;
          select.appendChild(option);
        });
      })
      .catch(error => {
        console.error("Error loading countries:", error);
      });

    // --- Load States ---
    fetch("/multi_select_data/states")
      .then(response => response.json())
      .then(data => {
        const select = document.getElementById("state-select");
        data.result.forEach(state => {
          const option = document.createElement("option");
          option.value = state.value;
          option.textContent = state.label;
          select.appendChild(option);
        });
      })
      .catch(error => {
        console.error("Error loading states:", error);
      });

    // --- Auto-fill for City and Carrier ---
    const cityInput = document.getElementById('input-city');
    const carrierInput = document.getElementById('input-carrier');
    const autoCity = document.getElementById('auto-city');
    const autoCarrierName = document.getElementById('auto-carrier-name');

    if (cityInput && autoCity) {
      cityInput.addEventListener('input', () => {
        autoCity.value = cityInput.value;
      });
    }

    if (carrierInput && autoCarrierName) {
      carrierInput.addEventListener('input', () => {
        autoCarrierName.value = carrierInput.value;
      });
    }

    // --- Country select to County input ---
    const countrySelect = document.getElementById('country-select');
    if (countrySelect) {
      countrySelect.addEventListener('change', function () {
        const selectedCountry = this.value;
        const countyInput = document.getElementById('county-input');
        if (countyInput) {
          countyInput.value = selectedCountry;
        }
      });
    }

    // --- State select to Lower state ---
		const stateSelect = document.getElementById('state-select');
			if (stateSelect) {
				stateSelect.addEventListener('change', function () {
					const selectedOption = stateSelect.options[stateSelect.selectedIndex];
					const fullLabel = selectedOption.textContent; // e.g., "Colorado - CO"
					const stateName = fullLabel.split(' - ')[0];  // Only "Colorado"

					const lowerStateSelect = document.getElementById('lower-state-select');
					if (lowerStateSelect) {
						lowerStateSelect.innerHTML = '';

						const option = document.createElement('option');
						option.value = stateName;
						option.text = stateName;
						option.selected = true;

						lowerStateSelect.appendChild(option);
					}
				});
			}

		// --- Modal Close Button ---
		const closeBtn = document.getElementById("modal-close-btn");

			if (closeBtn) {
				closeBtn.addEventListener("click", function () {
					// Get values from modal
					const carrierName = document.getElementById("auto-carrier-name")?.value;
					const country = document.getElementById("country-select")?.value;
					const state = document.getElementById("lower-state-select")?.value;
					const city = document.getElementById("auto-city")?.value;

					// Get outside form elements
					const mainCarrier = document.getElementById("main-carrier-name");
					const mainCountry = document.getElementById("practice_info_country_country_name");
					const mainState = document.getElementById("practice_info_state");
					const mainCity = document.getElementById("practice_info_city");

					// Set values to outside form
					if (mainCarrier && carrierName) mainCarrier.value = carrierName;
					if (mainCountry && country) mainCountry.value = country;
					if (mainState && state) mainState.value = state;
					if (mainCity && city) mainCity.value = city;

					// Hide modal
					const modal = document.getElementById("myModal");
					if (modal) {
						modal.style.display = "none";
					}
				});
			}
  });
</script>
