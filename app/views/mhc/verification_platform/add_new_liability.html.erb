<div class="enc-content">
	<div class="container">
	   <%= render "top_nav_buttons"%>

		<div class="row mt-4">
			<div class="col-xl-6 d-flex align-items-center">
				<div class="d-flex align-items-center gap-3">
					<a href="<%= mhc_verification_platform_path(page_tab: 'liability')%>" class="link-back">
						<i class='bx bx-left-arrow-alt'></i>
					</a>
					<% if params[:page_action] == 'new' %>
						<h4 class="page-heading">Add New Liability</h4>
			    <% elsif params[:page_action] == 'edit'%>
			    	<h4 class="page-heading">Edit Liability</h4>
			    <% end %>  
				</div>
			</div>
		</div>
    <% if params[:page_action] == 'new' %>
      <% url = mhc_provider_insurance_coverages_path(id: @provider_insurance_coverage.id, page_tab: 'liability') %>
    <% elsif params[:page_action] == 'edit'%>
      <% url = mhc_provider_insurance_coverage_path(@provider_insurance_coverage.id) %>
    <% end %>  

		<%= form_with(model: @provider_insurance_coverage, url: url) do |f| %>
			
			<%= f.hidden_field :caqh_provider_attest_id %>
      <%= f.hidden_field :provider_attest_id %>
			
			<div class="form-row row mt-3">
				<div class="col-xl-4">
					<%= f.label :self_insured_flag, "Self Insured" %>
					<%= f.select :self_insured_flag, [["Yes", true], ["No", false]], { include_blank: "Select Option" }, class: "form-select form-select-lg" %>
				</div>
				<div class="col-xl-4">
					<%= f.label :insurance_coverage_type_insurance_coverage_type_description, "Type of Coverage" %>
					<%= f.select :insurance_coverage_type_insurance_coverage_type_description, [["Individual", "individual"], ["Shared", "shared"]], { include_blank: "Select Coverage Type" }, class: "form-select form-select-lg" %>
				</div>
				<div class="col-xl-4">
					<%= f.label :type_of_policy, "Type of Policy" %>
					<%= f.select :type_of_policy, [["Occurrence", "occurrence"], ["Claims Made", "claims made"]], { include_blank: "Select Policy Type" }, class: "form-select form-select-lg" %>
				</div>
			</div>

			<div class="page-applicable">
				<div class="card mt-3">
					<div class="form-row row p-2">
						<span class="page-note">
							<i class='bx bx-error-circle font-lightblue'></i> <span>To search for a School name,
								please
								click the search button.</span>
						</span>
						<div class="form-row row">
							<div class="col-xl-6 ">
								<%= f.label :insurance_carrier_name, "Carrier Name" %>
								<div class="input-group gap-1">
									<%= f.text_field :insurance_carrier_name, class: "form-control form-control-lg", id: "main-carrier-name" %>
									<button type="button" class="btn btn-primary" id="openModal">Search</button>
								</div>
							</div>
							<div class="col-xl-6">
								<%= f.label :address, "Address" %>
								<%= f.text_field :address, class: "form-control form-control-lg", placeholder: "Type here.." %>
							</div>
						</div>
						<!-- MODAL START -->
						<!-- MODAL START -->
						<div id="myModal" class="modal">
							<div class="modal-content">
								<p>
									To search for an existing carrier, please select the Country, State/Province, City and Carrier Name.
									If your Carrier Name is not listed, click <b>New</b> and complete the details. 
									Click <b>Save</b> and then <b>Close</b> to populate the data in the main form.
								</p>

								<div class="search-group">
									<!-- Country -->
									<div class="form-group">
										<label>By Country:</label>
										<%= f.select :country_country_name,
											options_for_select(ISO3166::Country.all.map { |c| [c.translations['en'] || c.name, c.alpha2] }, f.object.country_country_name),
											{ include_blank: "Select Country" },
											class: "form-control", id: "modal-country" %>
									</div>

									<!-- State -->
									<div class="form-group">
										<%= f.label :state, "By State/Province:" %>
										<%= f.select :state,
													[],
													{ include_blank: "Select State" },
													class: "form-control",
													id: "state-select" %>
									</div>

									<!-- City Dropdown -->
									<div class="form-group">
										<label for="modal-city-select">By City:</label>
										<%= f.select :city,
													options_for_select(
														ProviderInsuranceCoverage.where(form_type: 'popup')
																										.distinct
																										.pluck(:city)
																										.compact
																										.sort,
														f.object.city
													),
													{ include_blank: "Select City" },
													class: "form-control",
													id: "modal-city-select" %>
									</div>

									<!-- Carrier -->
									<div class="form-group">
										<label>By Carrier:</label>
										<input type="text" id="carrier-search-input" class="form-control mb-2" placeholder="Type to search Carrier...">

										<%= f.select :insurance_carrier_name,
											options_for_select(
												ProviderInsuranceCoverage.where(form_type: 'popup').map { |c|
													[
														c.insurance_carrier_name,
														c.insurance_carrier_name,
														{
															"data-city": c.city,
															"data-address": c.address,
															"data-suite": c.address2,
															"data-additional-address": c.additional_address,
															"data-state": c.state,
															"data-postal": c.postal_code,
															"data-phone": c.phone_number,
															"data-fax": c.fax_number,
															"data-email": c.email_address,
															"data-country": c.country_country_name || ""   # <--- Add this
														}
													]
												},
												f.object.insurance_carrier_name
											),
											{ include_blank: "Select Carrier" },
											class: "form-control", id: "modal-carrier-select" %>
										<button type="button" class="btn btn-primary mt-2" id="carrier-search-btn">Search</button>
									</div>
								</div>

								<!-- Carrier Information -->
								<div class="form-section">
									<div class="form-section-header">Carrier Information</div>

									<div class="form-group">
										<label>Carrier Name:</label>
										<%= f.text_field :insurance_carrier_name, class: "form-control", id: "modal-carrier-name" %>
									</div>
									<div class="form-group">
										<label>Address:</label>
										<%= f.text_field :address, class: "form-control", id: "modal-address" %>
									</div>
									<div class="form-group">
										<label>Suite/Dept/Mail Stop:</label>
										<%= f.text_field :address2, class: "form-control", id: "modal-address2" %>
									</div>
									<div class="form-group">
										<label>Additional Address:</label>
										<%= f.text_field :additional_address, class: "form-control", id: "modal-additional-address" %>
									</div>
									<div class="form-group">
										<label>City:</label>
										<%= f.text_field :city, class: "form-control", id: "modal-city" %>
									</div>
									<div class="form-group">
										<label>Country:</label>
										<%= f.text_field :country_country_name, class: "form-control", id: "modal-country-name" %>
									</div>
									<div class="form-group">
										<label>State:</label>
										<%= f.text_field :state, class: "form-control", id: "modal-state" %>
									</div>
									<div class="form-group">
										<label>Postal Code:</label>
										<%= f.text_field :postal_code, class: "form-control", id: "modal-postal-code" %>
									</div>
									<div class="form-group">
										<label>Phone:</label>
										<%= f.text_field :phone_number, class: "form-control", id: "modal-phone" %>
									</div>
									<div class="form-group">
										<label>Fax:</label>
										<%= f.text_field :fax_number, class: "form-control", id: "modal-fax" %>
									</div>
									<div class="form-group">
										<label>Email:</label>
										<%= f.text_field :email_address, class: "form-control", id: "modal-email" %>
									</div>
								</div>

								<div class="form-actions mt-3 d-flex justify-content-center gap-3">
									<button type="button" class="btn btn-success" id="new-btn">New</button>
									 <%= f.submit 'Save', class: 'btn btn-success', name: 'commit', value: 'save', id: 'popup-save-btn', style: 'display:none;' %>
									<button type="button" class="btn btn-secondary" id="modal-close-btn">Close</button>
								</div>
							</div>
						</div>
						<!-- MODAL END -->
     
						<div class="form-row row">
							<div class="col-xl-6">
								<%= f.label :address2, "Suite/Dept/Mail Stop:" %>
								<%= f.text_field :address2, class: "form-control form-control-lg", placeholder: "Type here.." %>
							</div>
							<div class="col-xl-6">
								<%= f.label :additional_address, "Additional Address:" %>
								<%= f.text_field :additional_address, class: "form-control form-control-lg", placeholder: "Type here.." %>
							</div>
						</div>
						<div class="form-row row">
							<div class="col-xl-6">
								<%= f.label :city, "City" %>
								<%= f.text_field :city, class: "form-control form-control-lg", placeholder: "Type here.." %>
							</div>
							<div class="col-xl-6">
								<%= f.label :country_country_name, "Country" %>
								<%= f.text_field :country_country_name, class: "form-control" %>
							</div>
						</div>
						<div class="form-row row">
							<div class="col-xl-4">
								<%= f.label :state, "State:" %>
								<%# <%= f.collection_select :state, State.all, :id, :name, {}, class: "form-control", id: "practice_info_state" %> 
								<%= f.text_field :state,  placeholder: 'Type here...', class: 'form-control border border-dark' %>
							</div>
							<div class="col-xl-4">
								<%= f.label :postal_code, "Zip/Postal Code:" %>
								<%= f.text_field :postal_code, class: "form-control form-control-lg", placeholder: "Type here.." %>
							</div>
							<div class="col-xl-4">
								<%# <label for="Country" class="text-dark-grey">Country:</label>
								<select name="country" id="country" class="form-select ">
									<option value="">Select option</option>
								</select> %>
							</div>
						</div>
						<div class="form-row row">
							<div class="col-xl-4">
								<%= f.label :phone_number, "Carrier Phone Number:" %>
								<%= f.text_field :phone_number, class: "form-control form-control-lg", placeholder: "xxx-xxx-xxxx" %>
							</div>
							<div class="col-xl-4">
								<%= f.label :fax_number, "Carrier Fax Number:" %>
								<%= f.text_field :fax_number, class: "form-control form-control-lg", placeholder: "xxx-xxx-xxxx" %>
							</div>
							<div class="col-xl-4">
								<%= f.label :email_address, "Carrier Email Address:" %>
								<%= f.text_field :email_address, class: "form-control form-control-lg", placeholder: "Type here.." %>
							</div>
						</div>
						<div class="form-row row mt-3 mb-3">

							<div class="col-xl-3">
								<%= f.label :policy_holder, "Policy Holder:" %>
								<%= f.text_field :policy_holder, class: "form-control form-control-lg", placeholder: "Type here.." %>
							</div>
							<div class="col-xl-3">
								<%= f.label :policy_number, "Policy Number:" %>
								<%= f.text_field :policy_number, class: "form-control form-control-lg", placeholder: "Type here.." %>
							</div>

							<div class="col-xl-3">
							  <%= f.label :effective_date, "Original Effective Date:", class: "" %>
							  <%= f.text_field :effective_date, 
							                   class: "form-control form-control-lg", 
							                   placeholder: "MM/DD/YYYY", 
							                   onfocus: "this.type='date'", 
							                   onblur: "this.type='text'" %>
							</div>

							<div class="col-xl-3">
							  <%= f.label :end_date, "Expiration Date:", class: "" %>
							  <div class="input-group gap-3 d-flex align-items-center">
							    <%= f.text_field :end_date, 
							                     class: "form-control form-control-lg", 
							                     placeholder: "MM/DD/YYYY", 
							                     onfocus: "this.type='date'", 
							                     onblur: "this.type='text'",
							                     id: "expiredate" %>
							    <div class="form-check">
									  <%= f.check_box :prof_liability_does_not_expire, 
									        { class: "form-check-input border-dark", id: "present-switch" }, 
									        true, false %>
									  <%= f.label :prof_liability_does_not_expire, "Does Not Expire", class: "form-check-label" %>
									</div>
							  </div>
							</div>
						</div>
					</div>
				</div>
				<div class="form-row row mb-2 mt-3">
					<div class="col-xl-4">
						<%= f.label :claim_amount, "Per Claim Amount:" %>
						<%= f.text_field :claim_amount, class: "form-control form-control-lg", placeholder: "Type here.." %>
					</div>
					<div class="col-xl-4">
						<%= f.label :coverage_amount_aggregate, "Aggregate Amount:" %>
						<%= f.text_field :coverage_amount_aggregate, class: "form-control form-control-lg", placeholder: "Type here.." %>
					</div>
					<div class="col-xl-4">
						<%= f.label :umbrella_coverage_amount, "Umbrella Coverage (amount):" %>
						<%= f.text_field :umbrella_coverage_amount, class: "form-control form-control-lg", placeholder: "Type here.." %>
					</div>
				</div>

				<div class="form-row row mb-2">
					<div class="col-xl-6">
						<label>Do you have tail coverage (extended reporting endorsement)?</label>
				    <%= f.radio_button :tail_coverage, true, checked: @provider_insurance_coverage.tail_coverage.nil? ? true : @provider_insurance_coverage.tail_coverage %>
				    <%= f.label :tail_coverage, "Yes", value: true %>
				    <%= f.radio_button :tail_coverage, false, checked: @provider_insurance_coverage.tail_coverage == false %>
				    <%= f.label :tail_coverage, "No", value: false %>
					</div>
				</div>

				<div class="form-row row mb-2">
					<div class="col-xl-8">
					  <div class="input-group d-flex align-items-center gap-2">
					    <%= f.label :current_carrier_excluded, 
					                "Has your current carrier excluded any specific area of practice or procedures from your coverage?", 
					                class: "text-dark-grey" %>
					    
					    <div class="form-check">
					      <%= f.radio_button :current_carrier_excluded, "yesExcludedAreaOfPractice", 
					                         class: "form-check-input", 
					                         id: "yesExcludedAreaOfPractice", 
					                         checked: true %>
					      <%= f.label :current_carrier_excluded_yes, "Yes", 
					                  class: "form-check-label", 
					                  for: "yesExcludedAreaOfPractice" %>
					    </div>

					    <div class="form-check">
					      <%= f.radio_button :current_carrier_excluded, "noExcludedAreaOfPractice", 
					                         class: "form-check-input", 
					                         id: "noExcludedAreaOfPractice" %>
					      <%= f.label :prof_liability_current_carrier_excluded_no, "No", 
					                  class: "form-check-label", 
					                  for: "noExcludedAreaOfPractice" %>
					    </div>
					  </div>
					</div>
				</div>

				<div class="form-row row ListOfExclusions" id="exclusions-container" style="display: none;">
				  <%= f.label :current_carrier_excluded_explanation, 
				              "If Yes, please list the exclusions with explanation:", 
				              class: "text-dark-grey" %>
				  <div class="col-xl-12">
				    <%= f.text_field :current_carrier_excluded_explanation, 
				                     class: "form-control form-control-lg", 
				                     id: "ListOfExclusions", 
				                     placeholder: "Type here.." %>
				  </div>
				</div>

				<div class="form-row row mt-2 mb-2">
				  <div class="col-xl-4">
				    <div class="input-group gap-2">
				      <%= f.label :show_on_tickler, "Show on Tickler?", class: "align-self-center" %>
				      <div class="form-check">
				        <%= f.radio_button :show_on_tickler, 'yesTickler', class: "form-check-input", id: "yesTickler" %>
				        <%= f.label :show_on_tickler_yesTickler, "Yes", class: "form-check-label" %>
				      </div>
				      <div class="form-check">
				        <%= f.radio_button :show_on_tickler, 'noTickler', class: "form-check-input", id: "noTickler", checked: true %>
				        <%= f.label :prof_liability_show_on_tickler_noTickler, "No", class: "form-check-label" %>
				      </div>
				    </div>
				  </div>
				</div>

				<div class="form-row row mb-3">
					<%= f.label :comment, "Please list any comments:" %>
					<div class="col-xl-12">
						<%= f.text_area :comment, class: "form-control form-control-lg", placeholder: "Type here.." %>
					</div>
				</div>

				<div class="form-row row justify-content-end">
					<div class="col-xl-3">
            <%= f.submit 'Save', class: 'btn btn-primary', name: 'commit', value: 'Create', id: 'main-save-btn' %>
					</div>
				</div>
			</div>
		<% end %>
	</div>
</div>

<script>
	document.addEventListener("DOMContentLoaded", () => {
	  const checkbox = document.getElementById("present-switch");
	  const endDateField = document.getElementById("expiredate");

	  checkbox.addEventListener("change", () => {
	    if (checkbox.checked) {
	      endDateField.value = "";
	      endDateField.disabled = true;
	    } else {
	      endDateField.disabled = false;
	    }
	  });

	  // for hidden the current_carrier_excluded_explanation section
	  const yesRadio = document.getElementById("yesExcludedAreaOfPractice");
	  const noRadio = document.getElementById("noExcludedAreaOfPractice");
	  const exclusionsContainer = document.getElementById("exclusions-container");

	  const toggleExclusions = () => {
	    if (yesRadio.checked) {
	      exclusionsContainer.style.display = "block";
	    } else {
	      exclusionsContainer.style.display = "none";
	    }
	  };

	  // Add event listeners to radio buttons
	  yesRadio.addEventListener("change", toggleExclusions);
	  noRadio.addEventListener("change", toggleExclusions);

	  // Initial state check
	  toggleExclusions();
	});

	document.addEventListener("DOMContentLoaded", function () {
		const modal = document.getElementById("myModal");
		const openBtn = document.getElementById("openModal");
		const closeBtn = document.getElementById("modal-close-btn");
		const newBtn = document.getElementById("new-btn");
		const saveBtn = document.getElementById("popup-save-btn");

		// --- Open modal
		openBtn?.addEventListener("click", () => modal.style.display = "block");

		// --- Close modal when clicked outside
		window.onclick = (e) => { if (e.target === modal) modal.style.display = "none"; };

		// --- Carrier Search ---
		const searchInput = document.getElementById("carrier-search-input");
		const carrierSelect = document.getElementById("modal-carrier-select");
		const searchBtn = document.getElementById("carrier-search-btn");

		if (searchInput && carrierSelect && searchBtn) {
			// Keep original options safely cloned once
			const allOptions = Array.from(carrierSelect.options).map(opt => opt.cloneNode(true));

			searchBtn.addEventListener("click", () => {
				const searchValue = searchInput.value.toLowerCase().trim();

				// Clear current options
				carrierSelect.innerHTML = "";

				// Always keep blank option
				const blankOption = document.createElement("option");
				blankOption.value = "";
				blankOption.text = "Select Carrier";
				carrierSelect.appendChild(blankOption);

				// Filter options
				const filtered = allOptions.filter(opt => 
					opt.value !== "" && (searchValue === "" || opt.text.toLowerCase().includes(searchValue))
				);

				if (filtered.length > 0) {
					filtered.forEach(opt => carrierSelect.appendChild(opt.cloneNode(true)));
				} else {
					// Show alert only once
					if (!carrierSelect.dataset.alertShown) {
						alert("No matching carrier found.");
						carrierSelect.dataset.alertShown = "true"; // mark that alert has shown
					}
				}

				// Reset selection
				carrierSelect.value = "";

				// Reset alert flag after next search click
				setTimeout(() => delete carrierSelect.dataset.alertShown, 0);
			});

			// --- Auto fill modal fields on carrier change
			carrierSelect.addEventListener("change", function () {
				const selected = this.options[this.selectedIndex];
				if (!selected) return;

				document.getElementById("modal-carrier-name").value = selected.text;
				document.getElementById("modal-address").value = selected.dataset.address || "";
				document.getElementById("modal-address2").value = selected.dataset.suite || "";
				document.getElementById("modal-additional-address").value = selected.dataset.additionalAddress || "";
				document.getElementById("modal-city").value = selected.dataset.city || "";
				document.getElementById("modal-state").value = selected.dataset.state || "";
				document.getElementById("modal-postal-code").value = selected.dataset.postal || "";
				document.getElementById("modal-phone").value = selected.dataset.phone || "";
				document.getElementById("modal-fax").value = selected.dataset.fax || "";
				document.getElementById("modal-email").value = selected.dataset.email || "";
				document.getElementById("modal-country-name").value = selected.dataset.country || "";
			});
		}

		// --- Copy Modal → Main Form
		function fillMainFormFromModal() {
			const fieldMap = {
				"provider_insurance_coverage_address": "modal-address",
				"provider_insurance_coverage_address2": "modal-address2",
				"provider_insurance_coverage_additional_address": "modal-additional-address",
				"provider_insurance_coverage_city": "modal-city",
				"provider_insurance_coverage_state": "modal-state",
				"provider_insurance_coverage_postal_code": "modal-postal-code",
				"provider_insurance_coverage_phone_number": "modal-phone",
				"provider_insurance_coverage_fax_number": "modal-fax",
				"provider_insurance_coverage_email_address": "modal-email",
				"provider_insurance_coverage_country_country_name": "modal-country-name"
			};

			// Copy all mapped fields
			Object.keys(fieldMap).forEach(mainId => {
				const modalId = fieldMap[mainId];
				const mainEl = document.getElementById(mainId) || document.querySelector(`[name='${mainId}']`);
				const modalEl = document.getElementById(modalId) || document.querySelector(`[name='${modalId}']`);
				if (mainEl && modalEl) mainEl.value = modalEl.value || "";
			});

			// --- Explicitly copy carrier name to main input
			const modalCarrier = document.getElementById("modal-carrier-name");
			const mainCarrier = document.getElementById("main-carrier-name");
			if (modalCarrier && mainCarrier) mainCarrier.value = modalCarrier.value || "";
		}

		// --- Close button → copy + close
		closeBtn?.addEventListener("click", function () {
			fillMainFormFromModal();
			modal.style.display = "none";
		});

		// --- New → show Save button
		newBtn?.addEventListener("click", () => saveBtn.style.display = "inline-block");

		// --- Save → copy data to main form
		saveBtn?.addEventListener("click", fillMainFormFromModal);

		// --- Keep carrier names synced
		document.getElementById("main-carrier-name")?.addEventListener("input", function () {
			const autoField = document.getElementById("modal-carrier-name");
			if (autoField) autoField.value = this.value;
		});
	});

	document.addEventListener("DOMContentLoaded", function () {
		const countrySelect = document.getElementById("modal-country"); // match ERB id
		const stateSelect = document.getElementById("state-select");    // make sure this exists

		countrySelect?.addEventListener("change", function () {
			const countryCode = this.value;
			stateSelect.innerHTML = '<option value="">Select State</option>';

			if (countryCode) {
				fetch(`/mhc/verification_platform/states?country=${countryCode}`)
					.then(res => res.json())
					.then(states => {
						states.forEach(st => {
							let opt = document.createElement("option");
							opt.value = st;
							opt.text = st;
							stateSelect.appendChild(opt);
						});
					});
			}
		});
	});

	document.addEventListener("DOMContentLoaded", function () {
		const citySelect = document.getElementById("modal-city-select");
		const carrierSelect = document.getElementById("modal-carrier-select");
		const searchInput = document.getElementById("carrier-search-input");

		if (!citySelect || !carrierSelect) return;

		const allOptions = Array.from(carrierSelect.options).map(opt => opt.cloneNode(true));

		function filterOptions() {
			const selectedCity = citySelect.value.toLowerCase();
			const term = searchInput.value.toLowerCase();
			carrierSelect.innerHTML = "";

			let filtered = allOptions.filter(opt => {
				const carrierCity = (opt.getAttribute("data-city") || "").toLowerCase();
				const carrierName = opt.textContent.toLowerCase();
				return (!selectedCity || carrierCity === selectedCity) && carrierName.includes(term);
			});

			if (filtered.length === 0) {
				let opt = document.createElement("option");
				opt.value = "";
				opt.text = "No matching carrier found";
				carrierSelect.appendChild(opt);
			} else {
				filtered.forEach(opt => carrierSelect.appendChild(opt.cloneNode(true)));
			}

			carrierSelect.value = "";
		}

		citySelect.addEventListener("change", filterOptions);
		searchInput?.addEventListener("input", filterOptions);
	});
</script>
