<script>
  document.addEventListener("DOMContentLoaded", () => {
  const yes = document.getElementById("other_name_yes");
  const no  = document.getElementById("other_name_no");
  const container = document.getElementById("other-names-wrapper");

  function showOtherNames() {
    container.style.display = "block";

    // If previously marked for destroy, undo it
    container.querySelectorAll(".other-name-fields").forEach(block => {
      const destroyField = block.querySelector("input[name*='[_destroy]']");
      if (destroyField) destroyField.value = "0";
      block.style.display = "block";
    });
  }

  function hideAndDestroyOtherNames() {
    container.style.display = "none";

    container.querySelectorAll(".other-name-fields").forEach(block => {
      const destroyField = block.querySelector("input[name*='[_destroy]']");
      const idField = block.querySelector("input[name*='[id]']");

      if (idField && idField.value !== "") {
        // existing record → mark for destroy
        destroyField.value = "1";
      } else {
        // new unsaved record → remove
        block.remove();
      }
    });
  }
 
  yes?.addEventListener("change", showOtherNames);
  no?.addEventListener("change", hideAndDestroyOtherNames);

  // Add new other name
  document.getElementById("add-other-name")?.addEventListener("click", () => {
    const template = document.querySelector("#other-name-template");
    if (!template) return;

    const content = template.innerHTML.replace(
      /NEW_RECORD/g,
      new Date().getTime()
    );

    container.insertAdjacentHTML("beforeend", content);
  });

  // Remove single other name
  document.addEventListener("click", (e) => {
    if (e.target.classList.contains("remove-other-name")) {
      e.preventDefault();

      const wrapper = e.target.closest(".other-name-fields");
      const destroyField = wrapper.querySelector("input[name*='[_destroy]']");
      const idField = wrapper.querySelector("input[name*='[id]']");

      if (idField && idField.value !== "") {
        destroyField.value = "1";
        wrapper.style.display = "none";
      } else {
        wrapper.remove();
      }
    }
  });

  // Initial state on page load
  if (no?.checked) {
    hideAndDestroyOtherNames();
  } else if (yes?.checked) {
    showOtherNames();
  }
});

</script>