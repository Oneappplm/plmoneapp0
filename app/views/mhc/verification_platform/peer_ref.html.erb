<% applicability = section_applicability(@provider_personal_information, "peer_ref") %>
<% peer_ref_not_applicable = section_not_applicable?(@provider_personal_information, "peer_ref") %>

<style>
  #peer_ref-section .page-applicable {
    <%= "display: none !important;" if peer_ref_not_applicable %>
  }

  #peer_ref-section .page-not-applicable {
    <%= "display: none !important;" unless peer_ref_not_applicable %>
  }
</style>
<div class="enc-content section-applicability-container"
     id="peer_ref-section"
     data-section-key="peer_ref">
		<div class="container">
			<%= render "top_nav_buttons"%>
			<div class="mt-4 d-flex align-items-end justify-content-between gap-3">
				<div class="d-flex align-items-center gap-3">
					<h4 class="page-heading">Peer References</h4>
					<%= render "section_applicability", section_key: "peer_ref" %>
				</div>
				<a href="<%= mhc_verification_platform_path(page_tab: 'add_new_peer_ref')%>" class="btn btn-primary py-1">
					<i class='bx bx-plus'></i>
					Add New Reference
				</a>
			</div>
			<div class="mt-2 page-applicable">
				<span class="page-note">
					<i class='bx bx-error-circle font-red'></i> <span>Please list three professional references, at
						least one from your specialty area, not including relatives, current partners or associates in
						practice.
						If possible, include at least one member from the Medical Staff of each facility at which you
						have privileges. Required fields are marked with the symbol “<span
							class="font-red">*</span>”.</span>
				</span>
				<span class="page-note">
					<i class='bx bx-error-circle font-red'></i> <span>References must be from individuals who are
						directly familiar with your work, either via direct clinical observation or through close
						working relations.</span>
				</span>
			</div>
			<table class="table table-bordered practice-table mt-3 page-applicable ">
				<thead>
					<tr>
						<th class="text-white" scope="col">Title</th>
						<th class="text-white">Practitioner Name</th>
						<th class="text-white">Address</th>
						<th class="text-white">State To</th>
						<th class="text-white">Zip Code</th>
						<th class="text-white">Status</th>
					</tr>
				</thead>
				<tbody>
					<% @peer_ref.each do |peer_ref| %>
						<tr>
							<td><a href="<%= mhc_verification_platform_path(page_tab: 'peer_ref_record', peer_ref_id: peer_ref.id)%>"><%= peer_ref.title %></a></td>
							<td><a href="<%= mhc_verification_platform_path(page_tab: 'peer_ref_record', peer_ref_id: peer_ref.id)%>"><%= peer_ref.practitioner_name %></a></td>
							<td><%= peer_ref.address %></td>
							<td><%= peer_ref.state %></td>
							<td><%= peer_ref.zip_code %></td>
							<td><%= peer_ref.audit_status.presence || "Not Requested" %></td>
						</tr>
					<% end %>
				</tbody>
			</table>
			<%= render "section_applicability_explanation",
           section_key: "peer_ref" %>
		</div>
	</div>