<div class="enc-content">
	<div class="container">
	 <%= render "top_nav_buttons"%>    
		<div class="add-license-content">
			<div class="container">
				<div class="row mt-5">
					<div class="d-flex align-items-center gap-1">
						<a href="<%= mhc_verification_platform_index_path(page_tab: 'peer_ref')%>" class="link-back">
							<i class='bx bx-left-arrow-alt' ></i>
						</a>
				    <h4 class="page-heading">Edit Peer Ref Record <%= @peer_ref.id %></h4> 
					</div>
				  <%#= render partial: 'licensure_form' %>
				  <%= form_with model: [:mhc, @peer_ref] do |form| %>
						<%= form.hidden_field :caqh_provider_attest_id %>
						<%= form.hidden_field :provider_attest_id, value: params[:id]  %>
						
						<div class="form-row row mt-3">
							<div class="col-xl-6">
								<%= form.label :title, "Title:" %>
								<%= form.select :title, options_for_select(titles), { prompt: true }, {:class => 'form-select border border-dark payer-state single-select'}  %>
							</div>
						</div>
						<div class="form-row row">
							<div class="col-xl-4">
								<%= form.label :first_name, "First Name:" %>
								<%= form.text_field :first_name, class: "form-control border border-dark", placeholder: "Type here..."  %>
							</div>
							<div class="col-xl-2">
								<%= form.label :middle_name, "Middle Name:" %>
								<%= form.text_field :middle_name, class: "form-control border border-dark", placeholder: "Type here..."  %>
							</div>
							<div class="col-xl-4">
								<%= form.label :last_name, "Last Name:" %>
								<%= form.text_field :last_name, class: "form-control border border-dark", placeholder: "Type here..."  %>
							</div>
							<div class="col-xl-2">
								<%= form.label :suffix, "Suffix:" %>
								<%= form.select :suffix, options_for_select(suffix), { prompt: 'Suffix' }, {:class => 'form-select border border-dark payer-state single-select'}  %>
							</div>
						</div>
						<div class="form-row row mt-2">
							<div class="col-xl-6">
								<%= form.label :practitioner_type, "Practitioner Type:" %>
								<%= form.select :practitioner_type,
						      options_for_select(provider_types.map { |m| [m.fch, m.fch] }, @peer_ref.practitioner_type),
						      { prompt: 'Select option' }, class: 'form-select' %>
							</div>
							<div class="col-xl-6">
								<%= form.label :specialty %>
      					<%= form.text_field :specialty, class: "form-control" %>
							</div>
						</div>
						<div class="form-row row mt-3">
							<div class="col-xl-6">
								<div class="d-flex align-items-center gap-3">
									<%#= form.label :is_board_certified, "Board Certified?" %><br>
									<%#= form.check_box :is_board_certified, class: "form-check-input border border-dark" %>

									<div class="d-flex align-items-center gap-3">
										<%= form.label :is_board_certified, "Board Certified" %>
										<div class="form-check">
											<%= form.radio_button :is_board_certified, true, class: "form-check-input border-dark", id: "board-certified-yes", checked: true %>
											<%= form.label :is_board_certified, "Yes", class: "form-check-label", for: "board-certified-yes" %>
										</div>
										<div class="form-check">
											<%= form.radio_button :is_board_certified, false, class: "form-check-input border-dark", id: "board-certified-no" %>
											<%= form.label :is_board_certified, "No", class: "form-check-label", for: "board-certified-no" %>
										</div>
									</div>

								</div>
							</div>
						</div>
						<div class="form-row row mt-3  health-card">
							<div class="col-xl-12">
								<div class="card other-name-card">
									<div class="card-body">
										<h6 class="form-heading">Contact Info</h6>
										<div class="form-row row">
											<div class="col-xl-6">
												<%= form.label :contact_method %>
      									<%= form.select :contact_method, options_for_select(["Fax", "Email", "Letter"]), { prompt: "Select option" }, class: "form-select" %>
											</div>
											<div class="col-xl-6">
												<%= form.label :address %>
      									<%= form.text_field :address, class: "form-control" %>
											</div>
										</div>
										<div class="form-row row">
											<div class="col-xl-6">
												<%= form.label :suite_dept_mail_stop, "Department/Mail Stop:" %>
      									<%= form.text_field :suite_dept_mail_stop, class: "form-control" %>
											</div>
											<div class="col-xl-6">
												<%= form.label :facility_name %>
      									<%= form.text_field :facility_name, class: "form-control" %>
											</div>
										</div>
										<div class="form-row row">
											<div class="col-xl-6">
												<%= form.label :city %>
      									<%= form.text_field :city, class: "form-control" %>
											</div>
											<div class="col-xl-6">
												<%= form.label :county %>
      									<%= form.text_field :county, class: "form-control" %>	
											</div>
										</div>
										<div class="form-row row">
											<div class="col-xl-4">
												<%= form.label :state %>
      									<%= form.text_field :state, class: "form-control" %>
											</div>
											<div class="col-xl-4">
												<%= form.label :zip_code %>
      									<%= form.text_field :zip_code, class: "form-control" %>
											</div>
											<div class="col-xl-4">
												<%= form.label :country %>
      									<%= form.text_field :country, class: "form-control" %>
											</div>
										</div>
										<div class="form-row row">
											<div class="col-xl-4">
												<%= form.label :phone_number %>
      									<%= form.text_field :phone_number, class: "form-control" %>
											</div>
											<div class="col-xl-4">
												<%= form.label :fax_number %>
      									<%= form.text_field :fax_number, class: "form-control" %>
											</div>
											<div class="col-xl-4">
												<%= form.label :email_address %>
      									<%= form.email_field :email_address, class: "form-control" %>
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>

						<div class="form-row row mt-3">
							<div class="col-xl-6">
								<div class="d-flex align-items-center gap-3">
									<%= form.label :show_on_tickler, "Show on tickler?" %>
									<div class="form-check">
										<%= form.radio_button :show_on_tickler, true, class: "form-check-input", id: "show-on-tickler-yes" %>
										<%= form.label :show_on_tickler, "Yes", class: "form-check-label", for: "show-on-tickler-yes" %>
									</div>
									<div class="form-check">
										<%= form.radio_button :show_on_tickler, false, class: "form-check-input", id: "show-on-tickler-no", checked: true %>
										<%= form.label :show_on_tickler, "No", class: "form-check-label", for: "show-on-tickler-no" %>
									</div>
								</div>
							</div>
						</div>

						<div class="form-row row mt-2">
							<div class="col-xl-25">
								<%= form.label :comments, "Please List any comments:" %>
      					<%= form.text_area :comments, class: "form-control border border-dark", rows: 3 %>
							</div>
						</div>

						<div class="form-row mt-1 d-flex justify-content-end">
							<%= form.submit class: "btn btn-primary mt-2" %>
						</div>
					<% end %>
				</div>
			</div>
		</div>
	</div>
</div>
