<% applicability = section_applicability(@provider_personal_information, "facilities") %>
<% facilities_not_applicable = section_not_applicable?(@provider_personal_information, "facilities") %>

<style>
  #facilities-section .page-applicable {
    <%= "display: none !important;" if facilities_not_applicable %>
  }

  #facilities-section .page-not-applicable {
    <%= "display: none !important;" unless facilities_not_applicable %>
  }
</style>
<div class="enc-content section-applicability-container"
     id="facilities-section"
     data-section-key="facilities">
  <div class="container">
    <%= render "top_nav_buttons"%>

    <div class="mt-4 d-flex align-items-end justify-content-between gap-3">
      <div class="d-flex align-items-center gap-3">
        <h4 class="page-heading">Facilities</h4>
        <%= render "section_applicability", section_key: "facilities" %>
      </div>

      <a href="<%= mhc_verification_platform_path(page_tab: 'add_new_facility')%>" class="btn btn-primary py-1">
        <i class='bx bx-plus'></i>
        Add New Facility
      </a>
    </div>

    <div class="mt-2 page-applicable">
      <span class="page-note">
        <i class='bx bx-error-circle font-red'></i> <span>Please list all facilities with which you are or
        have ever been affiliated since completion of education and training, beginning with your
        primary facility. This includes hospitals, surgery centers, institutions, corporations, military
        assignments and government agencies. Required fields are marked with the symbol “*”. “<span
        class="font-red">*</span>”.</span>
      </span>
      <span class="page-note">
        <i class='bx bx-error-circle font-red'></i> <span>Please check the Not Applicable box if you are not
        currently and have never been affiliated with a facility.</span>
      </span>
    </div>
    <div class="row mt-3 page-applicable">
      <div class="col-xl-4">
        <div class="form-control enc-search-wrp  border border-dark input-group">
          <input type="" name="" class="enc-search-input" placeholder="Search">
          <i class='bx bx-search'></i>
        </div>
      </div>
    </div>
    <div class="row result-controls page-applicable">
      <div class="col-xl-6 filter-result mt-2 mb-2">
        <% if @facilities.present? %>
          <h6 class="">Result: <%= @facilities.count %> records</h6>
        <% end %>
      </div>
     <!--  <div class="col-xl-6">
        <div class="table-controls">
          <div class="control-wrp">
            <label for="limit">Show limit</label>
            <input type="text" id="limit" class="form-control" value="20">
          </div>
          <div class="control-wrp">
            <label for="page">Page 1 of 32</label>
            <input type="text" id="page" class="form-control" value="1">
          </div>
        </div>
      </div> -->
    </div>
    <table class="table table-bordered practice-table mt-3 page-applicable ">
      <thead>
        <tr>
          <th class="text-white" scope="col">Facility</th>
          <th class="text-white">Department</th>
          <th class="text-white">Section Name</th>
          <th class="text-white">Appointment Date</th>
          <th class="text-white">Expiration Date</th>
          <th class="text-white">Department Chair</th>
          <th class="text-white">Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @facilities.where(form_type: [nil, 'main']).each do |facility| %>
          <tr>
            <td>
              <a href="<%= mhc_verification_platform_path(page_tab: 'facility_record', facility_id: facility.id )%>">
                <%= facility.facility_name %>
              </a>
            </td>
            <td><%= facility.department %></td>
            <td><%= facility.section_name %></td>
            <td><%= facility.appointment_date %></td>
            <td><%= facility.expiration_date %></td>
            <td><%= facility.facility_chair %></td>
            <td><%= facility.audit_status.presence || "Not Requested" %></td>
            <td>
              <%= button_to mhc_provider_personal_information_facility_path(facility), 
                  method: :delete, 
                  data: { confirm: 'Are you sure you want to delete this peer ref detail?' }, 
                  class: 'btn btn-outline-danger' do %>
                <i class="bx bx-trash"></i>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= render "section_applicability_explanation",
           section_key: "facilities" %>
  </div>
</div>