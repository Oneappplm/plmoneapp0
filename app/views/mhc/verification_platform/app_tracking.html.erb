<% applicability = section_applicability(@provider_personal_information, "app_tracking") %>
<% app_tracking_not_applicable = section_not_applicable?(@provider_personal_information, "app_tracking") %>

<style>
  #app_tracking-section .page-applicable {
    <%= "display: none !important;" if app_tracking_not_applicable %>
  }

  #app_tracking-section .page-not-applicable {
    <%= "display: none !important;" unless app_tracking_not_applicable %>
  }
</style>

<div class="enc-content section-applicability-container"
     id="app_tracking-section"
     data-section-key="app_tracking">

  <div class="container">

    <%= render "top_nav_buttons" %>

    <!-- Page Heading and Applicability Toggle -->
    <div class="mt-4 d-flex align-items-end justify-content-between gap-3">

      <div class="d-flex align-items-center gap-3">
        <h4 class="page-heading">App Tracking</h4>

        <%= render "section_applicability",
                   section_key: "app_tracking" %>
      </div>

      <!-- Add New Application -->
      <a href="<%= mhc_verification_platform_path(page_tab: 'app_tracking_record') %>"
         class="btn btn-primary page-applicable AddBoardCertificate py-1"
         id="AddBoardCertificate">

        <i class="bx bx-plus"></i>
        Add New Application
      </a>

    </div>

    <!-- Applicable Section -->
    <div class="page-applicable">

      <!-- Pagination -->
      <% if @provider_personal_information_app_trackings %>
        <div class="col-lg-12 mt-3 mb-3">

          <div class="d-flex justify-content-between bg-medium-grey rounded align-items-center py-1">

            <div class="page_info ms-3 text-black">
              <%= page_entries_info @provider_personal_information_app_trackings %>
            </div>

            <% if params[:per_page].present? %>
              <%= will_paginate @provider_personal_information_app_trackings,
                                params: { per_page: @per_page },
                                renderer: WillPaginate::ActionView::BootstrapLinkRenderer %>
            <% else %>
              <%= will_paginate @provider_personal_information_app_trackings,
                                renderer: WillPaginate::ActionView::BootstrapLinkRenderer %>
            <% end %>

          </div>
        </div>
      <% end %>

      <!-- Application Tracking Records -->
      <table class="table table-bordered practice-table mt-3">

        <thead>
          <tr>
            <th class="text-white" scope="col">Application Type</th>
            <th class="text-white">Application Receipt Date</th>
            <th class="text-white">App Receive Complete Date</th>
            <th class="text-white">Verifications Complete Date</th>
            <th class="text-white">File Return to Client Date</th>
            <th class="text-white">Output File Date</th>
          </tr>
        </thead>

        <tbody>
          <% Array(@provider_personal_information_app_trackings).each do |provider_personal_information_app_tracking| %>

            <tr>
              <td>
                <a href="<%= mhc_verification_platform_path(
                              page_tab: 'app_tracking_record',
                              provider_personal_information_app_tracking_id: provider_personal_information_app_tracking.id
                            ) %>">
                  <%= provider_personal_information_app_tracking.application_type&.titleize %>
                </a>
              </td>

              <td>
                <%= provider_personal_information_app_tracking.application_receipt_date&.strftime('%b %d, %Y') %>
              </td>

              <td>
                <%= provider_personal_information_app_tracking.application_receive_complete_date&.strftime('%b %d, %Y') %>
              </td>

              <td>
                <%= provider_personal_information_app_tracking.verification_complete_date&.strftime('%b %d, %Y') %>
              </td>

              <td>
                <%= provider_personal_information_app_tracking.file_return_to_client_date&.strftime('%b %d, %Y') %>
              </td>

              <td></td>
            </tr>

          <% end %>
        </tbody>

      </table>

      <!-- Reinstatement -->
      <div class="row mt-3">
        <div class="col-xl-12">
          <label>Reinstatement</label>
        </div>
      </div>

      <div class="row">
        <div class="col-xl-12">

          <div class="form-check d-flex align-items-center gap-2">

            <input class="form-check-input"
                   type="checkbox"
                   id="indicator"
                   value="indicator">

            <label class="form-check-label" for="indicator">
              Indicator
            </label>

          </div>
        </div>
      </div>

      <!-- Client Flags -->
      <div class="form-row mt-3">

        <div class="row">

          <div class="col-xl-6">

            <label>Master Client Flag List</label>

            <div class="left-pane bg-gray">

              <div class="form-control enc-search-wrp">
                <input type="text"
                       class="enc-search-input"
                       placeholder="Search">
              </div>

            </div>

          </div>

          <div class="col-xl-6">

            <label>Client Flag</label>

            <div class="right-pane border-dash bg-gray">
            </div>

          </div>

        </div>

      </div>

    </div>
    <!-- End Applicable Section -->

    <!-- Not Applicable Explanation -->
    <%= render "section_applicability_explanation",
               section_key: "app_tracking" %>

  </div>
</div>

