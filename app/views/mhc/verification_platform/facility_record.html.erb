<div class="enc-content">
  <div class="container">
    <%= render "top_nav_buttons"%>
      
    <div class="add-license-content mt-4">
      <div class="row">
        <div class="d-flex align-items-end justify-content-between gap-3">
          <div class="d-flex align-items-center gap-3">
            <h4 class="page-heading">Facility Record <%= @facility.id %></h4>

            <%= link_to "Edit", mhc_verification_platform_path(page_tab: 'edit_facility', facility_id: @facility.id), class: "btn btn-primary py-1 btn-license-edit" %>
          </div>

          <% if @facility.persisted? %>
            <div class="">
              <%= button_to 'Delete', 
                  mhc_provider_personal_information_facility_path(@facility), 
                  method: :delete, 
                  data: { confirm: 'Are you sure you want to delete this peer ref detail?' }, 
                  class: 'btn btn-danger' %>
            </div>
          <% end %>
        </div>

        <div class="enc-tabs-wrp mt-3">
          <div class="">
            <button class="btn btn-primary py-1 " name="ver-letter" type="button" data-bs-toggle="modal"
                data-bs-target="#verifLetterModal">
                Verification Letter
            </button>
          </div>
          <div class="">
            <button class="btn btn-primary py-1 " name="send-contract" type="button">
                Send Contract
            </button>
          </div>
          <div class="">
            <button class="btn btn-primary py-1 " name="view-scan-img" type="button">
                View Scanned Images
            </button>
          </div>
        </div>
      </div>

      <div class="mt-3 row page-applicable">
        <div class="col-xl-5">
          <div class="left-pane">
            <h6 class="offset-md-5">RVA Information</h6>
            <div class="form-row row mt-4">
              <div class="col-xl-4">
                <button class="btn btn-pane bg-alt-grey py-1">
                  Request
                </button>
              </div>
              <div class="col-xl-4">
                <button class="btn btn-pane bg-alt-grey py-1">
                  Verification
                </button>
              </div>
              <div class="col-xl-4">
                <button class="btn btn-pane bg-alt-grey py-1">
                  Audit
                </button>
              </div>
            </div>
              <div class="form-row row mt-2">
                <div class="col-xl-6">
                  <button class="btn btn-pane bg-alt-grey py-1" data-bs-toggle="modal" data-bs-target="#QAModal">
                    Quality Audit
                  </button>
                </div>
                <div class="col-xl-6">
                  <button class="btn btn-pane bg-alt-grey py-1">
                    Skip RVA
                  </button>
                </div>
              </div>
          </div>
        </div>
        <div class="col-xl-7">
          <div class="right-pane">
            <div class="d-flex align-items-center justify-content-between">
              <h6 class="offset-md-5">Message Board</h6>
              <button class="btn btn-primary py-1" data-bs-toggle="modal" data-bs-target="#addCommentModal">
                  Add Comment
              </button>
            </div>
            <div class="form-row mt-2">
              <span class="btn span-pane bg-alt-grey py-1" data-bs-toggle="modal" data-bs-target="#deleteCommentModal">
                  Subject: Incomplete Record
              </span>
            </div>
          </div>
        </div>
      </div>

      <div class="col-xl-12 right-pane mt-3">
        <div class="form-row row">
          <div class="d-flex align-items-center gap-10">
            <span class="page-note">
            <i class='bx bx-error-circle font-blue'></i> <span>To search for a Facility name,
            please
            click the Search button..</span>
            </span>
          </div>
          <div class="col-xl-5">
            <label for="supervising-prac">Facility Name:</label>
            <span class="form-control form-control-lg border-dark">
              <%= @facility.facility_name || "N/A" %>
            </span>
          </div>
          <div class="col-xl-1">
            <div class="d-flex align-items-center gap-10 mt-3">
              <button class="btn btn-primary mt-2" type="submit">
              Search
              </button>
            </div>
          </div>
          <div class="col-xl-6">
            <label for="facility-address">Contact:</label>
            <span class="form-control form-control-lg border-dark">
              <%= @facility.contact || "N/A" %>
            </span>
          </div>
        </div>
        <div class="form-row row mt-2">
          <div class="col-xl-6">
            <label for="facility-contact">Address:</label>
            <span class="form-control form-control-lg border-dark">
              <%= @facility.address || "N/A" %>
            </span>
          </div>
          <div class="col-xl-6">
            <label for="facility-add-address">Additional Address:</label>
            <span class="form-control form-control-lg border-dark">
              <%= @facility.addition_address || "N/A" %>
            </span>
          </div>
        </div>
        <div class="form-row row mt-2">
          <div class="col-xl-6">
            <label for="facility-city">City:</label>
            <span class="form-control form-control-lg border-dark">
              <%= @facility.city || "N/A" %>
            </span>
          </div>
          <div class="col-xl-6">
            <label for="facility-city-county">County:</label>
            <span class="form-control form-control-lg border-dark">
              <%= @facility.county || "N/A" %>
            </span>
          </div>
        </div>
        <div class="form-row row mt-2">
          <div class="col-xl-4">
            <label for="facility-state">State/Province:</label>
            <span class="form-control form-control-lg border-dark">
              <%= @facility.state || "N/A" %>
            </span>
          </div>
          <div class="col-xl-4">
            <label for="facility-zip">Zip/Postal Code:</label>
            <span class="form-control form-control-lg border-dark">
              <%= @facility.zip_code || "N/A" %>
            </span>
          </div>
          <div class="col-xl-4">
            <label for="facility-country">Country:</label>
            <span class="form-control form-control-lg border-dark">
              <%= @facility.country || "N/A" %>
            </span>
          </div>
        </div>
        <div class="form-row row mt-2">
          <div class="col-xl-4">
            <label for="facility-office-pnone">Medical Staff Office Phone:</label>
            <span class="form-control form-control-lg border-dark">
              <%= @facility.facility_office_pnone || "N/A" %>
            </span>
          </div>
          <div class="col-xl-4">
            <label for="facility-office-pnone">Medical Staff Office Fax:</label>
            <span class="form-control form-control-lg border-dark">
              <%= @facility.facility_office_fax || "N/A" %>
            </span>
          </div>
          <div class="col-xl-4">
            <label for="facility-office-email">Medical Staff Office Email Address:</label>
            <span class="form-control form-control-lg border-dark">
              <%= @facility.facility_office_email || "N/A" %>
            </span>
          </div>
        </div>
      </div>

      <div class="form-row row mt-2">
        <div class="col-xl-4">
          <label for="facility-appointment-date">Appointment Date:</label>
          <span class="form-control form-control-lg border-dark">
            <%= @facility.appointment_date || "N/A" %>
          </span>
        </div>
        <div class="col-xl-4">
          <label for="facility-department">Department:</label>
          <span class="form-control form-control-lg border-dark">
            <%= @facility.department || "N/A" %>
          </span>
        </div>
        <div class="col-xl-4">
          <label for="facility-section">Section Name:</label>
          <span class="form-control form-control-lg border-dark">
            <%= @facility.section_name || "N/A" %>
          </span>
        </div>
      </div>

      <div class="form-row row mt-2">
        <div class="col-xl-4">
          <label for="facility-chair">Department Chair:</label>
          <span class="form-control form-control-lg border-dark">
            <%= @facility.facility_chair || "N/A" %>
          </span>
        </div>
        <div class="col-xl-4">
          <label for="facility-chair-title">Department Chair Title:</label>
          <span class="form-control form-control-lg border-dark">
            <%= @facility.facility_chair_title || "N/A" %>
          </span>
        </div>
        <div class="col-xl-4">
          <label for="facility-status">Status:</label>
          <span class="form-control form-control-lg border-dark">
            <%= @facility.status || "N/A" %>
          </span>
        </div>
      </div>

      <div class="col-xl-4">
        <label for="facility-expiration">Expiration Date:</label>
        <span class="form-control form-control-lg border-dark">
          <%= @facility.expiration_date || "N/A" %>
        </span>
      </div>

      <div class="form-row row mt-3">
        <div class="col-xl-4">
          <div class="d-flex align-items-center gap-3">
            <label for="" class="">Current?</label>
             <div class="form-check">
              <input class="form-check-input" type="radio" name="current-radio" id="current-yes" value="Yes" 
                <%= 'checked' if @facility.is_current == true %>>
              <label class="form-check-label" for="current-yes">
                Yes
              </label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="current-radio" id="current-no" value="No"
                <%= 'checked' if @facility.is_current == false %>>
              <label class="form-check-label" for="current-no">
                No
              </label>
            </div>
          </div>

          <div class="d-flex align-items-center gap-3">
            <div class="d-flex align-items-center gap-3">
              <label for="" class="">Is this your primary admitting facility?</label>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="primary-admitting-radio" id="primary-admitting-yes" value="Yes" 
                  <%= 'checked' if @facility.is_primary_admitting_facility == true %>>
                <label class="form-check-label" for="primary-admitting-yes">
                  Yes
                </label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="primary-admitting-radio" id="primary-admitting-no" value="No"
                  <%= 'checked' if @facility.is_primary_admitting_facility == false %>>
                <label class="form-check-label" for="primary-admitting-no">
                  No
                </label>
              </div>
            </div>
          </div>
        </div>
        <div class="col-xl-4">
          <div class="d-flex align-items-center gap-3">
            <label for="" class="">Any past or present restriction of privileges at this facility?</label>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="restriction-radio" id="restriction-yes" value="Yes" 
                <%= 'checked' if @facility.is_restriction_of_privileges == true %>>
              <label class="form-check-label" for="restriction-yes">
                Yes
              </label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="restriction-radio" id="restriction-no" value="No"
                <%= 'checked' if @facility.is_restriction_of_privileges == false %>>
              <label class="form-check-label" for="restriction-no">
                No
              </label>
            </div>
          </div>
        </div>
      </div>
      <div class="form-row row mt-2">
        <div class="d-flex align-items-center gap-3">
          <div class="d-flex align-items-center gap-3">
            <label for="" class="">If No, do you admit patients to this facility?</label>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="admin-patient-radio" id="admin-patient-yes" value="Yes" 
                <%= 'checked' if @facility.is_admit_patients_facility == true %>>
              <label class="form-check-label" for="admin-patient-yes">
                Yes
              </label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="admin-patient-radio" id="admin-patient-no" value="No"
                <%= 'checked' if @facility.is_admit_patients_facility == false %>>
              <label class="form-check-label" for="admin-patient-no">
                No
              </label>
            </div>
          </div>
        </div>
      </div>
      <div class="form-row row mt-2">
        <div class="col-xl-4 mt-3 mb-3">
          <label for="">If Yes, please indicate percentage of admissions:</label>
          <span class="fac-percent input-holder form-control form-control-lg border-dark mt-2">
             <%= @facility.faciltiy_percentage || "N/A" %>
           <!--  <input type="number" name="fac-percent" max="100"
            accuracy="2" min="0" id="inputRRPDiscount" style="text-align:left;"> -->
          </span>
        </div>

        <div class="form-row row mt-2">
          <div class="col-xl-5">
            <%= check_box_tag :is_hospital_based_practitioner, "1", @facility.is_hospital_based_practitioner, class: "form-check-input-license", id: "hospital_based_flag" %>
            <label class="form-check-label" for="hospital_based_flag">
              I am a hospital-based practitioner and do not admit patients
            </label>
          </div>
        </div>

        <div class="form-row row mt-2">
          <div class="col-xl-4">
            <%= check_box_tag :is_admitting_arrangements, "1", @facility.is_admitting_arrangements, class: "form-check-input-license", id: "hospital_admitting_arrangements" %>
            <label class="form-check-label" for="hospital_admitting_arrangements">
              My admitting arrangements are as follows:
            </label>
          </div>
        </div>

        <div class="form-row row mt-2">
          <div class="col-xl-4">
            <%= check_box_tag :is_following_physician, "1", @facility.is_following_physician, class: "form-check-input-license", id: "admitting_physicians_flag" %>
            <label class="form-check-label" for="admitting_physicians_flag">
              The following physician(s) admit on my behalf:
            </label>
          </div>
        </div>



        <div class="form-row row mt-3">
          <div class="col-xl-6">
            <div class="d-flex align-items-center gap-3">
              <label for="" class="">Show on Tickler?</label>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="show-on-tickler-radio" id="show-on-tickler-yes" value="Yes" 
                  <%= 'checked' if @facility.show_on_tickler == true %>>
                <label class="form-check-label" for="show-on-tickler-yes">
                  Yes
                </label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="show-on-tickler-radio" id="show-on-tickler-no" value="No"
                  <%= 'checked' if @facility.show_on_tickler == false %>>
                <label class="form-check-label" for="show-on-tickler-no">
                  No
                </label>
              </div>
            </div>
          </div>
        </div>
        <div class="form-row row mt-2">
          <div class="col-xl-25">
            <label for="facility-com">Please List any comments</label>
            <span class="form-control form-control-lg border-dark mt-2">
             <%= @facility.comments || "N/A" %>
          </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Add Comment Modal -->
<div class="modal fade" id="addCommentModal" tabindex="-1" aria-labelledby="exampleModalLabel"
    aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-body">
        <div class="content">
          <div class="modal-title">
            <h6 class="offset-md-5">Add Comment</h6>
            <button class="btn btn-cancel" data-bs-dismiss="modal">Cancel</button>
          </div>
          <form action="">
            <div class="form-row mt-3">
              <label for="">Subject:</label>
              <input type="text" class="form-control">
            </div>
            <div class="form-row">
              <label for="">Message:</label>
              <textarea name="" id="" cols="30" rows="5" class="form-control"></textarea>
            </div>
          </form>
          <div class="form-row mt-3 d-flex justify-content-center">
            <button class="btn btn-primary py-1">Post Comment</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Delete Comment Modal -->
<div class="modal fade" id="deleteCommentModal" tabindex="-1" aria-labelledby="exampleModalLabel"
    aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-body">
        <div class="content">
          <div class="modal-title">
            <h6 class="offset-md-5">Comment</h6>
            <button class="btn btn-cancel" data-bs-dismiss="modal">Cancel</button>
          </div>
          <form action="">
            <div class="form-row mt-3">
              <label for="">Subject:</label>
              <input type="text" class="form-control">
            </div>
            <div class="form-row">
              <label for="">Message:</label>
              <textarea name="" id="" cols="30" rows="5" class="form-control"></textarea>
            </div>
          </form>
          <div class="form-row mt-3 d-flex justify-content-center">
            <button class="btn btn-red">Delete Comment</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Quality Audit Modal -->
<div class="modal fade" id="QAModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-body">
                <div class="content">
                    <div class="modal-title">
                        <h6 class="">Quality Audit</h6>
                        <button class="btn btn-cancel" data-bs-dismiss="modal">Cancel</button>
                    </div>
                    <div class="form-row row mt-3">
                        <div class="col-xl-12">
                            <div class="card other-name-card">
                                <form action="">
                                    <div class="card-body">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <h6 class="form-heading">Request</h6>
                                            <div class="d-flex justify-content-end gap-2">
                                                <button class="btn btn-primary py-1">
                                                    View Request History
                                                </button>
                                                <button class="btn btn-primary py-1">
                                                    View Webcrawler Image Archive
                                                </button>
                                            </div>
                                        </div>
                                        <div class="form-row mt-3">
                                            <button class="btn btn-primary py-1">
                                                Send Request
                                            </button>
                                        </div>
                                        <div class="form-row d-flex mt-3">
                                            <label for="">Requested By:</label>
                                        </div>
                                        <div class="form-row">
                                            <label for="">Requested Date:</label>
                                        </div>
                                        <div class="form-row d-flex align-items-center gap-3">
                                            <label for="">Requested Method:</label>
                                            <div class="form-check d-flex align-items-center gap-2">
                                                <input class="form-check-input" type="radio" name="method-radio"
                                                    id="method-autofax" value="AutoFax">
                                                <label class="form-check-label" for="method-autofax">
                                                    AutoFax
                                                </label>
                                            </div>
                                            <div class="form-check d-flex align-items-center gap-2">
                                                <input class="form-check-input" type="radio" name="method-radio"
                                                    id="method-email" value="E-Mail">
                                                <label class="form-check-label" for="method-email">
                                                    E-Mail
                                                </label>
                                            </div>
                                            <div class="form-check d-flex align-items-center gap-2">
                                                <input class="form-check-input" type="radio" name="method-radio"
                                                    id="method-letter" value="Letter">
                                                <label class="form-check-label" for="method-letter">
                                                    Letter
                                                </label>
                                            </div>
                                            <div class="form-check d-flex align-items-center gap-2">
                                                <input class="form-check-input" type="radio" name="method-radio"
                                                    id="method-phone" value="Phone">
                                                <label class="form-check-label" for="method-phone">
                                                    Phone
                                                </label>
                                            </div>
                                            <div class="form-check d-flex align-items-center gap-2">
                                                <input class="form-check-input" type="radio" name="method-radio"
                                                    id="method-website" value="Website">
                                                <label class="form-check-label" for="method-website">
                                                    Website
                                                </label>
                                            </div>
                                        </div>
                                        <div class="form-row row">
                                            <div class="col-xl-6">
                                                <label for="req-fee-amount">Required Fee Amount:</label>
                                                <input type="text" name="req-fee-amount" id="req-fee-amount"
                                                    class="form-control" placeholder="Type here...">
                                            </div>
                                            <div class="col-xl-6">
                                                <label for="check-payable-to">Check Payable To:</label>
                                                <input type="text" name="check-payable-to" id="check-payable-to"
                                                    class="form-control" placeholder="Type here...">
                                            </div>
                                        </div>
                                        <div class="form-row mt-2">
                                            <div class=" form-check d-flex align-items-center gap-2">
                                                <input class="form-check-input" type="checkbox"
                                                    id="inc-delineation-check"
                                                    value="Include Delineation of Privileges">
                                                <label class="form-check-label"
                                                    for="inc-delineation-check">Include Delineation of
                                                    Privileges</label>
                                            </div>
                                        </div>
                                        <div class="form-row d-flex align-items-center gap-3">
                                            <label for="">Check has generated?</label>
                                            <div class="form-check d-flex align-items-center gap-2">
                                                <input class="form-check-input" type="radio"
                                                    name="check-generate-radio" id="check-generate-yes"
                                                    value="Yes">
                                                <label class="form-check-label" for="check-generate-yes">
                                                    Yes
                                                </label>
                                            </div>
                                            <div class="form-check d-flex align-items-center gap-2">
                                                <input class="form-check-input" type="radio"
                                                    name="check-generate-radio" id="check-generate-no"
                                                    value="No">
                                                <label class="form-check-label" for="check-generate-no">
                                                    No
                                                </label>
                                            </div>
                                        </div>
                                        <div class="form-row d-flex align-items-center gap-3">
                                            <label for="">Received Status:</label>
                                            <div class="form-check d-flex align-items-center gap-2">
                                                <input class="form-check-input" type="radio"
                                                    name="received-status-radio" id="received-status-yes"
                                                    value="Yes">
                                                <label class="form-check-label" for="received-status-yes">
                                                    Yes
                                                </label>
                                            </div>
                                            <div class="form-check d-flex align-items-center gap-2">
                                                <input class="form-check-input" type="radio"
                                                    name="received-status-radio" id="received-status-no"
                                                    value="No">
                                                <label class="form-check-label" for="received-status-no">
                                                    No
                                                </label>
                                            </div>
                                        </div>
                                        <div class="form-row">
                                            <label for="">Received By:</label>
                                        </div>
                                        <div class="form-row">
                                            <label for="">Received Date:</label>
                                        </div>
                                        <div class="form-row">
                                            <label for="">Comments:</label>
                                            <textarea name="" id="" cols="30" rows="3"
                                                class="form-control"></textarea>
                                        </div>
                                        <div class="form-row d-flex justify-content-end gap-2 mt-3">
                                            <button class="btn btn-primary py-1">
                                                View Received Images
                                            </button>
                                            <button type="submit" class="btn btn-primary py-1">
                                                Save Request
                                            </button>
                                            <button class="btn btn-primary py-1">
                                                Restart Request
                                            </button>
                                            <button class="btn btn-primary py-1">
                                                Run Webcrawler
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                    <div class="form-row row mt-3">
                        <div class="col-xl-12">
                            <div class="card other-name-card">
                                <form action="">
                                    <div class="card-body">
