<% applicability = section_applicability(@provider_personal_information, "board_cert") %>
<% board_cert_not_applicable = section_not_applicable?(@provider_personal_information, "board_cert") %>
<style>
  #board-cert-section .page-applicable {
    <%= "display: none !important;" if board_cert_not_applicable %>
  }

  #board-cert-section .page-not-applicable {
    <%= "display: none !important;" unless board_cert_not_applicable %>
  }
</style>

    <div class="enc-content section-applicability-container"
     id="board-cert-section"
     data-section-key="board_cert">
        <div class="container">
            <%= render "top_nav_buttons"%>
            <div class="mt-4 d-flex align-items-end justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <h4 class="page-heading">Board Certification</h4>
                    <%= render "section_applicability", section_key: "board_cert" %>
                </div>
                 <a href="<%= mhc_verification_platform_path(page_tab: 'board_cert_info')%>" class="btn btn-primary py-1 page-applicable">
                    <i class='bx bx-plus' ></i>
                    Add New Board Cert
                </a>
            </div>
            <div class="mt-2 page-applicable">
                <span class="page-note">
                    <i class='bx bx-error-circle font-red'></i> <span>Please complete board certification status for your primary, secondary and tertiary specialties. Include all other boards with which you are or have been certified. Required fields are marked with the symbol “<span class="font-red">*</span>”.</span>.
                </span>
                <span class="page-note">
                    <i class='bx bx-error-circle font-red'></i> <span>Please check the Not Applicable button if you have never enrolled in a professional education program.</span>
                </span>
            </div>
            <div class="row mt-3 page-applicable">
              <div class="col-xl-4">
                <%= search_form_for @q, url: mhc_verification_platform_path(page_tab: 'board_cert'), method: :get, html: { class: 'form_search_with_icon' } do |f| %>
                  <%= hidden_field_tag :id, @provider_personal_information.provider_attest_id %>
                  <%= hidden_field_tag :page_tab, 'board_cert' %>
                  <div class="position-relative">
                    <%= f.text_field :specialty_specialty_name_cont, value: (params.dig(:q, :specialty_specialty_name_cont) || ''), placeholder: 'Search record', class: "form-control py-1" %>
                    <button type="submit" class="search-icon-btn">
                      <i class="bx bx-search"></i>
                    </button>
                  </div>
                <% end %>
              </div>
            </div>
            <% if @provider_specialties %>
                <div class="col-lg-12 page-applicable">
                    <div class="d-flex justify-content-between bg-medium-grey align-items-center py-2 mt-3">
                        <div class="page_info ms-3 text-black">
                        <%= page_entries_info @provider_specialties %>
                        </div>
                        <% if params[:per_page ].present? %>
                        <%= will_paginate @provider_specialties, :params =>  {per_page: @per_page }, renderer: WillPaginate::ActionView::BootstrapLinkRenderer %>
                        <% else %>
                        <%= will_paginate @provider_specialties, renderer: WillPaginate::ActionView::BootstrapLinkRenderer %>
                        <% end %>
                    </div>
                </div>
            <% end %>
            <table class="table table-bordered practice-table mt-3 page-applicable">
              <thead>
                <tr>
                  <th class="text-white" scope="col">Specialty</th>
                  <th class="text-white">Board Certification Status</th>
                  <th class="text-white">Issuing Board</th>
                  <th class="text-white">Expiration Date</th>
                  <th class="text-white">Status</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% if @provider_specialties.present? %>
                  <% @provider_specialties.each do |certification| %>
                    <tr>
                      <td>
                        <a href="<%= mhc_verification_platform_path(page_tab: 'board_cert_info', provider_specialty_id: certification.id) %>">
                          <%= certification.specialty_specialty_name %>
                        </a>
                      </td>
                      <td><%= certification&.board_certified_flag %></td> <!-- Board Certification Status -->
                      <td><%= certification&.specialty_board_name %></td> <!-- Issuing Board -->
                      <td>
                         <%= certification&.board_certification_expires_flag? ? "Does Not Expire" : (certification&.expiration_date.present? ? certification.expiration_date.strftime("%m-%d-%Y") : "") %>
                      <td><%= certification&.audit_status&.presence || "Not Requested" %></td>
                      <td>
                        <%= button_to mhc_provider_specialty_path(certification), method: :delete, data: { confirm: 'Are you sure you want to delete this record?' }, class: "btn btn-outline-danger btn-sm" do %>
                          <i class="bi bi-trash"></i>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                <% else %>
                  <tr>
                    <td colspan="5">No board certification records found.</td>
                  </tr>
                <% end %>
              </tbody>
            </table>
            <%= render "section_applicability_explanation",
           section_key: "board_cert" %>
        </div>
    </div>
<style>
  .search-icon-btn {
    position: absolute;
    top: 50%;
    right: 10px;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
  }

  .search-icon-btn i {
    font-size: 20px;
    color: #007bff; /* Blue color */
  }

  .search-icon-btn:hover i {
    color: #0056b3; /* Darker blue on hover */
  }
</style>