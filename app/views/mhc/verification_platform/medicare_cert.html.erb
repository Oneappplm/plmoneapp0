  <div class="enc-content">
        <div class="container">
            <%= render "top_nav_buttons"%>

            <div class="row mt-3">
                <div class="col-xl-12 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-3">
                        <h4 class="page-heading">Medicare Certificate</h4>
                        <button type="button" class="btn btn-primary py-1 px-5" id="prac-info-btn-edit">
                            Edit
                        </button>
                        <div class="d-flex align-items-center gap-3">
                            <button type="submit" class="btn btn-primary py-1" id="prac-info-btn-save">
                                Save Changes
                            </button>
                            <button type="button" class="btn btn-cancel" id="prac-info-btn-cancel">
                                Cancel
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <%= form_with model: @medicare_certificate,
              url: @medicare_certificate.persisted? ? mhc_medicare_certificate_path(@medicare_certificate) : mhc_medicare_certificates_path,
              method: @medicare_certificate.persisted? ? :patch : :post,
              local: true do |f| %>

              <%= f.hidden_field :provider_attest_id, value: params[:id] %>

              <div class="form-row row">
                <div class="col-xl-6">
                  <%= f.label :medicare_number, "Medicare Number" %>
                  <%= f.text_field :medicare_number, class: "form-control form-control-lg", placeholder: "Type here.." %>
                </div>
                <div class="col-xl-6">
                  <%= f.label :status, "Status" %>
                  <%= f.select :status, [["Active", "active"], ["Inactive", "inactive"]], { prompt: "Select Option" }, class: "form-select" %>
                </div>
              </div>

              <div class="form-row row">
                <div class="col-xl-6">
                  <%= f.label :source, "Source" %>
                  <%= f.select :source, [["CMS", "cms"], ["Other", "other"]], { prompt: "Select Option" }, class: "form-select" %>
                </div>
                <div class="col-xl-6">
                  <%= f.label :source_date, "Source Date" %>
                  <%= f.date_field :source_date, class: "form-control form-control-lg" %>
                </div>
              </div>

              <div class="form-row row">
                <div class="col-xl-6">
                  <%= f.label :verified_by, "Verified by" %>
                  <%= f.text_field :verified_by, class: "form-control form-control-lg", placeholder: "Type here.." %>
                </div>
                <div class="col-xl-6">
                  <%= f.label :verified_date, "Verified Date" %>
                  <%= f.date_field :verified_date, class: "form-control form-control-lg" %>
                </div>
              </div>

              <div class="form-row row mb-4">
                <div class="col-xl-12">
                  <%= f.label :review_criteria, "Review Criteria" %>
                  <%= f.text_area :review_criteria, class: "form-control form-control-lg", rows: 5, placeholder: "Type here.." %>
                </div>
              </div>

              <div class="form-row row">
                <div class="col-xl-12 text-end">
                  <%= f.submit "Save", class: "btn btn-primary" %>
                </div>
              </div>

            <% end %>
    </div>