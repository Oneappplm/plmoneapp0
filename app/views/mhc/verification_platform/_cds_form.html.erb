<%# app/views/mhc/providers/_cd_form.html.erb (adjust path to your folder) %>

<%= form_with model: [:mhc, provider_cd], id: "provider_cd_#{provider_cd.id || index}", local: true do |f| %>
  <%= f.hidden_field :caqh_provider_attest_id %>
  <%= f.hidden_field :provider_attest_id, value: params[:id] %>

  <h6 class="form-heading">CDS/DPS Number</h6>

  <div class="row">
    <div class="col-xl-5">
      <div class="form-row">
        <%= f.label :cds_number, "CDS/DPS Number:" %>
        <%= f.text_field :cds_number, placeholder: "Type here...", class: "form-control border border-dark" %>
      </div>

      <div class="form-row">
        <%= f.label :issue_date, "Issue Date:" %>
        <%= f.date_field :issue_date, class: "form-control" %>
      </div>

      <% yes_id = "cds-currently-yes-#{provider_cd.id || index}" %>
      <% no_id  = "cds-currently-no-#{provider_cd.id || index}" %>

      <div class="form-row d-flex align-items-center gap-3 mt-2">
        <%= f.label :currently_practicing_flag, "Do you currently practice under this number?" %>

        <div class="form-check d-flex align-items-center gap-2">
          <%= f.radio_button :currently_practicing_flag, true, id: yes_id, class: "form-check-input" %>
          <label class="form-check-label" for="<%= yes_id %>">Yes</label>
        </div>

        <div class="form-check d-flex align-items-center gap-2">
          <%= f.radio_button :currently_practicing_flag, false, id: no_id, class: "form-check-input" %>
          <label class="form-check-label" for="<%= no_id %>">No</label>
        </div>
      </div>
    </div>

    <div class="col-xl-5">
      <div class="form-row">
        <%= f.label :state, "State:" %>
        <%= f.collection_select :state, @states, :alpha_code, :name,
          { prompt: "State", selected: f.object&.state_record&.alpha_code },
          { class: "form-control" } %>
      </div>

      <div class="form-row">
        <%= f.label :expiration_date, "Expiration Date:" %>
        <%= f.date_field :expiration_date, class: "form-control" %>
      </div>

      <% tick_yes = "cds-tickler-yes-#{provider_cd.id || index}" %>
      <% tick_no  = "cds-tickler-no-#{provider_cd.id || index}" %>

      <div class="form-row d-flex align-items-center gap-3 mt-2">
        <%= f.label :show_on_tickler, "Show on Tickler?" %>

        <div class="form-check d-flex align-items-center gap-2">
          <%= f.radio_button :show_on_tickler, true, id: tick_yes, class: "form-check-input" %>
          <label class="form-check-label" for="<%= tick_yes %>">Yes</label>
        </div>

        <div class="form-check d-flex align-items-center gap-2">
          <%= f.radio_button :show_on_tickler, false, id: tick_no, class: "form-check-input" %>
          <label class="form-check-label" for="<%= tick_no %>">No</label>
        </div>
      </div>
    </div>
  </div>

  <hr class="mt-4">

  <div class="form-row d-flex justify-content-center mt-4">
    <input type="submit"
      value="<%= provider_cd.persisted? ? 'Update CDS/DPS Number' : 'Add CDS/DPS Number' %>"
      class="btn btn-primary py-1"
      form="<%= "provider_cd_#{provider_cd.id || index}" %>">
  </div>
<% end %>

<% if provider_cd.persisted? %>
  <div class="form-row d-flex justify-content-center mt-3">
    <%= button_to "Remove",
      mhc_provider_cd_path(provider_cd),
      method: :delete,
      class: "btn btn-danger py-1",
      data: { confirm: "Are you sure you want to delete this CDS/DPS Number?" } %>
  </div>
<% end %>
