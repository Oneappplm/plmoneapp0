    <% peer = provider_personal_information.provider_personal_information_peer_refs
              .where(audit_status: 'Quality Audited')            
              .joins(:rva_informations)
              .where.not(rva_informations: { audit_status: [nil], audit_comments: [nil, 'SkipRVA'] })
              .distinct %>
    <% if peer.any? %>   
      <div class="section-title">Peer Ref</div>
      <% peer.each do |ref| %>
        <% details = ref.rva_informations.where(audit_status: true)   
                        .where.not(audit_comments: [nil, 'SkipRVA'])
                        .order(created_at: :desc)
                        .first %>
