    <% training = provider_personal_information.provider_educations
                  .where(audit_status: 'Quality Audited')
                  .joins(:rva_informations)
                  .where.not(rva_informations: { audit_status: [nil], audit_comments: [nil, 'SkipRVA'] })
                  .distinct %>
    <% if training.any? %>
      <div class="section-title">Training:</div>
      <% training.each do |training| %>
        <% details = training.rva_informations.where(audit_status: true)   # Only RVAs with audit_status 'Quality Audited'
                        .where.not(audit_comments: [nil, 'SkipRVA'])
                        .order(created_at: :desc)
                        .first %>
        <% if details.present? %>
          <div class="section-content">
            <div class="row">
              <div class="col-6">
                <p><strong>Institution:</strong> <%= training.institution_name %></p>
                <p><strong>Type of Training:</strong> <%= training.training_area %></p>
                <p><strong>Dates Attended:</strong> <%= training.start_date&.strftime('%m/%d/%Y') %> - <%= training.end_date&.strftime('%m/%d/%Y') %></p>
                <p><strong>Source:</strong> <%= details.source_name.presence || 'N/A' %></p>
                <p><strong>Source Date:</strong> <%= details.source_date&.strftime('%m/%d/%Y') %></p>
                <p><strong>Review Criteria:</strong> <%= details.adverse_action %></p>
              </div>
              <div class="col-6">
                <p><strong>Specialty:</strong> <%= training.specialty_specialty_name %></p>
                <p><strong>Completed?:</strong> <%= training.program_completed_flag ? 'Yes' : 'No' %></p>
                <p><strong>Verifier:</strong> <%= current_user.full_name || 'N/A' %></p>
                <p><strong>Verification Date:</strong> <%= details.verification_date&.strftime('%m/%d/%Y') %></p>
              </div>
            </div>
            <div class="col-lg-12 border-top border-dark">
              <p class="mt-2"><strong>Comments:</strong> <%= details.verification_comments %></p>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>


  <!-- Education -->
  <div class="section mt-4">
    <% education = provider_personal_information.practice_information_educations
                  .where(verification_status: 'Quality Audited')
                  .joins(:rva_informations)
                  .where.not(rva_informations: { audit_status: [nil], audit_comments: [nil, 'SkipRVA'] })
                  .distinct %>
    <% if education.any? %>
      <div class="section-title">Education:</div>
      <% education.each do |education| %>
        <% details = education.rva_informations.where(audit_status: true)   # Only RVAs with audit_status 'Quality Audited'
                        .where.not(audit_comments: [nil, 'SkipRVA'])
                        .order(created_at: :desc)
                        .first %>
        <% if details.present? %>
          <div class="section-content">
            <div class="row">
              <div class="col-6">
                <p><strong>School/Program:</strong> <%= education.institution_name %></p>
                <p><strong>Date Attended From:</strong> <%= education.start_date&.strftime('%m/%d/%Y') %></p>
                <p><strong>Date Attended To:</strong> <%= education.end_date&.strftime('%m/%d/%Y') %></p>
                <p><strong>Source:</strong> <%= details.source_name.presence || 'N/A' %></p>
                <p><strong>Source Date:</strong> <%= details.source_date&.strftime('%m/%d/%Y') %></p>
                <p><strong>Review Criteria:</strong> <%= details.adverse_action %></p>
              </div>
              <div class="col-6">
                <p><strong>Degree/Certificate:</strong> <%= education.degree_degree_abbreviation %></p>
                <p><strong>Completed?:</strong> <%= education.program_completed_flag ? 'Yes' : 'No' %></p>
                <p><strong>Verifier:</strong> <%= current_user.full_name || 'N/A' %></p>
                <p><strong>Verification Date:</strong> <%= details.verification_date&.strftime('%m/%d/%Y') %></p>
              </div>
            </div>
            <div class="col-lg-12 border-top border-dark">
              <p class="mt-2"><strong>Comments:</strong> <%= details.verification_comments %></p>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>
