        <div class="section-title">Sanction SDN</div>
        <div class="section-content">
          <div class="row">
            <div class="col-6">
              <p><strong>Search Result:</strong> <%= ofac_details.search_result.presence || 'Not Available' %></p>
              <p><strong>Verified By:</strong> <%= current_user.full_name %></p>
            </div>
            <div class="col-6">
              <p><strong>Source Date:</strong> <%= ofac_details.source_date&.strftime('%m/%d/%Y') || 'Not Available' %></p>
              <p><strong>Verification Date:</strong> <%= ofac_details.verification_date&.strftime('%m/%d/%Y') || 'Not Available' %></p>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <div class="section mt-4">
