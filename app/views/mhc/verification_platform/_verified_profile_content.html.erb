<div class="container mt-5">
  <h2 class="text-center">Verified Profile</h2>
  <p class="text-center">Profile Generated Date: <%= Time.current.in_time_zone('Pacific Time (US & Canada)').strftime('%Y/%m/%d') %></p>
  <div class="table-responsive">
    <table class="table table-bordered">
      <thead>
        <tr>
          <th class="fw-bold text-dark">File Status:</th>
          <th class="fw-bold text-dark">File Issue Reason</th>
          <th class="fw-bold text-dark">File Review Reason</th>
        </tr>
      </thead>
      <tbody>
        <% provider_personal_information.provider_personal_information_app_trackings.each do |app_tracking| %>
          <tr>
            <td>
              <% if app_tracking.master_issues.compact_blank.any? || app_tracking.master_reviews.compact_blank.any? %>
                UNCLEAN
              <% else %>
                CLEAN
                <%#= app_tracking.file_status.present? ? app_tracking.file_status.upcase : "CLEAN" %>
              <% end %>
            </td>
                        
            <!-- File Issue Reason -->
            <td>
              <% if app_tracking.master_issues.compact_blank.any? %>
                <ul class="mb-0 ps-3">
                  <% app_tracking.master_issues.each do |issue| %>
                    <li><%= issue %></li>
                  <% end %>
                </ul>
              <% else %>
                None
              <% end %>
            </td>

            <!-- File Review Reason -->
            <td>
              <% if app_tracking.master_reviews.compact_blank.any? %>
                <ul class="mb-0 ps-3">
                  <% app_tracking.master_reviews.each do |review| %>
                    <li><%= review %></li>
                  <% end %>
                </ul>
              <% else %>
                None
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="section-title mt-4">Practitioner Name</div>
  <div class="table-responsive">
    <table class="table table-bordered">
      <thead>
        <tr>
          <th class="fw-bold text-dark">First Name</th>
          <th class="fw-bold text-dark">Middle Name</th>
          <th class="fw-bold text-dark">Last Name</th>
          <th class="fw-bold text-dark">Suffix</th>
          <th class="fw-bold text-dark">Type</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><%= provider_personal_information&.first_name %></td>
          <td><%= provider_personal_information&.middle_name %></td>
          <td><%= provider_personal_information&.last_name %></td>
          <td><%= provider_personal_information&.suffix %></td>
          <td><%= provider_personal_information&.practitioner_type%></td>
        </tr>
      </tbody>
    </table>
  </div>

  <%# other name section %>
  <div class="section-title mt-4">Practitioner Other Names</div>
    <div class="table-responsive mb-3">
      <table class="table table-bordered">
        <thead>
          <tr>
            <th class="fw-bold text-dark">First Name</th>
            <th class="fw-bold text-dark">Middle Name</th>
            <th class="fw-bold text-dark">Last Name</th>
            <th class="fw-bold text-dark">Suffix</th>
            <th class="fw-bold text-dark">Type</th>
          </tr>
        </thead>
        <tbody>
          <% if provider_personal_information.provider_attest&.provider_other_names.present? %>
            <% provider_personal_information.provider_attest.provider_other_names.each do |other_name| %>
              <tr>
                <td><%= other_name.first_name %></td>
                <td><%= other_name.middle_name %></td>
                <td><%= other_name.last_name %></td>
                <td><%= other_name.suffix %></td>
                <td><%= other_name.name_type %></td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="5" class="text-center text-muted">No other names found</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>


  <div class="table-responsive mb-3">
    <table class="table table-bordered">
      <tbody>
        <% if provider_personal_information.signature_date.present? %>
        <tr>
          <td class="fw-bold text-dark">Signature Date:</td>
          <td><%= provider_personal_information.signature_date.strftime('%m/%d/%Y') %></td>
        </tr>
        <% end %>

        <% if provider_personal_information.id.present? || provider_personal_information.caqh_provider_id.present? %>
        <tr>
          <td class="fw-bold text-dark">ClientID:</td>
          <td><%= provider_personal_information.id %></td>

          <td class="fw-bold text-dark">CAQH ID:</td>
          <td><%= provider_personal_information&.encompass_id_text || provider_personal_information.caqh_provider_id %></td>
        </tr>
        <% end %>

        <% if provider_personal_information.ssn.present? || provider_personal_information.birth_date.present? %>
        <tr>
          <td class="fw-bold text-dark">Social Security No.:</td>
          <td><%= provider_personal_information.ssn %></td>

          <td class="fw-bold text-dark">Date of Birth:</td>
          <td><%= provider_personal_information.birth_date&.strftime('%m/%d/%Y') %></td>
        </tr>
        <% end %>

        <% if provider_personal_information.npi.present? || provider_personal_information.birth_country_country_name.present? %>
        <tr>
          <td class="fw-bold text-dark">NPI:</td>
          <td><%= provider_personal_information.npi %></td>

          <td class="fw-bold text-dark">Country of Birth:</td>
          <td><%= provider_personal_information.birth_country_country_name %></td>
        </tr>
        <% end %>

        <% if provider_personal_information.citizenship_status.present? %>
        <tr>
          <td class="fw-bold text-dark">US Citizen:</td>
          <td><%= provider_personal_information.citizenship_status %></td>

          <td class="fw-bold text-dark">PMRS ID:</td>
          <td><%= provider_personal_information.citizenship_status %></td>
        </tr>
        <% end %>

        <% provider_personal_information.provider_personal_information_app_trackings.each do |app_tracking| %>
          <tr>
            <td class="fw-bold text-dark">Application Received Date:</td>
            <td><%= app_tracking.application_receipt_date&.strftime('%m/%d/%Y') %></td>

            <td class="fw-bold text-dark">Application Completed Date:</td>
            <td><%= app_tracking.application_receive_complete_date&.strftime('%m/%d/%Y') %></td>
          </tr>
          <tr>
            <td class="fw-bold text-dark">Verifications Complete Date:</td>
            <td><%= app_tracking.verification_complete_date&.strftime('%m/%d/%Y') %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="table-responsive">
    <table class="table table-bordered">
      <thead>
        <tr>
          <th class="fw-bold text-dark">Participating Specialties</th>
          <th class="fw-bold text-dark">Board Certification</th>
        </tr>
      </thead>
      <tbody>
        <% (1..5).each do |i| %>
          <% specialty_name = provider_personal_information.send("specialty_name_#{i}") %>
          <% next if specialty_name.blank? %>
          <% clean_name = specialty_name&.gsub(/\s*\(.*\)$/, '') %>
          <% specialty = provider_personal_information.provider_specialties.find_by(specialty_specialty_name: clean_name) if clean_name.present? %>
          <tr>
            <td><%= clean_name %></td>
            <td>
              <%= specialty&.board_certified_flag == "Certified" ? "Yes" : "No" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  
  <% primary_locations = provider_personal_information.practice_informations.primary %>
  <% additional_locations = provider_personal_information.practice_informations.additional %>

  <% if primary_locations.any? %>
    <div class="section-title mt-4">Primary Practice Location</div>
    <div class="table-responsive">
      <table class="table table-bordered">
        <tbody>
          <% primary_locations.each do |practice_info| %>
            <tr>
              <td>
                <strong class="text-dark">Facility Name:</strong>
                <%= [practice_info.practice_name].compact_blank.join(", ") %>
                <br>
                <strong class="text-dark">Practice Address:</strong>
                <%= [practice_info.complete_address].compact_blank.join(", ") %>
                <br>
                <strong class="text-dark">Practice State:</strong>
                <%= State.find_by(alpha_code: practice_info.state)&.name %>
              </td>
              <td>
                <strong class="text-dark">Practice Phone:</strong>
                <%= [practice_info.phone_number].compact_blank.join(", ") %><br>

                <strong class="text-dark">Practice Fax:</strong>
                <%= [practice_info.fax_number].compact_blank.join(", ") %><br>

                <strong class="text-dark">TIN Number:</strong>
                <%= [practice_info.federal_tax_id].compact_blank.join(", ") %>
              </td>
            </tr>
            <tr>
              <td class="fw-bold text-dark">TIN Name:</td>
              <td></td>
            </tr>
            <tr>
              <td class="fw-bold text-dark">Comments:</td>
              <td></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <% if additional_locations.any? %>
    <div class="section-title mt-4">Additional Practice Location(s)</div>
    <div class="table-responsive">
      <table class="table table-bordered">
        <tbody>
          <% additional_locations.each do |practice_info| %>
            <tr>
              <td>
                <strong class="text-dark">Facility Name:</strong>
                <%= [practice_info.practice_name].compact_blank.join(", ") %>
                <br>
                <strong class="text-dark">Practice Address:</strong>
                <%= [practice_info.complete_address].compact_blank.join(", ") %>
              </td>
              <td>
                <strong class="text-dark">Practice Phone:</strong>
                <%= [practice_info.phone_number].compact_blank.join(", ") %><br>

                <strong class="text-dark">Practice Fax:</strong>
                <%= [practice_info.fax_number].compact_blank.join(", ") %><br>

                <strong class="text-dark">TIN Number:</strong>
                <%= [practice_info.federal_tax_id].compact_blank.join(", ") %>
              </td>
            </tr>
            <tr>
              <td class="fw-bold text-dark">TIN Name:</td>
              <td></td>
            </tr>
            <tr>
              <td class="fw-bold text-dark">Comments:</td>
              <td></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>

<div class="container mt-4">
  <!-- Primary License Section -->
  <% primary_licenses = provider_personal_information.provider_licensures
                        .where(is_primary_license: true)
                        .where(audit_status: 'Quality Audited')
                        .joins(:rva_informations)
                        .where.not(rva_informations: { audit_status: [nil], audit_comments: [nil, 'SkipRVA'] })
                        .distinct %>
  <div class="section mt-4">
    <% if primary_licenses.any? %>
      <div class="section-title">Primary License:</div>
      <% primary_licenses.each do |licensure| %>

        <% details = licensure.rva_informations
          .where(audit_status: true)
          .where.not(audit_comments: [nil, 'SkipRVA'])
          .order(created_at: :desc)
          .first %>

        <% if details.present? %>
          <div class="section-content">
            <div class="row mt-1">
              <div class="col-6">
                <p><strong>License Number:</strong> <%= licensure.license_number %></p>
                <p><strong>Issue Date:</strong> <%= licensure.license_issue_date&.strftime('%m/%d/%Y') %></p>
                <p><strong>Status:</strong> <%= details.status.presence || 'N/A' %></p>
                <p><strong>Source:</strong> <%= details.source_name.presence || 'N/A' %></p>
                <p><strong>Source Date:</strong> <%= details.source_date&.strftime('%m/%d/%Y') %></p>
                <p><strong>Review Criteria:</strong> <%= details.adverse_action %></p>
              </div>
              <div class="col-6">
                <p><strong>License Type:</strong> <%= licensure.license_type %></p>
                <p><strong>State:</strong> <%= licensure.state.name %></p>
                <p><strong>Expiration Date:</strong> <%= licensure.license_expiration_date&.strftime('%m/%d/%Y') %></p>
                <p><strong>Verifier:</strong> <%= current_user.full_name || 'N/A' %></p>
                <p><strong>Verification Date:</strong> <%= details.verification_date&.strftime('%m/%d/%Y') %></p>
              </div>
            </div>
            <div class="row comments border-top border-dark">
              <div class="col-12 m-2">
                <p><strong>Comments:</strong> <%= details.verification_comments.presence || 'N/A' %></p>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <!-- Additional License Section -->
  <div class="section mt-4">
    <% additional_licenses = provider_personal_information.provider_licensures
                          .where(is_primary_license: false)
                          .where(audit_status: 'Quality Audited')
                          .joins(:rva_informations)
                          .where.not(rva_informations: { audit_status: [nil], audit_comments: [nil, 'SkipRVA'] })
                          .distinct %>
    <% if additional_licenses.any? %>                      
      <div class="section-title">Additional License(s):</div>
      <% additional_licenses.each do |licensure| %>

        <% details = licensure.rva_informations
          .where(audit_status: true)   # Only RVAs with audit_status 'Quality Audited'
                        .where.not(audit_comments: [nil, 'SkipRVA'])
                        .order(created_at: :desc)
                        .first %>

        <% if details.present? %>
          <div class="section-content">
            <div class="row mt-1">
              <div class="col-6">
                <p><strong>License Number:</strong> <%= licensure.license_number %></p>
                <p><strong>Issue Date:</strong> <%= licensure.license_issue_date&.strftime('%m/%d/%Y') %></p>
                <p><strong>Status:</strong> <%= details.status.presence || 'N/A' %></p>
                <p><strong>Source:</strong> <%= details.source_name.presence || 'N/A' %></p>
                <p><strong>Source Date:</strong> <%= details.source_date&.strftime('%m/%d/%Y') %></p>
                <p><strong>Review Criteria:</strong> <%= details.adverse_action %></p>
              </div>
              <div class="col-6">
                <p><strong>License Type:</strong> <%= licensure.license_type %></p>
                <p><strong>State:</strong> <%= licensure.state.name %></p>
                <p><strong>Expiration Date:</strong> <%= licensure.license_expiration_date&.strftime('%m/%d/%Y') %></p>
                <p><strong>Verifier:</strong> <%= current_user.full_name || 'N/A' %></p>
                <p><strong>Verification Date:</strong> <%= details.verification_date&.strftime('%m/%d/%Y') %></p>
              </div>
            </div>
            <div class="row comments border-top border-dark">
              <div class="col-12 m-2">
                <p><strong>Comments:</strong> <%= details.verification_comments.presence || 'N/A' %></p>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>  
  </div>
</div>

<!-- DEA -->
<div class="container mt-4">
  <div class="section mt-4">
    <% deas = provider_personal_information.provider_deas
            .joins(:rva_informations)
            .where.not(rva_informations: { audit_status: [nil], audit_comments: [nil, 'SkipRVA'] })
            .distinct %>
    <% if deas.any? %>        
      <div class="section-title">DEA</div>
      <div class="section-content">
        <% deas.each do |dea| %>
          <% dea_details = dea.rva_informations.where(audit_status: true)   # Only RVAs with audit_status 'Quality Audited'
                      .where.not(audit_comments: [nil, 'SkipRVA'])
                      .order(created_at: :desc)
                      .first %>
          <% if dea_details.present? %>
            <div class="row">
              <div class="col-6">
                <p><strong>DEA Number:</strong> <%= dea.dea_number %></p>
                <p><strong>Schedule:</strong> <%= dea.schedules_held.join(" ") %></p>
                <p><strong>Source:</strong> DEA</p>
                <p><strong>Source Date:</strong> <%= dea_details&.source_date&.strftime('%m/%d/%Y') %></p>
                <p><strong>Review Criteria:</strong> <%= dea_details&.adverse_action %></p>
              </div>
              <div class="col-6">
                <p><strong>Status:</strong> <%= dea_details&.status %></p>
                <p><strong>State:</strong> <%= dea.state %></p>
                <p><strong>Verifier:</strong> <%= dea_details&.verifier %></p>
                <p><strong>Expiration Date:</strong> <%= dea.expiration_date&.strftime('%m/%d/%Y') %></p>
                <p><strong>Verification Date:</strong> <%= dea_details&.verification_date&.strftime('%m/%d/%Y') %></p>
              </div>
              <div class="col-12">
                <p><strong>Comments:</strong> <%= dea_details&.verification_comments %></p>
              </div>
            </div>
            <hr>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>    
</div>

<!-- CDS -->
<div class="container mt-4">
  <div class="section mt-4">
    <% cds = provider_personal_information.provider_cds
            .joins(:rva_informations)
            .where.not(rva_informations: { audit_status: [nil], audit_comments: [nil, 'SkipRVA'] })
            .distinct %>
    <% if cds.any? %>        
      <div class="section-title">CDS</div>
      <div class="section-content">
        <% cds.each do |cds| %>
          <% cds_details = cds.rva_informations.where(audit_status: true)   # Only RVAs with audit_status 'Quality Audited'
                      .where.not(audit_comments: [nil, 'SkipRVA'])
                      .order(created_at: :desc)
                      .first %>
          <% if cds_details.present? %>
            <div class="row">
              <div class="col-6">
                <p><strong>cds Number:</strong> <%= cds.cds_number %></p>
                <p><strong>Source:</strong> CDS State Board</p>
                <p><strong>Source Date:</strong> <%= cds_details&.source_date&.strftime('%m/%d/%Y') %></p>
                <p><strong>Review Criteria:</strong> <%= cds_details&.adverse_action %></p>
              </div>
              <div class="col-6">
                <p><strong>State:</strong> <%= cds.state %></p>
                <p><strong>Expiration Date:</strong> <%= cds.expiration_date&.strftime('%m/%d/%Y') %></p>
                <p><strong>Verifier:</strong> <%= cds_details&.verifier %></p>
                <p><strong>Verification Date:</strong> <%= cds_details&.verification_date&.strftime('%m/%d/%Y') %></p>
              </div>
              <div class="col-12">
                <p><strong>Comments:</strong> <%= cds_details&.verification_comments %></p>
              </div>
            </div>
            <hr>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>    
</div>

<!-- NPDB -->
<div class="container mt-4">
  <div class="section mt-4">
    <% if npdb_details.present? %>
      <div class="section-title">NPDB</div>
      <div class="section-content">
        <div class="row">
          <div class="col-6">
            <p><strong>Source:</strong> <%= npdb_details.last&.source_name || "NA" %></p>
            <p><strong>Source Date:</strong> <%= npdb_details.last&.source_date&.strftime("%m/%d/%Y") || "NA"  %></p>
            <p><strong>Review Criteria:</strong> <%= npdb_details.last&.adverse_action  %></p>
          </div>
          <div class="col-6">
            <p><strong>Verifier:</strong> <%= npdb_details.last&.verifier || "NA"  %></p>
            <p><strong>Verification Date:</strong> <%= npdb_details.last&.verification_date&.strftime("%m/%d/%Y") || "NA"  %></p>
          </div>
        </div>
        <div class="row comments">
          <div class="col-12">
            <p><strong>Comments:</strong>  <%= npdb_details.last&.verification_comments %></p>
          </div>
        </div>
      </div>
    <% end %>  
   </div>
</div>

<div class="container mt-4">
  <!-- SAM Exclusions -->
  <% if provider_personal_information.provider_personal_information_sam_records.present? %>
    <div class="section">
      <div class="section-title">SAM Exclusions:</div>
      <div class="section-content">
        <% provider_personal_information.provider_personal_information_sam_records.each do |sam_record| %>
          <div class="row">
              <div class="col-6 mb-3">
                <p><strong>Full Name:</strong> 
                  <%= [sam_record.first_name, sam_record.middle_name, sam_record.last_name].compact_blank.join(" ") %>
                </p>
                <% if sam_record.provider_personal_information_sam_rva_records.any? %>
                  <% sam_record.provider_personal_information_sam_rva_records.each do |rva| %>
                    <p><strong>Search Results:</strong> 
                      <%= verification_search_results.to_h.key(rva.search_result) || "None" %>
                    </p>
                    <p><strong>Finding:</strong> <%= verification_search_results.to_h.key(rva.search_result) || "None" %></p>
                    <p><strong>Verified By:</strong> SAM</p>
                    <p><strong>Verifier:</strong> <%= user.full_name %></p>
                    <p><strong>Comments:</strong> <%= rva.comments || "None" %></p>
                    <hr>
                  <% end %>
                <% end %>
              </div>

              <div class="col-6 mb-3">  
                <% if sam_record.provider_personal_information_sam_rva_records.any? %>
                  <% sam_record.provider_personal_information_sam_rva_records.each do |rva| %>
                    <div class="mt-5 mb-5">
                      <p><strong>Source Date:</strong> <%= rva.source_date&.strftime('%b %d, %Y') || "None" %></p>
                      <p><strong>Verification Date:</strong> <%= rva.verification_date&.strftime('%b %d, %Y') || "None" %></p>
                    </div>
                  <% end %>
                <% end %>
              </div>
          </div>
         <% end %>
      </div>
    </div>
  <% end %>

  <!-- NPI -->
  <% if provider_personal_information&.npi.present? %>
    <div class="section mt-4">
      <div class="section-title">NPI</div>
      <div class="section-content">
        <div class="row">
          <div class="col-6">
            <p><strong>NPI Number:</strong><%= provider_personal_information&.npi %></p>
            <p><strong>Search Results:</strong> <%= provider_personal_information&.npi_verification_status %></p>
            <p><strong>Verified By:</strong> NPI</p>
            <p><strong>Verifier:</strong> <%= user.full_name %></p>
          </div>
         <div class="col-6">
            <p>
              <strong>Source Date:</strong>
              <%= provider_personal_information
                    &.updated_at
                    &.in_time_zone('Pacific Time (US & Canada)')
                    &.strftime("%m/%d/%Y") %>
            </p>

            <p>
              <strong>Verification Date:</strong>
              <%= provider_personal_information
                    &.updated_at
                    &.in_time_zone('Pacific Time (US & Canada)')
                    &.strftime("%m/%d/%Y") %>
            </p>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Medicares -->
  <% provider_medicares = provider_personal_information.provider_medicares.order(:id) %>

    <% if provider_medicares.present? %>
      <div class="section mt-4">
        <div class="section-title">Medicare Opt Out</div>
        <div class="section-content">
          <% provider_medicares.each do |medicare| %>
            <div class="row mb-3">
              <div class="col-6">
                <%# <p><strong>Medicare PIN:</strong> <%#= medicare.medicare_number.presence || 'Not Available'</p> %>
                <p><strong>State:</strong> <%= medicare.state.presence || 'Not Available' %></p>
                <p><strong>On Opt Out List:</strong> <%= medicare.medicare_opt_out? ? 'Yes' : 'No' %></p>
                <p><strong>End Date:</strong> <%= medicare.effective_date&.strftime('%m/%d/%Y') || 'Not Available' %></p>
              </div>

              <div class="col-6">
                <p><strong>Verified By:</strong> <%= current_user.full_name %></p>
                <p><strong>Source Date:</strong> <%= medicare.issue_date&.strftime('%m/%d/%Y') || 'Not Available' %></p>
                <p><strong>Verification Date:</strong> <%= medicare.updated_at&.strftime('%m/%d/%Y') || 'Not Available' %></p>
                <p><strong>Verification Source:</strong> CMS Administrator</p>
              </div>
            </div>

            <% unless medicare == provider_medicares.last %>
