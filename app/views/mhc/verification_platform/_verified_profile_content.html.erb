              <p><strong>Search Result:</strong> <%= omig_details.search_result.presence || 'Not Available' %></p>
              <p><strong>Verified By:</strong> <%= current_user.full_name %></p>
            </div>
            <div class="col-6">
              <p><strong>Source Date:</strong> <%= omig_details.source_date&.strftime('%m/%d/%Y') || 'Not Available' %></p>
              <p><strong>Verification Date:</strong> <%= omig_details.verification_date&.strftime('%m/%d/%Y') || 'Not Available' %></p>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <% if opmc_details.present? %>
