              <p><strong>Search Result:</strong> <%= opmc_details.search_result.presence || 'Not Available' %></p>
              <p><strong>Verified By:</strong> <%= current_user.full_name %></p>
            </div>
            <div class="col-6">
              <p><strong>Source Date:</strong> <%= opmc_details.source_date&.strftime('%m/%d/%Y') || 'Not Available' %></p>
              <p><strong>Verification Date:</strong> <%= opmc_details.verification_date&.strftime('%m/%d/%Y') || 'Not Available' %></p>
