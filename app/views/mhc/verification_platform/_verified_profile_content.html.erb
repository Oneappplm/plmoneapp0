          <div class="section-content">
            <div class="row">
              <div class="col-6">
                <p><strong>Peer:</strong> <%= ref.practitioner_name %></p>
                <p><strong>Verified By:</strong> Peer </p>
                <p><strong>Verifier:</strong> <%= current_user.full_name || 'N/A' %></p>
                <p><strong>In Good Standing?:</strong> <%= details&.in_good_standing ? "Yes" : "No" %></p>
                <p><strong>Comments:</strong> <%= details.comments %></p>
                <p><strong>Adverse Action:</strong> <%= details.adverse_action %></p>
                <p><strong>Adverse Action Comments:</strong> <%= details.adverse_action_comments %></p>
              </div>
              <div class="col-6">
                <p><strong>Specialty:</strong> <%= ref.specialty %></p>
                <p><strong>Board Certified?:</strong> 
                  <%= ref&.is_board_certified ? "Yes" : "No" %>
                </p>
                <p><strong>Source Date:</strong> <%= details.source_date&.strftime('%m/%d/%Y') %></p>
                <p><strong>Verification Date:</strong> <%= details.verification_date&.strftime('%m/%d/%Y') %></p>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>
