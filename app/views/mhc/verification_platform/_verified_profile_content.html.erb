  <!-- Board Certification -->
  <div class="section mt-4">
    <% board = provider_personal_information.provider_specialties
              .where(audit_status: 'Quality Audited')             # Coverage audit_status must be 'Quality Audited'
              .joins(:rva_informations)
              .where.not(rva_informations: { audit_status: [nil], audit_comments: [nil, 'SkipRVA'] })
              .distinct %>
    <% if board.any? %>   
      <div class="section-title">Board Certification</div>
      <% board.each do |certification| %>
        <% details = certification.rva_informations.where(audit_status: true)   # Only RVAs with audit_status 'Quality Audited'
                        .where.not(audit_comments: [nil, 'SkipRVA'])
                        .order(created_at: :desc)
                        .first %>
        <% if details.present? %>
          <div class="section-content">
            <div class="row">
              <div class="col-6">
                <p><strong>Specialty:</strong> <%= certification.specialty_specialty_name %></p>
                <p><strong>Issuing Board:</strong> <%= certification.specialty_board_name %></p>
                <p><strong>Initial Certification Date:</strong> <%= certification.initial_certification_date&.strftime('%m/%d/%Y') %></p>
                <p><strong>Re-Certification Date:</strong> <%= certification.recertification_date&.strftime('%m/%d/%Y') %></p>
                <p><strong>Source:</strong> <%= details.source_name.presence || 'N/A' %></p>
                <p><strong>Source Date:</strong> <%= details.source_date&.strftime('%m/%d/%Y') %></p>
                <p><strong>Review Criteria:</strong> <%= details.adverse_action %></p>
              </div>
              <div class="col-6">
                <p><strong>Board Status:</strong> <%= certification.board_certified_flag %></p>
                <p><strong>Expiration Date:</strong> 
                  <%= certification&.board_certification_expires_flag? ? "Does Not Expire" : (certification&.expiration_date.present? ? certification.expiration_date.strftime("%m/%d/%Y") : "") %>
                </p>
                <p><strong>Verifier:</strong> <%= current_user.full_name || 'N/A' %></p>
                <p><strong>Verification Date:</strong> <%= details.verification_date&.strftime('%m/%d/%Y') %></p>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <!-- Certification -->
  <div class="section mt-4">
    <% certification = provider_personal_information.certifications
              .where(audit_status: 'Quality Audited')             # Coverage audit_status must be 'Quality Audited'
              .joins(:rva_informations)
              .where.not(rva_informations: { audit_status: [nil], audit_comments: [nil, 'SkipRVA'] })
              .distinct %>
    <% if certification.any? %>   
      <div class="section-title">AHP Certification</div>
      <% certification.each do |certification| %>
        <% details = certification.rva_informations.where(audit_status: true)   # Only RVAs with audit_status 'Quality Audited'
                        .where.not(audit_comments: [nil, 'SkipRVA'])
                        .order(created_at: :desc)
                        .first %>
        <% if details.present? %>
          <div class="section-content">
            <div class="row">
              <div class="col-6">
                <p><strong>Type:</strong> <%= certification.certification_type&.titleize.presence || 'N/A' %></p>
                <p><strong>Issuing Agency:</strong> <%= certification.issuing_agency&.titleize.presence || 'N/A' %></p>
                <p><strong>Certification Status:</strong> <%= certification.certification_status&.titleize.presence || 'N/A' %></p>
                <p><strong>Verified By:</strong> <%= details&.source_name.presence || 'N/A' %></p>
                <p><strong>Verifier:</strong> <%= current_user&.full_name.presence || 'N/A' %></p>
                <p><strong>Comments:</strong> <%= certification.comments.presence || 'N/A' %></p>
              </div>

              <div class="col-6">
                <p><strong>Certification Number:</strong> <%= certification.certification_number.presence || 'N/A' %></p>
                <p><strong>Initial Certification Date:</strong> <%= certification.initial_certification_date&.strftime('%m/%d/%Y') || 'N/A' %></p>
                <p><strong>Expiration Date:</strong> <%= certification.certification_expiration_date&.strftime('%m/%d/%Y') || 'N/A' %></p>
                <p><strong>Source Date:</strong> <%= details&.source_date&.strftime('%m/%d/%Y') || 'N/A' %></p>
                <p><strong>Verification Date:</strong> <%= details&.verification_date&.strftime('%m/%d/%Y') || 'N/A' %></p>
                <p><strong>Adverse Action:</strong> <%= details&.adverse_action.presence || 'N/A' %></p>
                <p><strong>Adverse Action Comments:</strong> <%= details&.adverse_action_comments.presence || 'N/A' %></p>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>
