<div class="container mt-4">
  <h2>Upload Weekly DEA File</h2>

  <div class="card mt-4">
    <div class="card-body">
      <%= form_with url: mhc_dea_files_path, multipart: true, local: true do |f| %>
        <div class="mb-3">
          <label class="form-label">DEA File</label>
          <%= file_field_tag :dea_file, class: "form-control" %>
        </div>

        <%= f.submit "Upload & Import", class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>

  <% if params[:job_id].present? %>
    <div id="import-progress-container" class="mt-5">

      <h5 class="fw-bold">DEA File Import Progress</h5>

      <div class="progress" style="height: 20px; border-radius: 15px; overflow: hidden;">
        <div 
          id="import-progress-bar"
          class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
          role="progressbar"
          style="width: 0%; font-weight:600; font-size:14px; height: 20px; background: linear-gradient(90deg, #007bff, #4dabf7, #28a745);"
          aria-valuenow="0"
          aria-valuemin="0"
          aria-valuemax="100"
        >
          0%
        </div>
      </div>

      <p id="import-status" class="mt-2 text-muted">Starting...</p>

    </div>
  <% end %>
</div>


<script>
  document.addEventListener("DOMContentLoaded", function() {
    const jobId = "<%= params[:job_id] %>";
    if (!jobId) return;

    const bar = document.getElementById("import-progress-bar");
    const statusText = document.getElementById("import-status");

    function checkProgress() {
      fetch(`/mhc/dea_import_progress/${jobId}`)
        .then(response => response.json())
        .then(data => {

          // If Redis doesn't have any entry yet
          if (data.status === "not_found") {
            statusText.innerHTML =
              `<span class="text-warning">Waiting for file import to start...</span>`;
            return;
          }

          // SIDEKIQ STOPPED
          if (data.status === "stopped") {
            bar.style.width = "100%";
            bar.classList.remove("bg-primary");
            bar.classList.add("bg-danger");
            bar.innerText = "Stopped";
            statusText.innerHTML =
              `<span class="text-danger fw-bold">❌ Background import stopped!.</span>`;
            clearInterval(timer);
            return;
          }

          // Normal progress update
          const processed = data.processed || 0;
          const total = data.total || 1;
          let percentage = Math.round((processed / total) * 100);

          bar.style.width = percentage + "%";
          bar.innerText = percentage + "%";
          statusText.innerText = `${processed} / ${total} records imported`;

          // Finished
          if (data.status === "finished") {
            bar.classList.remove("progress-bar-animated");
            statusText.innerHTML =
              `<span class="text-success fw-bold">✔ Import Completed</span>`;
            clearInterval(timer);

            // Optional: auto-refresh page after 2 seconds
            setTimeout(() => window.location.reload(), 2000);
          }
        });
    }


    const timer = setInterval(checkProgress, 1000);
  });
</script>
