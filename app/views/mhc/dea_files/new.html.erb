<div class="container mt-4">
  <h2>Upload Weekly DEA File</h2>

  <div class="card mt-4">
    <div class="card-body">
      <%= form_with url: mhc_dea_files_path, multipart: true, local: true do |f| %>
        <div class="mb-3">
          <label class="form-label">DEA File</label>
          <%= file_field_tag :dea_file, class: "form-control" %>
        </div>

        <%= f.submit "Upload & Import", class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>

  <% if params[:job_id].present? %>
    <div id="import-progress-container" class="mt-5">

      <h5 class="fw-bold">DEA File Import Progress</h5>

      <div class="progress" style="height: 20px; border-radius: 15px; overflow: hidden;">
        <div 
          id="import-progress-bar"
          class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
          role="progressbar"
          style="width: 0%; font-weight:600; font-size:14px; height: 20px; background: linear-gradient(90deg, #007bff, #4dabf7, #28a745);"
          aria-valuenow="0"
          aria-valuemin="0"
          aria-valuemax="100"
        >
          0%
        </div>
      </div>

      <p id="import-status" class="mt-2 text-muted">Starting...</p>

    </div>
  <% end %>
</div>


<script>
document.addEventListener("DOMContentLoaded", function() {
  const jobId = "<%= params[:job_id] %>";
  if (!jobId) return;

  const bar = document.getElementById("import-progress-bar");
  const statusText = document.getElementById("import-status");

  function fmt(n) {
    try { return Number(n).toLocaleString(); } catch(e) { return String(n); }
  }

  function setBar(pct, label) {
    bar.style.width = pct + "%";
    bar.innerText = label;
    bar.setAttribute("aria-valuenow", String(pct));
  }

  function checkProgress() {
    fetch(`/mhc/dea_import_progress/${jobId}`)
      .then(r => r.json())
      .then(data => {
        const status = data.status;

        const processed = parseInt(data.processed || 0, 10);
        const total = parseInt(data.total || 0, 10);

        const bytesRead = parseInt(data.bytes_read || 0, 10);
        const totalBytes = parseInt(data.total_bytes || 0, 10);

        // queued/not found
        if (status === "not_found" || status === "queued" || status === "starting") {
          setBar(5, "Waiting...");
          statusText.innerHTML = `<span class="text-warning">Waiting for import...</span>`;
          return;
        }

        // stopped
        if (status === "stopped") {
          bar.classList.remove("bg-primary");
          bar.classList.add("bg-danger");
          setBar(100, "Stopped");
          statusText.innerHTML = `<span class="text-danger fw-bold">❌ Import stopped (no updates)</span>`;
          clearInterval(timer);
          return;
        }

        // failed
        if (status === "failed") {
          bar.classList.remove("bg-primary");
          bar.classList.add("bg-danger");
          setBar(100, "Failed");
          statusText.innerHTML = `<span class="text-danger fw-bold">❌ ${data.error || "Import failed"}</span>`;
          clearInterval(timer);
          return;
        }

        // progress percent (prefer bytes)
        let pct = 0;
        if (totalBytes > 0 && bytesRead > 0) {
          pct = Math.min(100, Math.round((bytesRead / totalBytes) * 100));
        } else if (total > 0) {
          pct = Math.min(100, Math.round((processed / total) * 100));
        } else {
          pct = 100; // unknown total -> show "Working..."
        }

        // label
        if (totalBytes > 0 && bytesRead > 0) {
          setBar(pct, pct + "%");
        } else if (total > 0) {
          setBar(pct, pct + "%");
        } else {
          setBar(100, "Working...");
        }

        // Estimate total lines from bytes (converges as it runs)
        let estimatedTotal = 0;
        if (total > 0) {
          estimatedTotal = total;
        } else if (bytesRead > 0 && totalBytes > 0) {
          estimatedTotal = Math.round(processed * (totalBytes / bytesRead));
        }

        if (estimatedTotal > 0) {
          statusText.innerText = `${fmt(processed)} / ${fmt(estimatedTotal)} records imported`;
        } else {
          statusText.innerText = `${fmt(processed)} records imported`;
        }

        // finished
        if (status === "finished") {
          bar.classList.remove("progress-bar-animated");
          bar.classList.remove("progress-bar-striped");
          setBar(100, "100%");
          statusText.innerHTML = `<span class="text-success fw-bold">✔ Import Completed</span>`;
          clearInterval(timer);
        }
      })
      .catch(() => {
        statusText.innerHTML = `<span class="text-danger">Progress check failed. Please refresh.</span>`;
      });
  }

  const timer = setInterval(checkProgress, 5000);
  checkProgress();
});
</script>


