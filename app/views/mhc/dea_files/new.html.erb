<div class="container mt-4">
  <h2>Upload Weekly DEA File</h2>

  <div class="card mt-4">
    <div class="card-body">
      <%= form_with url: mhc_dea_files_path, multipart: true, local: true do |f| %>
        <div class="mb-3">
          <label class="form-label">DEA File</label>
          <%= file_field_tag :dea_file, class: "form-control" %>
        </div>

        <%= f.submit "Upload & Import", class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>

  <% if params[:job_id].present? %>
    <div id="import-progress-container" class="mt-5">
      <h5 class="fw-bold">DEA File Import Progress</h5>

      <div class="progress" style="height: 20px; border-radius: 15px; overflow: hidden;">
        <div
          id="import-progress-bar"
          class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
          role="progressbar"
          style="width: 0%; font-weight:600; font-size:14px; height: 20px;"
        >
          0%
        </div>
      </div>

      <p id="import-status" class="mt-2 text-muted">Starting...</p>
    </div>
  <% end %>
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
  const jobId = "<%= params[:job_id] %>";
  if (!jobId) return;

  const bar = document.getElementById("import-progress-bar");
  const statusText = document.getElementById("import-status");

  function checkProgress() {
    fetch(`/mhc/dea_import_progress/${jobId}`)
      .then(r => r.json())
      .then(data => {
        const status = data.status;
        const processed = parseInt(data.processed || 0, 10);
        const total = parseInt(data.total || 0, 10);

        if (status === "not_found" || status === "queued") {
          bar.style.width = "5%";
          bar.innerText = "Waiting...";
          statusText.innerHTML = `<span class="text-warning">Waiting for import to start...</span>`;
          return;
        }

        if (status === "failed") {
          bar.style.width = "100%";
          bar.classList.remove("bg-primary");
          bar.classList.add("bg-danger");
          bar.innerText = "Failed";
          statusText.innerHTML = `<span class="text-danger fw-bold">❌ ${data.error || "Import failed"}</span>`;
          clearInterval(timer);
          return;
        }

        if (status === "stopped") {
          bar.style.width = "100%";
          bar.classList.remove("bg-primary");
          bar.classList.add("bg-danger");
          bar.innerText = "Stopped";
          statusText.innerHTML = `<span class="text-danger fw-bold">❌ Import stopped</span>`;
          clearInterval(timer);
          return;
        }

        if (total > 0) {
          const pct = Math.min(100, Math.round((processed / total) * 100));
          bar.style.width = pct + "%";
          bar.innerText = pct + "%";
          statusText.innerText = `${processed.toLocaleString()} / ${total.toLocaleString()} records imported`;
        } else {
          bar.style.width = "100%";
          bar.innerText = "Working...";
          statusText.innerText = `${processed.toLocaleString()} records imported (counting total...)`;
        }

        if (status === "finished") {
          bar.style.width = "100%";
          bar.innerText = "100%";
          bar.classList.remove("progress-bar-animated");
          statusText.innerHTML = `<span class="text-success fw-bold">✔ Import Completed</span>`;
          clearInterval(timer);
        }
      });
  }

  const timer = setInterval(checkProgress, 3000);
  checkProgress();
});
</script>

