<div class="container mt-4">
  <h2>Upload Weekly DEA File</h2>

  <div class="card mt-4">
    <div class="card-body">
      <%= form_with url: mhc_dea_files_path, id: "dea-upload-form", multipart: true, local: true do |f| %>
        <div class="mb-3">
          <label class="form-label">DEA File</label>
          <%= file_field_tag :dea_file, class: "form-control", id: "dea_file_input" %>
        </div>

        <%= f.submit "Upload & Import", class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>

  <% if params[:job_id].present? %>
    <div id="import-progress-container" class="mt-5">
      <h5 class="fw-bold">DEA File Import Progress</h5>

      <div class="progress" style="height: 20px; border-radius: 15px; overflow: hidden;">
        <div
          id="import-progress-bar"
          class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
          role="progressbar"
          style="width: 0%; font-weight:600; font-size:14px; height: 20px;"
        >
          0%
        </div>
      </div>

      <p id="import-status" class="mt-2 text-muted">Starting...</p>
      <p id="import-bytes" class="text-muted small"></p>
    </div>
  <% end %>
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
  const jobId = "<%= params[:job_id] %>";
  if (!jobId) return;

  const bar = document.getElementById("import-progress-bar");
  const statusText = document.getElementById("import-status");

  function fmtMB(bytes) {
    return (bytes / 1024 / 1024).toFixed(1) + " MB";
  }

  async function checkProgress() {
    const r = await fetch(`/mhc/dea_import_progress/${jobId}`);
    const data = await r.json();

    const status = data.status;
    const processed = parseInt(data.processed || 0, 10);
    const total = parseInt(data.total || 0, 10);
    const bytesRead = parseInt(data.bytes_read || 0, 10);
    const totalBytes = parseInt(data.total_bytes || 0, 10);

    if (status === "not_found" || status === "queued") {
      bar.style.width = "5%";
      bar.innerText = "Queued...";
      statusText.innerHTML = `<span class="text-warning">Waiting for worker...</span>`;
      return;
    }

    if (status === "failed") {
      bar.style.width = "100%";
      bar.classList.add("bg-danger");
      bar.innerText = "Failed";
      statusText.innerHTML = `<span class="text-danger fw-bold">❌ ${data.error || "Import failed"}</span>`;
      clearInterval(timer);
      return;
    }

    // percent by bytes (works immediately for huge file)
    let pct = 0;
    if (totalBytes > 0) pct = Math.min(100, Math.round((bytesRead / totalBytes) * 100));

    bar.style.width = pct + "%";
    bar.innerText = pct + "%";

    let lineText = total > 0
      ? `${processed.toLocaleString()} / ${total.toLocaleString()} records`
      : `${processed.toLocaleString()} records (estimating total...)`;

    let bytesText = totalBytes > 0
      ? `${fmtMB(bytesRead)} / ${fmtMB(totalBytes)}`
      : `${fmtMB(bytesRead)}`;

    statusText.innerText = `${lineText} • ${bytesText}`;

    if (status === "finished") {
      bar.style.width = "100%";
      bar.innerText = "100%";
      bar.classList.remove("progress-bar-animated");
      statusText.innerHTML = `<span class="text-success fw-bold">✔ Import Completed</span>`;
      clearInterval(timer);
    }
  }

  const timer = setInterval(checkProgress, 3000);
  checkProgress();
});
</script>





