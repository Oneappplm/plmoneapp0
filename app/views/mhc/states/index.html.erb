<!-- app/views/admin/states/index.html.erb -->
<div class="container mt-3">
  <h1>State License URL's</h1>

  <div class="row mb-3">
    <div class="col-md-6">
      <%= form_with url: mhc_states_path, method: :get, local: true do %>
        <div class="input-group">
          <%= text_field_tag :query,
                params[:query],
                class: "form-control",
                placeholder: "Search by state name or code (e.g. Florida / FL)",
                autocomplete: "off"
                 %>

          <button class="btn btn-primary" type="submit">
            Search
          </button>

          <% if params[:query].present? %>
            <%= link_to "Clear",
                  mhc_states_path,
                  class: "btn btn-outline-secondary" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>


  <table class="table table-bordered">
    <thead>
      <tr>
        <th class="text-white">State</th>
        <th class="text-white">Code</th>
        <th class="text-white">Search URL</th>
        <th class="text-white">Action</th>
      </tr>
    </thead>
    <tbody>
      <% @states.each do |state| %>
        <tr>
          <td><%= state.name %></td>
          <td><%= state.alpha_code %></td>
          <td>
            <%= link_to state.license_search_url, target: "_blank" do %>
              <%= truncate(state.license_search_url, length: 50) %>
            <% end %>
          </td>
          <td>
            <%= link_to "Edit", edit_mhc_state_path(state), class: 'btn btn-outline-primary btn-sm' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @states %>
    <div class="col-lg-12 mt-3 mb-3">
      <div class="d-flex justify-content-between bg-medium-grey rounded align-items-center py-3">
        <div class="page_info ms-3 text-black">
          <%= page_entries_info @states %>
        </div>
        <% if params[:per_page ].present? %>
          <%= will_paginate @states, :params =>  {per_page: @per_page }, renderer: WillPaginate::ActionView::BootstrapLinkRenderer %>
        <% else %>
          <%= will_paginate @states, renderer: WillPaginate::ActionView::BootstrapLinkRenderer %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
