<div class="facility-summary">

  <div class="facility-summary-header">
    <div>
      <h3>Provider Facility Summary</h3>

      <% practice = @provider.practice_informations.first %>

      <p>
        <strong>Facility:</strong>
        <%= practice&.practice_name.presence || "N/A" %>
      </p>
    </div>
  </div>


  <!-- ====================================================== -->
  <!-- PROVIDER TYPE -->
  <!-- ====================================================== -->

  <div class="facility-summary-section">
    <div class="facility-summary-title">
      Provider Type / Pre-Application
    </div>

    <fieldset disabled>
      <%= render "provider_facilities/steps/provider_type" %>
    </fieldset>
  </div>


  <!-- ====================================================== -->
  <!-- CORPORATE INFORMATION -->
  <!-- ====================================================== -->

  <div class="facility-summary-section">
    <div class="facility-summary-title">
      Corporate Information
    </div>

    <fieldset disabled>
      <%= render "provider_facilities/steps/corporate_information" %>
    </fieldset>
  </div>


  <!-- ====================================================== -->
  <!-- PRIMARY OFFICE -->
  <!-- ====================================================== -->

  <div class="facility-summary-section">
    <div class="facility-summary-title">
      Primary Office and Contact Information
    </div>

    <fieldset disabled>
      <%= render "provider_facilities/steps/primary_office_contact" %>
    </fieldset>
  </div>


  <!-- ====================================================== -->
  <!-- MAILING -->
  <!-- ====================================================== -->

  <div class="facility-summary-section">
    <div class="facility-summary-title">
      Mailing Address
    </div>

    <fieldset disabled>
      <%= render "provider_facilities/steps/mailing_address" %>
    </fieldset>
  </div>


  <!-- ====================================================== -->
  <!-- LICENSURE -->
  <!-- ====================================================== -->

  <div class="facility-summary-section">
    <div class="facility-summary-title">
      Licensure / Certification
    </div>

    <fieldset disabled>
      <%= render "provider_facilities/steps/licensure_certification" %>
    </fieldset>
  </div>


  <!-- ====================================================== -->
  <!-- ACCREDITATION -->
  <!-- ====================================================== -->

  <div class="facility-summary-section">
    <div class="facility-summary-title">
      Accreditation
    </div>

    <fieldset disabled>
      <%= render "provider_facilities/steps/accreditation" %>
    </fieldset>
  </div>


  <!-- ====================================================== -->
  <!-- INSURANCE -->
  <!-- ====================================================== -->

  <div class="facility-summary-section">
    <div class="facility-summary-title">
      Insurance
    </div>

    <fieldset disabled>
      <%= render "provider_facilities/steps/insurance" %>
    </fieldset>
  </div>


  <!-- ====================================================== -->
  <!-- STAFFING -->
  <!-- ====================================================== -->

  <div class="facility-summary-section">
    <div class="facility-summary-title">
      Staffing
    </div>

    <fieldset disabled>
      <%= render "provider_facilities/steps/staffing" %>
    </fieldset>
  </div>


  <!-- ====================================================== -->
  <!-- FACILITY PROFILE -->
  <!-- ====================================================== -->

  <div class="facility-summary-section">
    <div class="facility-summary-title">
      Facility Profile
    </div>

    <%= render "provider_facilities/facility_profile_summary" %>
  </div>


  <!-- ====================================================== -->
  <!-- ATTESTATION -->
  <!-- ====================================================== -->

  <div class="facility-summary-section">
    <div class="facility-summary-title">
      Attestation
    </div>

    <fieldset disabled>
      <%= render "provider_facilities/steps/attestation" %>
    </fieldset>
  </div>


  <!-- ====================================================== -->
  <!-- DOCUMENTS -->
  <!-- ====================================================== -->

  <div class="facility-summary-section">
    <div class="facility-summary-title">
      Uploaded Documents
    </div>

    <fieldset disabled>
      <%= render "provider_facilities/steps/upload_documents" %>
    </fieldset>
  </div>
</div>
<style>
.facility-summary {
  width: 100%;
}

.facility-summary-header {
  margin-bottom: 25px;
}

.facility-summary-header h3 {
  margin-bottom: 8px;
  font-size: 22px;
  font-weight: 700;
}

.facility-summary-section {
  margin-bottom: 24px;
  border: 1px solid #dce2e8;
  border-radius: 6px;
  background: #ffffff;
  overflow: hidden;
}

.facility-summary-title {
  padding: 14px 18px;
  background: #f2f4f7;
  border-bottom: 1px solid #dce2e8;
  font-size: 16px;
  font-weight: 700;
}

.facility-summary-section > fieldset {
  padding: 18px;
  border: 0;
  margin: 0;
}

.facility-summary-section fieldset[disabled] {
  opacity: 1;
}

.facility-summary-section fieldset[disabled] input,
.facility-summary-section fieldset[disabled] textarea,
.facility-summary-section fieldset[disabled] select {
  opacity: 1;
  color: #212529;
  background: #f8f9fa;
}

.facility-summary-subsection {
  padding: 18px;
  border-bottom: 1px solid #e5e7eb;
}

.facility-summary-subsection:last-child {
  border-bottom: 0;
}

.facility-summary-subsection h5 {
  margin-bottom: 18px;
  font-size: 15px;
  font-weight: 700;
}

.summary-record-card {
  margin-bottom: 16px;
  padding: 16px;
  border: 1px solid #e1e5ea;
  border-radius: 5px;
}

.summary-record-card h6 {
  margin-bottom: 15px;
  font-weight: 700;
}

.summary-field {
  margin-bottom: 15px;
}

.summary-field label {
  display: block;
  margin-bottom: 4px;
  color: #667085;
  font-size: 12px;
  font-weight: 600;
}

.summary-field > div {
  color: #222222;
  font-size: 14px;
}

.summary-field-row {
  padding: 10px 0;
  border-bottom: 1px solid #eeeeee;
}

.summary-question {
  padding: 12px 0;
  border-bottom: 1px solid #eeeeee;
}

.summary-question-text {
  margin-bottom: 5px;
  font-weight: 600;
}

.summary-question-answer {
  font-size: 14px;
}

.summary-explanation {
  margin-top: 5px;
  color: #666666;
  font-size: 13px;
}

.summary-table {
  font-size: 13px;
}
</style>
