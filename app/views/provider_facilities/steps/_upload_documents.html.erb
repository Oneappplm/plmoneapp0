<div class="provider-step-section upload-documents-step">
  <div class="upload-documents-header">
    <h2>Manage Documents</h2>

    <p class="upload-documents-description">
      Upload the required forms and supporting documentation for this
      facility application.
    </p>
  </div>

  <div class="upload-document-instructions">
    <h4>Instructions</h4>

    <ul>
      <li>Download forms and documentation, where available.</li>
      <li>Maximum file size is 10 MB.</li>
      <li>Supported formats: PDF, DOC, DOCX, JPG, JPEG, and PNG.</li>
      <li>
        Select one or more files, then click
        <strong>Upload Documents</strong>.
      </li>
    </ul>
  </div>
  <div class="upload-document-card">
    <div class="upload-document-card-header">
      Required and Supporting Documents
    </div>

    <div class="upload-document-table-wrapper">
      <table class="upload-document-table">
        <thead>
          <tr>
            <th class="document-number-column">#</th>
            <th class="document-name-column">
              Document Type
            </th>
            <th class="document-action-column">
              Select File
            </th>
            <th class="document-count-column">
              Uploaded
            </th>
          </tr>
        </thead>

        <tbody>
          <% @facility_documents.each_with_index do |document, index| %>
            <% document_title = document[:title] %>
            <% document_count = @uploaded_document_counts[document_title].to_i %>
            <% document_error = @upload_document_errors[document_title] %>

            <tr class="<%= 'document-row-error' if document_error.present? %>">
              <td class="document-number">
                <%= index + 1 %>
              </td>

              <td class="document-name">
                <div class="document-title">
                  <% if document[:required] %>
                    <span class="required-marker">*</span>
                  <% end %>

                  <%= document_title %>
                </div>

              </td>

              <td class="document-action">
							  <%= hidden_field_tag(
							        "facility_documents[#{document[:key]}][record_item]",
							        document_title
							      ) %>

							  <label class="custom-file-upload">
							    <span class="custom-file-button">
							      Choose File
							    </span>

							    <span class="custom-file-name">
							      No file selected
							    </span>

							    <%= file_field_tag(
							          "facility_documents[#{document[:key]}][file_upload]",
							          accept: ".pdf,.doc,.docx,.jpg,.jpeg,.png",
							          class: "facility-document-file",
							          data: {
							            document_name: document_title,
							            max_size: 10.megabytes
							          }
							        ) %>
							  </label>

							  <div class="file-input-error client-file-error"></div>

							  <% if document_error.present? %>
							    <div class="file-input-error server-file-error">
							      <%= document_error %>
							    </div>
							  <% end %>
							</td>

              <td
                class="document-count"
                data-document-name="<%= document_title %>"
              >
                <span
                  id="facility-document-count-<%= document[:key] %>"
                  class="document-count-badge"
                  data-document-name="<%= document_title %>"
                >
                  <%= document_count %>
                </span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="upload-documents-action">
      <%= submit_tag(
            "Upload Documents",
            name: "commit",
            value: "Upload Documents",
            class: "upload-documents-button"
          ) %>
    </div>
  </div>

  <div class="uploaded-documents-review">
	  <div class="uploaded-documents-heading">
	    <h3>Please review your documents for accuracy</h3>
	  </div>

	  <div
	    id="facility-document-delete-message"
	    class="facility-document-message"
	    role="alert"
	    aria-live="polite"
	  ></div>

	  <div class="uploaded-documents-table-wrapper">
	    <table class="uploaded-documents-table">
	      <thead>
	        <tr>
	          <th class="uploaded-action-column">Action</th>
	          <th>Document Type</th>
	          <th>Document</th>
	          <th class="uploaded-date-column">Upload Date</th>
	        </tr>
	      </thead>

	      <tbody id="uploaded-documents-table-body">
	        <% @uploaded_documents.each do |document| %>
	          <% document_definition = @facility_documents.find { |item| item[:title] == document.record_item } %>
	          <% document_key = document_definition&.dig(:key) || document.record_item.to_s.parameterize(separator: "_") %>

	          <tr
	            id="facility-document-row-<%= document.id %>"
	            class="uploaded-facility-document-row"
	            data-document-name="<%= document.record_item %>"
	            data-document-key="<%= document_key %>"
	          >
	            <td>
	              <%= link_to(
	                    "Delete",
	                    "#",
	                    class: "delete-facility-document",
	                    data: {
	                      id: document.id,
	                      document_name: document.record_item,
	                      document_key: document_key,
	                      delete_url: delete_facility_document_provider_facility_path(
	                        @provider.id,
	                        document_id: document.id
	                      )
	                    }
	                  ) %>
	            </td>

	            <td>
	              <%= document.record_item %>
	            </td>

	            <td>
	              <% if document.file_upload.present? %>
	                <%= link_to(
	                      File.basename(document.file_upload.url.to_s),
	                      document.file_upload.url,
	                      target: "_blank",
	                      rel: "noopener",
	                      class: "uploaded-document-link"
	                    ) %>
	              <% else %>
	                <span class="uploaded-document-unavailable">
	                  File unavailable
	                </span>
	              <% end %>
	            </td>

	            <td>
	              <%= document.created_at.strftime("%m/%d/%Y") %>
	            </td>
	          </tr>
	        <% end %>

	        <tr
	          id="no-uploaded-documents-row"
	          class="<%= 'is-hidden' if @uploaded_documents.present? %>"
	        >
	          <td colspan="4" class="empty-documents-message">
	            No documents have been uploaded yet.
	          </td>
	        </tr>
	      </tbody>
	    </table>
	  </div>
	</div>
</div>
<style>
