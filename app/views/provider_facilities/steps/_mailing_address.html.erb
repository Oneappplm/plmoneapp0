<h3>Mailing Address</h3>

<div class="corporate-form">
  <div class="form-row two-col">
    <div class="field-group">
      <%= label_tag "practice_information[mailing_name]" do %>
        Name <span class="required">*</span>
      <% end %>
      <%= text_field_tag "practice_information[mailing_name]",
          @practice_information.practice_name,
          class: "form-control",
          required: true %>
    </div>
  </div>

  <div class="form-row two-col">
    <div class="field-group">
      <%= label_tag "practice_information[mailing_address]" do %>
        Address Line 1 <span class="required">*</span>
      <% end %>
      <%= text_field_tag "practice_information[mailing_address]",
          @practice_information.address,
          class: "form-control",
          required: true %>
    </div>

    <div class="field-group">
      <%= label_tag "practice_information[mailing_address2]", "Address Line 2" %>
      <%= text_field_tag "practice_information[mailing_address2]",
          @practice_information.address2,
          class: "form-control" %>
    </div>
  </div>

  <div class="form-row two-col">
    <div class="field-group">
      <%= label_tag "practice_information[mailing_city]" do %>
        City <span class="required">*</span>
      <% end %>
      <%= text_field_tag "practice_information[mailing_city]",
          @practice_information.city,
          class: "form-control",
          required: true %>
    </div>

    <div class="field-group">
      <%= label_tag "practice_information[mailing_state]" do %>
        State <span class="required">*</span>
      <% end %>
      <%= select_tag "practice_information[mailing_state]",
          options_for_select(
            ["California", "Michigan", "Alabama", "Arizona", "Florida", "New York", "Ohio", "Texas"],
            @practice_information.state
          ),
          class: "form-control",
          required: true %>
    </div>
  </div>

  <div class="form-row two-col">
    <div class="field-group">
      <%= label_tag "practice_information[mailing_zip]" do %>
        Zip <span class="required">*</span>
      <% end %>
      <%= text_field_tag "practice_information[mailing_zip]",
          @practice_information.zip,
          class: "form-control",
          required: true %>
    </div>

    <div class="field-group">
      <%= label_tag "practice_information[mailing_fax]", "Fax" %>
      <%= text_field_tag "practice_information[mailing_fax]",
          @practice_information.fax_number,
          class: "form-control" %>
    </div>
  </div>

  <div class="form-row two-col">
    <div class="field-group">
      <%= label_tag "practice_information[mailing_phone]" do %>
        Phone <span class="required">*</span>
      <% end %>
      <%= text_field_tag "practice_information[mailing_phone]",
          @practice_information.phone_number,
          class: "form-control",
          required: true %>
    </div>

    <div class="field-group">
      <%= label_tag "practice_information[mailing_email]", "Email" %>
      <%= email_field_tag "practice_information[mailing_email]",
          @practice_information.email_address,
          class: "form-control" %>
    </div>
  </div>
</div>
