<h3>Primary Office and Contact Information</h3>

<h4>Primary/Corporate Office:</h4>

<div class="corporate-form">
  <div class="form-row two-col">
    <div class="field-group">
      <%= label_tag "practice_information[address_line_1]" do %>
        Address Line 1 <span class="required">*</span>
      <% end %>
      <%= text_field_tag "practice_information[address_line_1]", @practice_information.address, class: "form-control", required: true %>
    </div>

    <div class="field-group">
      <%= label_tag "practice_information[address_line_2]", "Address Line 2" %>
      <%= text_field_tag "practice_information[address_line_2]", @practice_information.address2, class: "form-control" %>
    </div>
  </div>

  <div class="form-row two-col">
    <div class="field-group">
      <%= label_tag "practice_information[city]" do %>
        City <span class="required">*</span>
      <% end %>
      <%= text_field_tag "practice_information[city]", @practice_information.city, class: "form-control", required: true %>
    </div>

    <div class="field-group">
      <%= label_tag "practice_information[county]", "County" %>
      <%= text_field_tag "practice_information[county]", @practice_information.county, class: "form-control" %>
    </div>
  </div>

  <div class="form-row two-col">
    <div class="field-group">
      <%= label_tag "practice_information[state]" do %>
        State <span class="required">*</span>
      <% end %>
      <%= text_field_tag "practice_information[state]", @practice_information.state, class: "form-control", required: true %>
    </div>

    <div class="field-group">
      <%= label_tag "practice_information[zip]" do %>
        Zip <span class="required">*</span>
      <% end %>
      <%= text_field_tag "practice_information[zip]", @practice_information.zip, class: "form-control", required: true %>
    </div>
  </div>

  <div class="form-row two-col">
    <div class="field-group">
      <%= label_tag "practice_information[phone]" do %>
        Phone <span class="required">*</span>
      <% end %>
      <%= text_field_tag "practice_information[phone]", @practice_information.phone_number, class: "form-control", required: true %>
    </div>

    <div class="field-group">
      <%= label_tag "practice_information[fax]", "Fax" %>
      <%= text_field_tag "practice_information[fax]", @practice_information.fax_number, class: "form-control" %>
    </div>
  </div>

  <div class="form-row two-col">
    <div class="field-group">
      <%= label_tag "practice_information[email]" do %>
        Email <span class="required">*</span>
      <% end %>
      <%= email_field_tag "practice_information[email]", @practice_information.email_address, class: "form-control", required: true %>
    </div>

    <div class="field-group">
      <%= label_tag "practice_information[website_address]", "Website Address" %>
      <%= text_field_tag "practice_information[website_address]", @practice_information.practice_description, class: "form-control" %>
    </div>
  </div>

  <h4>Contact Person:</h4>

  <% contact_name = @practice_information.office_manager.to_s.split(" ") %>

  <div class="form-row two-col">
    <div class="field-group">
      <%= label_tag "practice_information[contact_first_name]" do %>
        First Name <span class="required">*</span>
      <% end %>
      <%= text_field_tag "practice_information[contact_first_name]", contact_name[0], class: "form-control", required: true %>
    </div>

    <div class="field-group">
      <%= label_tag "practice_information[contact_middle_name]", "Middle Name" %>
      <%= text_field_tag "practice_information[contact_middle_name]", contact_name.length > 2 ? contact_name[1] : nil, class: "form-control" %>
    </div>
  </div>

  <div class="form-row two-col">
    <div class="field-group">
      <%= label_tag "practice_information[contact_last_name]" do %>
        Last Name <span class="required">*</span>
      <% end %>
      <%= text_field_tag "practice_information[contact_last_name]", contact_name.length > 1 ? contact_name[-1] : nil, class: "form-control", required: true %>
    </div>

    <div class="field-group">
      <%= label_tag "practice_information[contact_phone]" do %>
        Contact Phone <span class="required">*</span>
      <% end %>
      <%= text_field_tag "practice_information[contact_phone]", @practice_information.manager_phone_number, class: "form-control", required: true %>
    </div>
  </div>

  <div class="form-row two-col">
    <div class="field-group">
      <%= label_tag "practice_information[contact_fax]", "Contact Fax" %>
      <%= text_field_tag "practice_information[contact_fax]", @practice_information.manager_fax_number, class: "form-control" %>
    </div>

    <div class="field-group">
      <%= label_tag "practice_information[contact_email]" do %>
        Contact Email <span class="required">*</span>
      <% end %>
      <%= email_field_tag "practice_information[contact_email]", @practice_information.email_address, class: "form-control", required: true %>
    </div>
  </div>
</div>
