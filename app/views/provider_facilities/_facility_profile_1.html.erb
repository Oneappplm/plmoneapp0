<div class="facility-form-box">
  <h3>Facility Profile 1</h3>

  <div class="facility-profile-questions">
    <div class="facility-question-header">
      <div>#</div>
      <div>Answer all questions</div>
      <div></div>
      <div></div>
    </div>

    <% @facility_profile_1_questions.each_with_index do |record, index| %>
      <% answer =
          if record.provider_practice_answer_flag == true
            "yes"
          elsif record.provider_practice_answer_flag == false
            "no"
          else
            "na"
          end
      %>

      <div class="facility-question-row">
        <div class="question-number">
          <%= index + 1 %>.
        </div>

        <div class="question-text">
          <span class="required">*</span>
          <%= record.other_question_other_question_summary %>

          <%= hidden_field_tag(
                "facility_profile_questions[#{index}][question]",
                record.other_question_other_question_summary
              ) %>
        </div>

        <div class="question-options">
          <label>
            <%= radio_button_tag(
                  "facility_profile_questions[#{index}][answer]",
                  "yes",
                  answer == "yes",
                  required: true,
                  class: "facility-profile-answer",
                  data: { index: index }
                ) %>
            Yes
          </label>

          <label>
            <%= radio_button_tag(
                  "facility_profile_questions[#{index}][answer]",
                  "no",
                  answer == "no",
                  required: true,
                  class: "facility-profile-answer",
                  data: { index: index }
                ) %>
            No
          </label>

          <label>
            <%= radio_button_tag(
                  "facility_profile_questions[#{index}][answer]",
                  "na",
                  answer == "na",
                  required: true,
                  class: "facility-profile-answer",
                  data: { index: index }
                ) %>
            N/A
          </label>
        </div>

        <div class="question-explanation">
          <%= text_area_tag(
                "facility_profile_questions[#{index}][explanation]",
                record.provider_practice_answer_text,
                id: "facility-profile-explanation-#{index}",
                class: "form-control facility-explanation",
                placeholder: "If No, please provide explanation.",
                disabled: answer != "no"
              ) %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
  document
    .querySelectorAll(".facility-profile-answer")
    .forEach(function (radio) {
      radio.addEventListener("change", function () {
        const index = this.dataset.index
        const explanation =
          document.getElementById(`facility-profile-explanation-${index}`)

        if (!explanation) return

        if (this.value === "no") {
          explanation.disabled = false
          explanation.required = true
          explanation.focus()
        } else {
          explanation.value = ""
          explanation.required = false
          explanation.disabled = true
        }
      })
    })
})
</script>

<style>
.facility-profile-questions {
  width: 100%;
  max-width: 940px;
  margin-top: 28px;
  border: 1px solid #999;
  padding: 8px 10px;
}

.facility-question-header,
.facility-question-row {
  display: grid;
  grid-template-columns: 28px minmax(320px, 1fr) 175px 210px;
  column-gap: 10px;
  align-items: center;
}

.facility-question-header {
  font-weight: 600;
  font-size: 12px;
  padding: 6px 0 12px;
}

.facility-question-row {
  min-height: 64px;
  font-size: 12px;
  padding: 5px 0;
}

.question-number {
  align-self: start;
  padding-top: 7px;
}

.question-text {
  line-height: 1.4;
}

.question-options {
  display: flex;
  gap: 14px;
  white-space: nowrap;
}

.question-options label {
  font-weight: normal;
  margin: 0;
}

.facility-explanation {
  width: 100%;
  height: 50px;
  min-height: 50px;
  resize: vertical;
  font-size: 12px;
}

.facility-explanation:disabled {
  background: #f5f5f5;
}

.required {
  color: red;
}

@media (max-width: 900px) {
  .facility-question-header {
    display: none;
  }

  .facility-question-row {
    grid-template-columns: 25px 1fr;
    row-gap: 10px;
    border-bottom: 1px solid #ddd;
    padding: 12px 0;
  }

  .question-options,
  .question-explanation {
    grid-column: 2;
  }
}
</style>
