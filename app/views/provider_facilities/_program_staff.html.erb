
  <div class="facility-form-box">
    <h3>Program Staff</h3>

    <p>Please enter Program Staff details below:</p>

    <div class="program-staff-box">

    <%= hidden_field_tag :staff_id %>

    <div class="program-staff-row">
      <label>First Name <span class="required">*</span></label>

      <%= text_field_tag :first_name, nil,
          class: "form-control",
          id: "first_name" %>
    </div>

    <div class="program-staff-row">
      <label>Middle Name</label>

      <%= text_field_tag :middle_name, nil,
          class: "form-control",
          id: "middle_name" %>
    </div>

    <div class="program-staff-row">
      <label>Last Name <span class="required">*</span></label>

      <%= text_field_tag :last_name, nil,
          class: "form-control",
          id: "last_name" %>
    </div>

    <div class="program-staff-row">
      <label>NPI</label>

      <%= text_field_tag :npi, nil,
          class: "form-control",
          id: "npi" %>
    </div>

    <div class="program-staff-row">
      <label>Degree</label>

      <%= text_field_tag :degree, nil,
          class: "form-control",
          id: "degree" %>
    </div>

    <div class="program-staff-row">
      <label>Job Title <span class="required">*</span></label>

      <%= text_field_tag :job_title, nil,
          class: "form-control",
          id: "job_title" %>
    </div>

    <div class="program-staff-row">
      <label>Licensure</label>

      <%= text_field_tag :licensure, nil,
          class: "form-control",
          id: "licensure" %>
    </div>

    <div class="program-staff-row">
      <label>Certification</label>

      <%= text_field_tag :certification, nil,
          class: "form-control",
          id: "certification" %>
    </div>

    <div class="program-staff-actions">

        <button
            type="button"
            id="insert-program-staff"
            class="staff-insert-btn">
            Insert
        </button>

        <button
            type="button"
            id="cancel-program-staff"
            class="staff-cancel-btn">
            Cancel
        </button>

    </div>

  </div>
  
  <div
    id="program-staff-table-wrapper"
    style="<%= @program_staffs.present? ? '' : 'display:none;' %>"
  >
    <table id="program-staff-table" class="program-staff-table">
      <thead>
        <tr>
          <th>Edit/Delete</th>
          <th>First Name</th>
          <th>Middle Name</th>
          <th>Last Name</th>
          <th>NPI</th>
          <th>Job Title</th>
          <th>Degree/Diploma</th>
          <th>Licensure</th>
          <th>Certification</th>
        </tr>
      </thead>

      <tbody id="program-staff-table-body">
        <% @program_staffs.each do |staff| %>
          <tr
            id="program-staff-row-<%= staff.id %>"
            data-id="<%= staff.id %>"
            data-first-name="<%= staff.associate_first_name %>"
            data-middle-name="<%= staff.associate_middle_initial %>"
            data-last-name="<%= staff.associate_last_name %>"
            data-npi="<%= staff.provider_type_provider_type_abbreviation %>"
            data-job-title="<%= staff.title %>"
            data-degree="<%= staff.degree_degree_abbreviation %>"
            data-licensure="<%= staff.license_number %>"
            data-certification="<%= staff.other_skills %>"
          >
            <td class="staff-actions">
              <button type="button" class="edit-program-staff-btn">Edit</button>
              <span>|</span>
              <button type="button" class="delete-program-staff-btn">Delete</button>
            </td>

            <td class="staff-first-name"><%= staff.associate_first_name %></td>
            <td class="staff-middle-name"><%= staff.associate_middle_initial %></td>
            <td class="staff-last-name"><%= staff.associate_last_name %></td>
            <td class="staff-npi"><%= staff.provider_type_provider_type_abbreviation %></td>
            <td class="staff-job-title"><%= staff.title %></td>
            <td class="staff-degree"><%= staff.degree_degree_abbreviation %></td>
            <td class="staff-licensure"><%= staff.license_number %></td>
            <td class="staff-certification"><%= staff.other_skills %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
<script>
(function () {
  const saveUrl = "<%= provider_facility_path(@provider) %>"
  const practiceLocationId = "<%= @practice_location&.id %>"

  function csrfToken() {
    return document.querySelector("meta[name='csrf-token']")?.content
  }

  function escapeHtml(value) {
    return $("<div>").text(value || "").html()
  }

  function clearMainForm() {
    $("#staff_id").val("")
    $("#first_name").val("")
    $("#middle_name").val("")
    $("#last_name").val("")
    $("#npi").val("")
    $("#degree").val("")
    $("#job_title").val("")
    $("#licensure").val("")
    $("#certification").val("")
    $("#first_name").focus()
  }

  function staffParams(action, staffId = null) {
    return {
      step: "facility_profile",
      facility_tab: "program_staff",
      program_staff_action: action,
      practice_location_id: practiceLocationId,
      staff_id: staffId,
      first_name: $("#first_name").val().trim(),
      middle_name: $("#middle_name").val().trim(),
      last_name: $("#last_name").val().trim(),
      npi: $("#npi").val().trim(),
      degree: $("#degree").val().trim(),
      job_title: $("#job_title").val().trim(),
      licensure: $("#licensure").val().trim(),
      certification: $("#certification").val().trim()
    }
  }

  function validateMainForm() {
    const requiredFields = [
      ["#first_name", "First Name is required."],
      ["#last_name", "Last Name is required."],
      ["#job_title", "Job Title is required."]
    ]

    for (const [selector, message] of requiredFields) {
      const field = $(selector)

      if (!field.val().trim()) {
        alert(message)
        field.focus()
        return false
      }
    }

    return true
  }

  function normalRowHtml(staff) {
    return `
      <tr
        id="program-staff-row-${staff.id}"
        data-id="${staff.id}"
        data-first-name="${escapeHtml(staff.associate_first_name)}"
        data-middle-name="${escapeHtml(staff.associate_middle_initial)}"
        data-last-name="${escapeHtml(staff.associate_last_name)}"
        data-npi="${escapeHtml(staff.provider_type_provider_type_abbreviation)}"
        data-job-title="${escapeHtml(staff.title)}"
        data-degree="${escapeHtml(staff.degree_degree_abbreviation)}"
        data-licensure="${escapeHtml(staff.license_number)}"
        data-certification="${escapeHtml(staff.other_skills)}"
      >
        <td class="staff-actions">
          <button type="button" class="edit-program-staff-btn">Edit</button>
          <span>|</span>
          <button type="button" class="delete-program-staff-btn">Delete</button>
        </td>

        <td class="staff-first-name">${escapeHtml(staff.associate_first_name)}</td>
        <td class="staff-middle-name">${escapeHtml(staff.associate_middle_initial)}</td>
        <td class="staff-last-name">${escapeHtml(staff.associate_last_name)}</td>
        <td class="staff-npi">${escapeHtml(staff.provider_type_provider_type_abbreviation)}</td>
        <td class="staff-job-title">${escapeHtml(staff.title)}</td>
        <td class="staff-degree">${escapeHtml(staff.degree_degree_abbreviation)}</td>
        <td class="staff-licensure">${escapeHtml(staff.license_number)}</td>
        <td class="staff-certification">${escapeHtml(staff.other_skills)}</td>
      </tr>
    `
  }

  $(document)
    .off("click.programStaffInsert", "#insert-program-staff")
    .on("click.programStaffInsert", "#insert-program-staff", function () {
      if (!validateMainForm()) return

      const button = $(this)
      button.prop("disabled", true)

      $.ajax({
        url: saveUrl,
        method: "PATCH",
        dataType: "json",
        headers: {
          "X-CSRF-Token": csrfToken()
        },
        data: staffParams("insert"),

        success: function (response) {
          if (!response.success) return

          $("#program-staff-table-wrapper").show()

          $("#program-staff-table-body").prepend(
            normalRowHtml(response.staff)
          )

          clearMainForm()
        },

        error: function (xhr) {
          const errors =
            xhr.responseJSON?.errors || ["Unable to add Program Staff."]

          alert(errors.join("\n"))
        },

        complete: function () {
          button.prop("disabled", false)
        }
      })
    })

  $(document)
    .off("click.programStaffCancel", "#cancel-program-staff")
    .on("click.programStaffCancel", "#cancel-program-staff", function () {
      clearMainForm()
    })

  $(document)
    .off("click.programStaffEdit", ".edit-program-staff-btn")
    .on("click.programStaffEdit", ".edit-program-staff-btn", function () {
      const row = $(this).closest("tr")

      if (row.hasClass("editing")) return

      row.addClass("editing")

      row.find(".staff-actions").html(`
        <button type="button" class="update-program-staff-btn">Update</button>
        <span>|</span>
        <button type="button" class="cancel-edit-program-staff-btn">Cancel</button>
      `)

      row.find(".staff-first-name").html(
        `<input type="text" class="edit-first-name form-control" value="${escapeHtml(row.attr("data-first-name"))}">`
      )

      row.find(".staff-middle-name").html(
        `<input type="text" class="edit-middle-name form-control" value="${escapeHtml(row.attr("data-middle-name"))}">`
      )

      row.find(".staff-last-name").html(
        `<input type="text" class="edit-last-name form-control" value="${escapeHtml(row.attr("data-last-name"))}">`
      )

      row.find(".staff-npi").html(
        `<input type="text" class="edit-npi form-control" value="${escapeHtml(row.attr("data-npi"))}">`
      )

      row.find(".staff-job-title").html(
        `<input type="text" class="edit-job-title form-control" value="${escapeHtml(row.attr("data-job-title"))}">`
      )

      row.find(".staff-degree").html(
        `<input type="text" class="edit-degree form-control" value="${escapeHtml(row.attr("data-degree"))}">`
      )

      row.find(".staff-licensure").html(
        `<input type="text" class="edit-licensure form-control" value="${escapeHtml(row.attr("data-licensure"))}">`
      )

      row.find(".staff-certification").html(
        `<input type="text" class="edit-certification form-control" value="${escapeHtml(row.attr("data-certification"))}">`
      )
    })

  $(document)
    .off("click.programStaffUpdate", ".update-program-staff-btn")
    .on("click.programStaffUpdate", ".update-program-staff-btn", function () {
      const button = $(this)
      const row = button.closest("tr")
      const staffId = row.data("id")

      const firstName = row.find(".edit-first-name").val().trim()
      const lastName = row.find(".edit-last-name").val().trim()
      const jobTitle = row.find(".edit-job-title").val().trim()

      if (!firstName) {
        row.find(".edit-first-name").focus()
        return
      }

      if (!lastName) {
        row.find(".edit-last-name").focus()
        return
      }

      if (!jobTitle) {
        row.find(".edit-job-title").focus()
        return
      }

      button.prop("disabled", true)

      $.ajax({
        url: saveUrl,
        method: "PATCH",
        dataType: "json",
        headers: {
          "X-CSRF-Token": csrfToken()
        },

        data: {
          step: "facility_profile",
          facility_tab: "program_staff",
          program_staff_action: "update",
          practice_location_id: practiceLocationId,
          staff_id: staffId,
          first_name: firstName,
          middle_name: row.find(".edit-middle-name").val().trim(),
          last_name: lastName,
          npi: row.find(".edit-npi").val().trim(),
          job_title: jobTitle,
          degree: row.find(".edit-degree").val().trim(),
          licensure: row.find(".edit-licensure").val().trim(),
          certification: row.find(".edit-certification").val().trim()
        },

        success: function (response) {
          row.replaceWith(normalRowHtml(response.staff))
        },

        error: function (xhr) {
          const errors =
            xhr.responseJSON?.errors || ["Unable to update Program Staff."]

          alert(errors.join("\n"))
          button.prop("disabled", false)
        }
      })
    })

  $(document)
    .off("click.programStaffCancelEdit", ".cancel-edit-program-staff-btn")
    .on("click.programStaffCancelEdit", ".cancel-edit-program-staff-btn", function () {
      const row = $(this).closest("tr")

      const staff = {
        id: row.data("id"),
        associate_first_name: row.attr("data-first-name"),
        associate_middle_initial: row.attr("data-middle-name"),
        associate_last_name: row.attr("data-last-name"),
        provider_type_provider_type_abbreviation: row.attr("data-npi"),
        title: row.attr("data-job-title"),
        degree_degree_abbreviation: row.attr("data-degree"),
        license_number: row.attr("data-licensure"),
        other_skills: row.attr("data-certification")
      }

      row.replaceWith(normalRowHtml(staff))
    })

  $(document)
    .off("click.programStaffDelete", ".delete-program-staff-btn")
    .on("click.programStaffDelete", ".delete-program-staff-btn", function () {
      const button = $(this)
      const row = button.closest("tr")
      const staffId = row.data("id")

      if (!confirm("Are you sure you want to delete this Program Staff record?")) {
        return
      }

      button.prop("disabled", true)

      $.ajax({
        url: saveUrl,
        method: "PATCH",
        dataType: "json",
        headers: {
          "X-CSRF-Token": csrfToken()
        },

        data: {
          step: "facility_profile",
          facility_tab: "program_staff",
          program_staff_action: "delete",
          practice_location_id: practiceLocationId,
          staff_id: staffId
        },

        success: function (response) {
          if (!response.success) return

          row.remove()

          if ($("#program-staff-table-body tr").length === 0) {
            $("#program-staff-table-wrapper").hide()
          }
        },

        error: function (xhr) {
          const errors =
            xhr.responseJSON?.errors || ["Unable to delete Program Staff."]

          alert(errors.join("\n"))
          button.prop("disabled", false)
        }
      })
    })
})()
</script>
<style>
.facility-tabs {
  border-bottom: 1px solid #999;
  margin-top: 20px;
}

.facility-tab {
  display: inline-block;
  border: 1px solid #999;
  border-bottom: none;
  padding: 4px 8px;
  font-size: 12px;
  background: #e5e5e5;
  color: #333;
  text-decoration: none;
}

.active-tab {
  background: #fff;
  border-top: 2px solid orange;
}

.facility-form-box {
  border: 1px solid #999;
  padding: 18px;
}

.program-staff-box {
  margin-top: 30px;
  margin-left: 20px;
  max-width: 520px;
}

.program-staff-row {
  display: grid;
  grid-template-columns: 160px 1fr;
  align-items: center;
  margin-bottom: 16px;
}

.program-staff-row label {
  font-size: 12px;
}

.program-staff-row .form-control {
  height: 28px;
  width: 230px;
}

.program-staff-actions {
  display: flex;
  gap: 180px;
  margin-top: 20px;
}

.staff-insert-btn,
.staff-cancel-btn {
  background: none;
  border: none;
  color: #0066cc;
  font-size: 12px;
}

.program-staff-table {
  width: 70%;
  margin-top: 35px;
  border-collapse: collapse;
  font-size: 12px;
}

.program-staff-table th {
  background: #4f7ed6;
  color: #fff;
  padding: 8px;
}

.program-staff-table td {
  background: #eef3ff;
  padding: 8px;
}

.required {
  color: red;
}
.program-staff-table input.form-control {
  width: 130px;
  min-width: 110px;
  height: 28px;
  padding: 3px 5px;
  font-size: 12px;
}

.edit-program-staff-btn,
.delete-program-staff-btn,
.update-program-staff-btn,
.cancel-edit-program-staff-btn {
  border: 0;
  background: transparent;
  color: #0066cc;
  padding: 0;
  font-size: 12px;
  cursor: pointer;
}
</style>
