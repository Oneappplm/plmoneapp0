<%
sidebar_sections = [
  {
    label: "Provider Type",
    step: "provider_type",
    active_steps: [
      "provider_type"
    ]
  },
  {
    label: "Profile Data",
    step: "corporate_information",
    active_steps: [
      "corporate_information",
      "primary_office_contact",
      "mailing_address",
      "licensure_certification",
      "accreditation",
      "insurance",
      "staffing",
      "facility_profile"
    ]
  },
  {
    label: "Upload Documents",
    step: "attestation",
    active_steps: [
      "attestation",
      "upload_documents"
    ]
  },
  {
    label: "Confirmation",
    step: "confirmation",
    active_steps: [
      "confirmation"
    ]
  }
]
%>

<div class="provider-facility-sidebar">
  <% sidebar_sections.each do |section| %>
    <% active_section = section[:active_steps].include?(@step) %>

    <div class="facility-main-step <%= 'active' if active_section %> disabled-step">
      <span class="main-step-label">
        <span class="sidebar-arrow">&rsaquo;</span>
        <span class="main-step-text"><%= section[:label] %></span>
      </span>

      <span class="step-dot"></span>
    </div>
  <% end %>
</div>


<style>
  .disabled-step {
    cursor: default;
  }

  .disabled-step:hover {
    background: inherit;
  }
  .provider-facility-sidebar {
    width: 260px;
    min-width: 260px;
    max-width: 260px;
    flex: 0 0 260px;
    height: 100%;
    overflow-y: auto;
    overflow-x: hidden;
    background: #f4f4f4;
    border-radius: 6px;
    box-sizing: border-box;
  }

  .provider-facility-sidebar .facility-main-step {
    width: 100%;
    min-height: 58px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 16px 18px;
    color: #222222;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid #dddddd;
    box-sizing: border-box;
  }

  .provider-facility-sidebar .facility-main-step:hover {
    background: #f9f9f9;
    color: #222222;
    text-decoration: none;
  }

  .provider-facility-sidebar .facility-main-step.active {
    background: #2f75ff;
    color: #ffffff;
  }

  .provider-facility-sidebar .main-step-label {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1;
    min-width: 0;
  }

  .provider-facility-sidebar .sidebar-arrow {
    width: 12px;
    min-width: 12px;
    color: #777777;
    font-size: 20px;
    font-weight: 700;
    line-height: 1;
    text-align: center;
  }

  .provider-facility-sidebar .main-step-text {
    min-width: 0;
  }

  .provider-facility-sidebar .facility-main-step.active .sidebar-arrow {
    color: #ffffff;
  }

  .provider-facility-sidebar .step-dot {
    width: 8px;
    height: 8px;
    min-width: 8px;
    background: #ff4b82;
    border-radius: 50%;
  }

  .provider-facility-sidebar .facility-main-step.active .step-dot {
    background: #ffffff;
  }
</style>
