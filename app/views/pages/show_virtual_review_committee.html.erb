<div class="content container-fluid" >
	<div class="row">
		<div class="col-lg-9">

			<div class="row">
				<div class="col-lg-10 d-flex gap-2 align-items-center flex-wrap">
					<%= link_to virtual_review_committee_path, class: 'btn btn-sm btn-danger d-inline-flex align-items-center' do %>
					  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 16px; margin-right: 0.5rem;">
					    <path stroke-linecap="round" stroke-linejoin="round" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3" />
					  </svg>
					  <span>Back</span>
					<% end %>
					<button id="btn-profile" class="btn btn-sm btn-primary d-inline-flex align-items-center">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" style="width: 16px; margin-right: 0.5rem;">
							<path fill-rule="evenodd" d="M18.685 19.097A9.723 9.723 0 0021.75 12c0-5.385-4.365-9.75-9.75-9.75S2.25 6.615 2.25 12a9.723 9.723 0 003.065 7.097A9.716 9.716 0 0012 21.75a9.716 9.716 0 006.685-2.653zm-12.54-1.285A7.486 7.486 0 0112 15a7.486 7.486 0 015.855 2.812A8.224 8.224 0 0112 20.25a8.224 8.224 0 01-5.855-2.438zM15.75 9a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" clip-rule="evenodd" />
						</svg>
						<span>Profile</span>
					</button>
					<button id="btn-change-review-level" class="btn btn-sm btn-light d-inline-flex align-items-center">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" style="width: 16px; margin-right: 0.5rem;">
							<path d="M21.731 2.269a2.625 2.625 0 00-3.712 0l-1.157 1.157 3.712 3.712 1.157-1.157a2.625 2.625 0 000-3.712zM19.513 8.199l-3.712-3.712-8.4 8.4a5.25 5.25 0 00-1.32 2.214l-.8 2.685a.75.75 0 00.933.933l2.685-.8a5.25 5.25 0 002.214-1.32l8.4-8.4z" />
							<path d="M5.25 5.25a3 3 0 00-3 3v10.5a3 3 0 003 3h10.5a3 3 0 003-3V13.5a.75.75 0 00-1.5 0v5.25a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5V8.25a1.5 1.5 0 011.5-1.5h5.25a.75.75 0 000-1.5H5.25z" />
						</svg>
						<span>Change Review Level</span>
					</button>
				</div>
				<div class="col-lg-2">
					<div class="d-flex justify-content-end">
						<% case @provider.cred_status %>
              <% when "psv" %>
                <% if @psv_pdf.present? %>
                  <%= link_to @psv_pdf.file_path.url, target: "_blank", class: "text-white fs-5 btn btn-primary btn-sm" do %>
                    <i class="fas fa-file-pdf fa-xl"></i>
                    <span class="text-white fw-bold">Verified Profile</span>
                  <% end %>
                <% else %>
                  <span class="text-warning">PDF not available</span>
                <% end %>

              <% when "attested", "completed", "no-application", "incomplete", "pending", "in-process", "returned" %>
                <span class="status-indicator rounded"></span>
            <% end %>
					</div>
				</div>
			</div>

			<div class="row">
				<div class="col-lg-12">
					
					<table id="show-vrc-table" class="mt-4 table table-bordered align-middle">
						<thead style="background-color: #377dff; color: #fff;">
							<tr>
								<th width="20%" style="text-align: center;">Provider Name</th>
								<th width="15%" style="text-align: left;">Phone/Email</th>
								<th width="10%">Date of Birth</th>
								<th width="10%">SSN</th>
								<th width="10%">NPI</th>
								<th width="8%">TIN</th>
								<th width="15%">Medicare #</th>
								<th width="15%" style="text-align: left;">Group Name</th>
							</tr>
						</thead>
						<tbody>
							<% if @provider_personal_informations.present? %>
								<% @provider_personal_informations.each do |provider| %>
									<tr>
										<td>
											<h5>
												<%= provider.fullname %>
											</h5>
										</td>
										<td style="word-break: break-word; max-width: 200px; white-space: normal;">
											<%= provider.cell_phone_number %> / 
											<%= provider.email_address%>
										</td>
										<td><%= provider.birth_date.strftime('%m/%d/%Y') %></td>
										<td><%= provider.ssn %></td>
										<td><%= provider.npi %></td>
										<td> NA </td>
										<td><%= provider.medicare_provider_flag ? "Yes" : "No" %></td>
										<td>NA</td>
									</tr>
								<% end %>
							<% else %>
								<tr>
									<td colspan="8" class="text-center text-muted">No provider data available.</td>
								</tr>
							<% end %>
						</tbody>
					</table>
					<hr style="margin: 0;">
					<table class="table border">
						<thead>
				        <tr>
				          <th class="fw-bold text-white">Received Date</th>
				          <th class="fw-bold text-white">Completed Date</th>
				          <th class="fw-bold text-white">PSV Date</th>
				          <th class="fw-bold text-white">Cred Cycle Cred</th>
				          <th class="fw-bold text-white">Recred Due Date</th>
				        </tr>
				      </thead>
						<tbody>
							<tr>
								<td>
									<%= @provider.provider_personal_information_app_trackings.first&.application_receipt_date&.strftime('%m/%d/%Y') || "NA" %>
								</td>
								<td>
									<%= @provider.provider_personal_information_app_trackings.first
                              &.application_submitted_date
                              &.in_time_zone('Pacific Time (US & Canada)')
                              &.strftime('%m/%d/%Y') || "NA" %>
								</td>
								<td>
									<%# case  %>
										<%# when "psv" %>
										<% if @provider.cred_status.present? || @psv_pdf.present? %>
											<%= @psv_pdf&.created_at&.strftime('%m/%d/%Y') %>
										<% end %>
									<%# end %>
								</td>
								
								<td><%= @provider&.cred_cycle || "NA" %></td>
								<td><%= @provider&.recred_due_date || "NA" %></td>
							</tr>
							<%# <tr> %>
								<%# <td>
								  <strong>Level of Review:</strong> <br> %>

								  <%# dea_record = ProviderDea.find_by(provider_attest_id: @provider&.provider_attest_id) %>

								  <%# if dea_record&.expiration_date.present? %>
								    <%# <span class="badge bg-danger px-2 py-2 mt-2">Unclean</span> %>
								  <%# else %>
								    <%# <span id="review-level"><%= @provider&.review_level</span> %> 
								  <%# end %>
								<%# </td> %>

								<%# <td>
									<strong for="">Review Details:</strong> <br> %>
									<%#= @provider.review_details %>
								<%# </td> %>
							<%# </tr> %>
						</tbody>
					</table>

					<div class="table-responsive">
				    <table class="table table-bordered">
				      <thead>
				        <tr>
				          <th class="fw-bold text-white">Level of Review</th>
				          <th class="fw-bold text-white">Review Details (File Issue Reason)</th>
				          <th class="fw-bold text-white">Review Details (File Review Reason)</th>
				        </tr>
				      </thead>
				      <tbody>
				        <% @provider.provider_personal_information_app_trackings.each do |app_tracking| %>
				          <tr>
				            <td>
				              <% if app_tracking.master_issues.compact_blank.any? || app_tracking.master_reviews.compact_blank.any? %>
				                Unclean
				              <% else %>
				                Clean
				                <%#= app_tracking.file_status.present? ? app_tracking.file_status.upcase : "CLEAN" %>
				              <% end %>
				            </td>
				                        
				            <!-- File Issue Reason -->
				            <td>
				              <% if app_tracking.master_issues.compact_blank.any? %>
				                <ul class="mb-0 ps-3">
				                  <% app_tracking.master_issues.each do |issue| %>
				                    <li><%= issue %></li>
				                  <% end %>
				                </ul>
				              <% else %>
				                None
				              <% end %>
				            </td>

				            <!-- File Review Reason -->
				            <td>
				              <% if app_tracking.master_reviews.compact_blank.any? %>
				                <ul class="mb-0 ps-3">
				                  <% app_tracking.master_reviews.each do |review| %>
				                    <li><%= review %></li>
				                  <% end %>
				                </ul>
				              <% else %>
				                None
				              <% end %>
				            </td>
				          </tr>
				        <% end %>
				      </tbody>
				    </table>
				  </div>
				</div>
				<% if @provider&.progress_status == "completed" %>
					<div class="content-box mt-2">
					  <div class="content-box-header">
					    <h3>Licensure and Registration</h3>
					  </div>
					  <div class="content-box-content">
					    <table class="fullwidth table table-bordered">
					      <thead>
					        <tr>
					          <th class="text-white">Number</th>
					          <th class="text-white">Type</th>
					          <th class="text-white">State</th>
					          <th style="text-align:center;" class="text-white">From Date</th>
					          <th style="text-align:center;" class="text-white">To Date</th>
					          <%# <th style="text-align:center;" class="text-white">Source</th>
					          <th style="text-align:center;" class="text-white">Status</th> %>
					          <th style="text-align:center;" class="text-white">Verify Date</th>
					        </tr>
					      </thead>
					      <tbody>
					        <% @provider.provider_licensures.each do |lic| %>
					          <tr class="alt-row">
					            <td><%= lic.license_number %></td>
					            <td>Licensure - <%= lic.license_type %></td>
					            <td><%= State.find_by(id: lic.state_id)&.alpha_code || "NA" %></td>
					            <td style="text-align:center;"><%= lic.license_issue_date&.strftime('%m/%d/%Y') || "NA" %></td>
					            <td style="text-align:center;"><%= lic.license_expiration_date&.strftime('%m/%d/%Y') || "NA" %></td>
					           <%#  <td style="text-align:center;">State Board</td>
					            <td style="text-align:center;">ACTIVE</td> %>
					            <td style="text-align:center;"><%= lic.updated_at&.strftime('%m/%d/%Y') || "NA" %></td>
					          </tr>
					        <% end %>

					        <% @provider.provider_deas.each do |dea| %>
					          <tr>
					            <td><%= dea.dea_number %></td>
					            <td>Registration - DEA</td>
					            <td><%= dea.state %></td>
					            <td style="text-align:center;">-</td>
					            <td style="text-align:center;"><%= dea.expiration_date&.strftime('%m/%d/%Y') %></td>
					            <%# <td style="text-align:center;">DEA</td>
					            <td style="text-align:center;">ACTIVE</td> %>
					            <td style="text-align:center;"><%= dea.updated_at&.strftime('%m/%d/%Y') %></td>
					          </tr>
					        <% end %>
					      </tbody>
					    </table>
					    <span class="clear"></span>
					  </div>
					</div>

			    <div class="content-box mt-2">
			      <div class="content-box-header">
			        <h3>Reviews</h3>
			      </div>
			      <div class="content-box-content">
			        <table class="fullwidth table table-bordered">
			          <thead>
			            <tr class="TableHeaderStyle2">
			              <th class="text-white">Voted Date</th>
			              <th class="text-white">Reviewer</th>
			              <th class="text-white">Role</th>
			              <th class="text-white">Comment/Note</th>
			              <th class="text-white">Action</th>
			            </tr>
			          </thead>
			          <tbody>
			            <tr class="alt-row">
			              <td>03/23/2022</td>
			              <td>DemoDirector Test</td>
			              <td>VRC Director</td>
			              <td>NA</td>
			              <td>Approved</td>
			            </tr>
			            <tr>
			              <td>03/23/2022</td>
			              <td>DemoMember Test</td>
			              <td>VRC Member</td>
			              <td>NA</td>
			              <td>Approved</td>
			            </tr>
			          </tbody>
			        </table>
			        <span class="clear">
			        </span>
			      </div>
			    </div>
			    <div class="content-box mt-2">
			      <div class="content-box-header">
			        <h3>Minutes</h3>
			      </div>
			      <div class="content-box-content">
			        <table class="fullwidth table table-bordered">
			          <thead>
			            <tr class="TableHeaderStyle2">
			              <th style="width:80px" class="text-white">Medv Id</th>
			              <th style="width:80px" class="text-white">Provider Id</th>
			              <th style="width:80px" class="text-white">Review Level</th>
			              <th class="text-white">Issues</th>
			              <th class="text-white">Result</th>
			            </tr>
			          </thead>
			          <tbody>
			            <tr class="alt-row">
			              <td clas><%= @provider&.caqh_provider_attest_id || @provider&.provider_attest_id %></td>
			              <td clas><%= @provider&.caqh_provider_attest_id || @provider&.provider_attest_id %></td>
			              <%# <td> %>
			              	<%# dea_record = ProviderDea.find_by(provider_attest_id: @provider&.provider_attest_id) %>
			              	
										  <%# if dea_record&.expiration_date.present? %>
										    <%# <span class="badge bg-danger text-white">Unclean</span> %>
										  <%# else %>
										    <%# <span id="review-level"><%= @provider&.review_level</span> %>
										  <%# end %>
			              <%# </td> %>
			              <% @provider&.provider_personal_information_app_trackings.each do |app_tracking| %>
	                    <td>
	                      <% if app_tracking.master_issues.compact_blank.any? || app_tracking.master_reviews.compact_blank.any? %>
	                        Unclean
	                      <% else %>
	                        Clean
	                        <%#= app_tracking.file_status.present? ? app_tracking.file_status.upcase : "CLEAN" %>
	                      <% end %>
	                    </td>
	                <% end %>
			              <td clas></td>
			              <td clas></td>
			            </tr>
			          </tbody>
			        </table>
			        <span class="clear">
			        </span>
			      </div>
			    </div>
			    <div class="content-box mt-2">
			      <div class="content-box-header">
			        <h3>Verification Log</h3>
			      </div>
			      <div class="content-box-content">
			        <table class="fullwidth table table-bordered">
			          <thead>
			            <tr class="TableHeaderStyle2">
			              <th class="text-white">Verification Date</th>
			              <th class="text-white">Verification Item</th>
			            </tr>
			          </thead>
			          <tbody>
			          </tbody>
			        </table>
			        <span class="clear">
			        </span>
			      </div>
			    </div>
			    <div class="content-box mt-2">
					  <div class="content-box-header">
					    <h3>Review Level Changes</h3>
					  </div>
					  <div class="content-box-content">
					    <table class="fullwidth table table-bordered">
					      <thead>
					        <tr class="TableHeaderStyle2">
					          <th class="text-white">Change Date</th>
					          <th class="text-white">From</th>
					          <th class="text-white">To</th>
					          <th class="text-white">By</th>
					          <th class="text-white">Reason</th>
					        </tr>
					      </thead>
					      <tbody>
					        <% @review_level_changes.each do |change| %>
					          <tr>
					            <td><%= change.created_at.strftime('%m/%d/%Y') %></td>
					            <td><%= change.from_level %></td>
					            <td><%= change.to_level %></td>
					            <td><%= change.changed_by.truncate(30) %></td>
					            <td><%= change.reason %></td>
					          </tr>
					        <% end %>
					      </tbody>
					    </table>
					    <span class="clear"></span>
					  </div>
					</div>

			  <% end %>  

				<div id="change-review-level-container" class="col-lg-12 mt-2" style="display: none">
					<h3 class="mt-2 p-3" style="background-color: #E9E9E9;">Review Level Change</h3>
					<%= form_with url: record_approval_path, method: :patch do |form| %>
						<div class="form-group mb-3">
							<label for="record_status">Review Level:</label>
							<%= form.hidden_field :id, value: @provider.id %>
							
							<% if current_setting.mhc? %>
								<%= form.select :review_level, options_for_select([['All', ''], 'Clean', 'Unclean', 'Pending']), {}, { id: 'record_status', class: 'form-control' } %>
							<% else %>
								<%= form.select :review_level, options_for_select([['All', ''], 'Expedited', 'Non-Expedited', 'Clean', 'Unclean', 'Pending']), {}, { id: 'record_status', class: 'form-control' } %>
							<% end %>
						</div>
						
					  <div class="form-group mb-3" style="position: relative;">
					    <label for="">Reason to Change:</label>
					    <%= form.text_area :description, class:"form-control", style:"border: 1px solid #000;", cols:25 , rows:10, required: true %>

					    <!-- Placeholder for the checkbox, initially hidden -->
					    <div id="other-checkbox" style="position: absolute; top: 18px; left: 0; padding: 8px 0 0 10px; display: none;">
					      <input id="description" type="checkbox" name="description" value="OTHER:" tabindex="12">
					      <label for="description">OTHER: </label>
					    </div>
					  </div>

						<%= form.submit "Submit", class: "btn btn-primary" %>
					<% end %>	
				</div>
			</div>


		</div>
		<div class="col-lg-3">
			<%#= render 'sidebar_profile'%>
		</div>
	</div>
</div>

<% content_for :js do %>
<script>
	if($('body.navbar-vertical-aside-mini-mode').length == 0){
		setTimeout(function () {$('#navbar-aside-toggler').click();}, 1000);
	}

	$('#btn-change-review-level').on('click', function(){
		$('#change-review-level-container').fadeIn();
		$('#btn-profile').removeClass('btn-primary	').addClass('btn-light')
		$(this).removeClass('btn-light').addClass('btn-primary');
	});

	// $('#record_status').change(function() {
  //   $('#review-level')[0].innerHTML = this.value;
	// })

	$('#btn-profile').on('click', function(){
		$('#change-review-level-container').fadeOut();
		$('#btn-change-review-level').removeClass('btn-primary').addClass('btn-light');
		$(this).removeClass('btn-light	').addClass('btn-primary')
	});
	$(document).ready(function () {
	  const $recordStatus = $('#record_status');
	  const $descriptionTextarea = $('#description');
	  const $otherCheckbox = $('#other-checkbox input');

	  // Handle the change event on the select dropdown
	  $recordStatus.on('change', function () {
	    const selectedStatus = $(this).val();

	    if (selectedStatus === 'Non-Expedited') {
	      $descriptionTextarea[0].setAttribute('disabled', 'true');

	      // Show the disabled checkbox and label
	      $('#other-checkbox').show();

	    } else {
	      $descriptionTextarea[0].removeAttribute('disabled');

	      // Hide the checkbox
	      $('#other-checkbox').hide();
	    }
	  });

	  $recordStatus.trigger('change');
	});

</script>
<% end %>