<%# ------------- helpers ------------- %>
<% fmt = ->(d) { d.present? ? (d.respond_to?(:strftime) ? d.strftime("%m/%d/%Y") : Date.parse(d.to_s).strftime("%m/%d/%Y")) : "-" } %>

<%# A safe full name (works if your model doesn’t have `fullname`) %>
<% full_name = ->(r) do
     if r.respond_to?(:fullname) && r.fullname.present?
       r.fullname
     else
       parts = []
       parts << r.try(:last_name)
       parts << r.try(:first_name)
       parts << r.try(:middle_name)
       parts << r.try(:suffix)
       parts.compact.join(", ").gsub(" ,", ",").strip.upcase
     end
   end %>

<% records = @records.to_a %>

<%# totals and date range %>
<%
  totals = {
    credentialing: records.count { |r| r.try(:cred_cycle).to_s.strip.downcase == "credentialing" },
    recredentialing: records.count { |r| r.try(:cred_cycle).to_s.strip.downcase == "recredentialing" },
    total: records.size
  }
  dates = records.map(&:committee_date).compact.sort
  min_d, max_d = [dates.first, dates.last]
  sample = records.first
%>

<%# ---------- empty state ---------- %>
<% if records.blank? %>
  <div style="font-family: Helvetica, Arial, sans-serif; font-size:11pt; color:#000; margin:12px 0;">
    No completed records found.
  </div>
<% else %>

  <!-- ===== Summary ===== -->
  <div style="width:100%; font-family: Helvetica, Arial, sans-serif; font-size:10pt; color:#000; margin:8px 0 4px 0; padding:0;">
    <div style="margin:0 0 2px 0;">Report Generated: <%= fmt.call(Date.today) %></div>
    <div style="margin:0 0 2px 0;">Total Provider Count - Credentialing: <%= totals[:credentialing] %></div>
    <div style="margin:0 0 2px 0;">Total Provider Count - Recredentialing: <%= totals[:recredentialing] %></div>
    <div style="margin:0 0 2px 0;">Total Provider Count: <%= totals[:total] %></div>
  </div>

  <div style="border-top:1px solid #999; width:100%; margin:6px 0;"></div>

  <!-- ===== COMMITTEE DATES BETWEEN … ===== -->
  <div style="text-align:center; font-family: Helvetica, Arial, sans-serif; font-size:10pt; font-weight:700; color:#000; margin:20 0 0px 0; padding:0;">
    <% if min_d && max_d %>
      COMMITTEE DATES BETWEEN <%= fmt.call(min_d) %> and <%= fmt.call(max_d) %>
    <% elsif min_d %>
      COMMITTEE DATE: <%= fmt.call(min_d) %>
    <% else %>
      COMMITTEE DATES BETWEEN - and -
    <% end %>
  </div>

  <!-- ===== Gray 3-column band ===== -->
  <table style="width:100%; border-collapse:collapse; table-layout:fixed; margin:0 0 10px 0; padding:0;">
    <tr>
      <td style="width:33.333%; background:#D9D9D9; vertical-align:top; padding:6px 8px;">
        <div style="font-size:10pt; margin:0 0 2px 0;">Committee Date:</div>
        <div style="font-size:10pt; font-weight:700;"><%= sample&.committee_date ? fmt.call(sample.committee_date) : "-" %></div>
      </td>
      <td style="width:33.333%; background:#D9D9D9; vertical-align:top; padding:6px 8px;">
        <div style="font-size:10pt; margin:0 0 2px 0;">Event:</div>
        <div style="font-size:10pt; font-weight:700;"><%= sample&.cred_cycle.to_s.upcase %></div>
      </td>
      <td style="width:33.333%; background:#D9D9D9; vertical-align:top; padding:6px 8px;">
        <div style="font-size:10pt; margin:0 0 2px 0;">Report Category:</div>
        <div style="font-size:10pt; font-weight:700;"><%= sample&.review_level.to_s.upcase %></div>
      </td>
    </tr>
  </table>

  <!-- ===== Provider blocks (dynamic) ===== -->
  <% records.each_with_index do |r, i| %>
    <table style="width:100%; border-collapse:collapse; table-layout:fixed; margin:0; padding:0;">
      <tr>
        <td style="width:33.333%; vertical-align:top; padding:0 8px 0 0;">
          <div style="font-size:10pt; font-weight:700;">Provider:</div>
          <div style="font-size:10pt; font-weight:700; margin-top:2px;">
            <%= r.try(:caqh_provider_attest_id).presence || r.try(:provider_attest_id).to_s %>
          </div>
        </td>
        <td style="width:33.333%; vertical-align:top; padding:0 8px;">
          <div style="font-size:10pt; font-weight:700;">Name:</div>
          <div style="font-size:10pt; font-weight:700; margin-top:2px;"><%= full_name.call(r) %></div>
        </td>
        <td style="width:33.333%; vertical-align:top; padding:0 0 0 8px;">
          <div style="font-size:10pt; font-weight:700;">City:</div>
          <div style="font-size:10pt; font-weight:700; margin-top:2px;"><%= (r.try(:city) || r.try(:practice_city)).to_s.upcase %></div>
        </td>
      </tr>
    </table>

    <div style="font-family: Helvetica, Arial, sans-serif; font-size:10pt; color:#000; margin:8px 0 0 0; padding:0;">
      <div style="margin:2px 0;">Taxonomy: <%= r.try(:taxonomy).to_s %></div>
      <div style="margin:2px 0;">Provider/Org. Affiliation: <%= r.try(:affiliation).to_s %></div>
      <div style="margin:2px 0;">Credentials Requested: <%= r.try(:credentials_requested).to_s %></div>
      <div style="margin:2px 0;">Practicing Specialty: <%= r.try(:specialty).to_s %></div>
      <div style="margin:2px 0;">Results: <span style="font-weight: 700;"><%= (r.try(:status)).to_s %></span></div>

      <% if r.cred_cycle&.downcase == 'cred' %>
			  <% recred_date = r.recred_due_date || (Date.today + 2.years) %>
			  <div style="margin:2px 0;">
			    Recred Due Date: <span style="font-weight: 700;"><%= recred_date.strftime('%m/%d/%Y') %></span>
			  </div>
			<% else %>
				<div style="margin:2px 0;">
			    Recred Due Date: <span style="font-weight: 700;">NA</span>
			  </div>
			<% end %>


      <!-- Notes -->
      <div>Notes:</div>
      <ul style="margin:2px 0 0 16px; padding:0;">
        <%# prefer a notes field if you have it; otherwise show placeholders %>

        <% dea = ProviderDea.find_by(provider_attest_id: r.provider_attest_id)%>
				<% bullets = [] %>

				<% if dea&.expiration_date && dea.expiration_date <= Date.today %>
				  <% bullets << "<span style='font-weight:700;'>Expired DEA License (#{dea.expiration_date.strftime('%m/%d/%Y')})</span>" %>
				<% end %>

				<% if r.try(:notes).present? %>
				  <% bullets.concat(Array(r.notes)) %>
				<% else %>
				  <% bullets << "<span style='font-weight:700;'>No Issues</span>" if bullets.blank? %>
				<% end %>

				<ul style="margin:0; padding-left:16px;">
				  <% bullets.each do |line| %>
				    <li style="margin:0 0 2px 0;"><%= line.html_safe %></li>
				  <% end %>
				</ul>

      </ul>
    </div>

    <% unless i == records.size - 1 %>
      <div style="border-top:1px solid #999; width:100%; margin:12px 0;"></div>
    <% end %>
  <% end %>

<% end %>
