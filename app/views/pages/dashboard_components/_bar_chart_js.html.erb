function createBarGraph() {
  var ctx = document.getElementById("chartjs-bar");
  if (!ctx) return;

  if (barChart) barChart.destroy();

  barChart = new Chart(ctx, {
    type: "bar",
    data: {
      labels: [
        "Attested",
        "No Application",
        "Complete",
        "Incomplete",
        "Pending",
        "In Process",
        "PSV",
        "Returned"
      ],
      datasets: [{
        data: clientData,
        backgroundColor: [
          "#00a2ff",
          "#8f00ff",
          "#7bb31a",
          "#ff0032",
          "#ffc107",
          "#ff9800",
          "#000000",
          "#b74200"
        ],
        barPercentage: 0.6,
        categoryPercentage: 0.7
      }]
    },
   options: {
        maintainAspectRatio: false,
        legend: { display: false },

        scales: {
          xAxes: [{
            gridLines: { display: false },
            ticks: {
              display: false   // ✅ removes text under bars
            }
          }],
          yAxes: [{
            ticks: {
              beginAtZero: true,
              precision: 0
            },
            gridLines: { display: false }
          }]
        },

        tooltips: {
          enabled: true // keep hover popup
        }
      }
  });
}
