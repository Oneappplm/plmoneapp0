var clientData = [];
var clientPercentage = [];
var doughnutChart = null;
var barChart = null;

function getClientDataForDoughnutGraph() {
  $.ajax({
    url: '<%= mhc_client_portal_doughnut_data_path %>',
    method: "GET",
    success: function (data) {

      clientData = data.counts || [];
      clientPercentage = data.percentages || [];

      createDoughnutGraph();
      createBarGraph();

      // ✅ USE BACKEND LABELS (NO HARDCODING)
      var order_of_status = data.labels || [];

      order_of_status.forEach(function(status, index) {
        var percent = clientPercentage[index] || 0;

        $('.col-' + status)
          .html(percent + '%')
          .addClass('text-right');
      });

      console.log("Counts:", clientData);
      console.log("Percentages:", clientPercentage);
    }
  });
}

function createDoughnutGraph() {
  var ctx = document.getElementById("chartjs-doughnut");
  if (!ctx) return;

  if (doughnutChart) doughnutChart.destroy();

  doughnutChart = new Chart(ctx, {
    type: "doughnut",
    data: {
      labels: [
        "Attested",
        "No Application",
        "Complete Application",
        "Incomplete",
        "Pending",
        "In Process",
        "PSV",
        "Returned"
      ],
      datasets: [{
        data: clientData,
        backgroundColor: [
          "#00a2ff",
          "#8f00ff",
          "#7bb31a",
          "#ff0032",
          "#ffc107",
          "#ff9800",
          "#000000",
          "#b74200"
        ],
        borderWidth: 0
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      cutoutPercentage: 30,
      legend: { display: false },
      tooltips: { enabled: false }
    }
  });
}

$(document).ready(function () {
   getClientDataForDoughnutGraph();
});
