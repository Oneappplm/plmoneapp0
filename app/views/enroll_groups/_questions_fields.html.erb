<div class="questions">
  <div class="question-fields">
    <% detail.questions.build if detail.questions.blank? %>
    <%= detail.fields_for :questions do |q| %>
      <% question_index = q.index %>
      <div class="question-field mb-1 py-3">
        <div class="row">
          <div class="col-lg-6">
            <label class="text-dark-grey">Security Question</label>
            <input type="text" 
                   name="details[<%= index %>][questions][<%= question_index %>][secret_question]" 
                   value="<%= q.object.secret_question %>" 
                   placeholder="Type here" 
                   class="form-control border-dark">
          </div>
          <div class="col-lg-6">
            <label class="text-dark-grey">Answer</label>
            <input type="text" 
                   name="details[<%= index %>][questions][<%= question_index %>][answer]" 
                   value="<%= q.object.answer %>" 
                   placeholder="Type here" 
                   class="form-control border-dark">
          </div>
        </div>

        <div class="d-flex buttons gap-2 mt-2">
          <div class="links">
            <button type="button" class="add_questions py-1 btn btn-primary" onclick="addQuestions(this)">
              <i class="bi bi-plus"></i>
            </button>
          </div>

          <input type="checkbox" 
                 name="details[<%= index %>][questions][<%= question_index %>][_destroy]" 
                 style="display:none" 
                 <%= q.object._destroy ? 'checked' : '' %> >

          <% if q.object.id %>
            <button type="button" class="btn btn-danger btn-xs py-1 remove-dynamic-fields" 
                    onclick="deleteQuestions(this)" 
                    data-model="security_question" 
                    data-id="<%= q.object.id %>">
              <i class="bi bi-trash-fill"></i>
            </button>
          <% else %>
            <button type="button" class="btn btn-danger btn-xs py-1 remove-dynamic-fields" 
                    onclick="deleteQuestions(this)">
              <i class="bi bi-trash-fill"></i>
            </button>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
