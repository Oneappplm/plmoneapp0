<div class="field card mb-3 p-2 py-3 mt-3 payer-entry" data-id="<%= detail&.id %>"  data-index="<%= index %>">
  <input type="hidden" name="enrollment_provider[details_attributes][<%= index %>][id]" value="<%= detail&.id %>">
  <div class="row mb-3">
    <div class="col-lg-6">
        <label class="text-dark-grey">Enrollment Payor</label>
        <input 
          type="text" 
          name="enrollment_provider[details_attributes][<%= index %>][enrollment_payer]" 
          placeholder="Type here" 
          class="form-control border border-dark"
          value="<%= detail&.enrollment_payer %>">
      </div>

    <div class="col-lg-6">
      <label class="text-dark-grey">Enrollment Type</label>
      <select name="enrollment_provider[details_attributes][<%= index %>][enrollment_type]" class="form-select border border-dark">
        <option value="">Enrollment Type</option>
        <% EnrollmentProvider.enrollment_types.each do |label, value| %>
          <option value="<%= value %>" <%= 'selected' if detail.enrollment_type == value %>><%= label %></option>
        <% end %>
      </select>
    </div>

  </div>
  <% if current_setting.qualifacts? %>
    <div class="row mb-3 d-none">
      <div class="col-lg-6">
        <label class="text-dark-grey">CPT® Code</label>
        <input 
          type="text" 
          name="enrollment_provider[details_attributes][<%= index %>][cpt_code]" 
          placeholder="Type here" 
          class="form-control border border-dark">
      </div>
      <div class="col-lg-6">
        <label class="text-dark-grey">Descriptor</label>
        <input 
          type="text" 
          name="enrollment_provider[details_attributes][<%= index %>][descriptor]" 
          placeholder="Type here" 
          class="form-control border border-dark">
      </div>
    </div>
  <% end %>

  <div class="row mb-3">
    <div class="col-lg-6">
      <label class="text-dark-grey">Application Status</label>
      <select 
        name="enrollment_provider[details_attributes][<%= index %>][enrollment_status]" 
        class="form-select multi-enrollment-status border border-dark" 
        data-confirm-on-change="true">
        <option value="">Enrollment Status</option>
        <% enrollment_status.each do |label, value| %>
          <option value="<%= value %>" <%= 'selected' if detail.enrollment_status == value %>><%= label %></option>
        <% end %>
      </select>
    </div>

    <div class="col-lg-6">
      <label class="text-dark-grey">State <span class="text-danger">*</span></label>
      <select name="enrollment_provider[details_attributes][<%= index %>][payer_state]" class="form-select border-dark">
        <option value="">Select State</option>
        <% State.all.each do |state| %>
          <option value="<%= state.alpha_code %>" <%= 'selected' if detail&.payer_state == state.alpha_code %>><%= state.name %></option>
        <% end %>
      </select>
    </div>
  </div>


  <div class="row mb-3 date_field <%= detail&.enrollment_status.present? || detail&.enrollment_status == 'effective' ? '' : 'd-none' %>">
    <div class="col-lg-6">
      <label class="text-dark-grey">Application Submitted Date</label>
      <input 
        type="date" 
        name="enrollment_provider[details_attributes][<%= index %>][start_date]" 
        class="form-control border border-dark" 
        placeholder="MM/DD/YYYY"
        value="<%= detail&.start_date %>">
    </div>
  </div>


  <%# add all the date fields when effective is selected %>
  <div id="effective_date_id" class="mb-3 effective_date_field <%= detail&.enrollment_status == 'effective' || detail&.enrollment_status == 'approved' ? '' : 'd-none' %>">
    <div class="col-lg-6 mt-3">
      <label class="text-dark-grey">Initial Effective Date</label>
      <input 
        type="date" 
        name="enrollment_provider[details_attributes][<%= index %>][enrollment_effective_date]" 
        class="form-control border border-dark" 
        placeholder="MM/DD/YYYY" 
        value="<%= detail&.enrollment_effective_date %>">
    </div>

    <div class="row mt-3 mb-3">
      <div class="col-lg-6">
        <label class="text-dark-grey">Most Current Revalidation Date</label>
        <input 
          type="date" 
          name="enrollment_provider[details_attributes][<%= index %>][revalidation_date]" 
          class="form-control border border-dark" 
          placeholder="MM/DD/YYYY" 
          value="<%= detail&.revalidation_date %>">
      </div>

      <div class="col-lg-6">
        <label class="text-dark-grey">Revalidation Next Due Date</label>
        <input 
          type="date" 
          name="enrollment_provider[details_attributes][<%= index %>][revalidation_due_date]" 
          class="form-control border border-dark" 
          placeholder="MM/DD/YYYY" 
          value="<%= detail&.revalidation_due_date %>">
      </div>
    </div>

    <div class="col-lg-12">
      <label class="text-dark-grey">Line of Business (can be multiple)</label>
      <input 
        type="text" 
        name="enrollment_provider[details_attributes][<%= index %>][line_of_business]" 
        placeholder="Type here..." 
        class="form-control border border-dark" 
        value="<%= detail&.line_of_business %>">
    </div>
  </div>

  <div class="row mb-3 application-not-submitted-field">
    <div class="col-lg-6">
      <label class="text-dark-grey">Provider ID</label>
      <input 
        type="text" 
        name="enrollment_provider[details_attributes][<%= index %>][provider_id]" 
        placeholder="Medicare and Medicaid, PIN, etc." 
        class="form-control border border-dark" 
        value="<%= detail&.provider_id %>">
    </div>
  </div>


  <% if current_setting.affordablecare? %>
    <div class="row mb-3 application-not-submitted-field">
      <div class="col-lg-6">
        <label class="text-dark-grey">Tax ID</label>
        <input 
          type="text" 
          name="enrollment_provider[details_attributes][<%= index %>][tax_id]" 
          placeholder="Enter Tax ID" 
          class="form-control border border-dark" 
          value="<%= detail&.tax_id %>">
      </div>

      <div class="col-lg-6">
        <label class="text-dark-grey">Location</label>
        <input 
          type="text" 
          name="enrollment_provider[details_attributes][<%= index %>][location]" 
          placeholder="Enter Location" 
          class="form-control border border-dark" 
          value="<%= detail&.location %>">
      </div>
    </div>
  <% end %>

  <div class="row mb-3 processing-field <%= detail&.enrollment_status == 'processing' ? '' : 'd-none' %>">
    <div class="col-lg-6">
      <label class="text-dark-grey">Processing Date</label>
      <input 
        type="date" 
        name="enrollment_provider[details_attributes][<%= index %>][processing_date]" 
        class="form-control border border-dark" 
        placeholder="MM/DD/YYYY" 
        value="<%= detail&.processing_date %>">
    </div>
  </div>


  <div class="row mb-3 denied-field <%= detail&.enrollment_status == 'denied' ? '' : 'd-none' %>">
    <div class="col-lg-6">
      <label class="text-dark-grey">Denied Date</label>
      <input 
        type="date" 
        name="enrollment_provider[details_attributes][<%= index %>][denied_date]" 
        class="form-control border border-dark" 
        placeholder="MM/DD/YYYY" 
        value="<%= detail&.denied_date %>">
    </div>
  </div>


  <div class="row mb-3 terminated-field <%= detail&.enrollment_status == 'terminated' ? '' : 'd-none' %>">
    <div class="col-lg-6">
      <label class="text-dark-grey">Terminated Date</label>
      <input 
        type="date" 
        name="enrollment_provider[details_attributes][<%= index %>][terminated_date]" 
        class="form-control border border-dark" 
        placeholder="MM/DD/YYYY" 
        value="<%= detail&.terminated_date %>">
    </div>
  </div>


  <div class="row mb-2">
    <div class="col-lg-6">
      <label class="text-dark-grey">Email Address To Contact With Insurance</label>
      <input 
        type="text" 
        name="enrollment_provider[details_attributes][<%= index %>][payor_email]" 
        placeholder="Type here..." 
        class="form-control border border-dark" 
        value="<%= detail&.payor_email %>">
    </div>

    <div class="col-lg-6">
      <label class="text-dark-grey">Phone Number To Contact With Insurance</label>
      <input 
        type="text" 
        name="enrollment_provider[details_attributes][<%= index %>][payor_phone]" 
        placeholder="Type here..." 
        class="form-control border border-dark" 
        value="<%= detail&.payor_phone %>">
    </div>
  </div>

  <div class="row mb-2">
    <div class="col-lg-6">
      <label class="text-dark-grey">Username</label>
      <input 
        type="text" 
        name="enrollment_provider[details_attributes][<%= index %>][payor_username]" 
        placeholder="Type here..." 
        class="form-control border border-dark" 
        value="<%= detail&.payor_username %>">
    </div>

    <div class="col-lg-6">
      <label class="text-dark-grey">Password</label>
      <input 
        type="text" 
        name="enrollment_provider[details_attributes][<%= index %>][payor_password]" 
        placeholder="Type here..." 
        class="form-control border border-dark" 
        value="<%= detail&.payor_password %>">
    </div>
  </div>

  <!-- Questions -->
  <div class="question-fields">
    <% (detail.questions || [{}]).each_with_index do |q, q_index| %>
      <%= render 'enrollment_providers/questions_fields', q: q, index: index, q_index: q_index %>
    <% end %>
  </div>

  <!-- Add Question Button (outside loop) -->
  <button type="button" class="btn btn-primary add_questions" onclick="addQuestions(this)" style="width: fit-content!important;">
    <i class="bi bi-plus"></i>
  </button>

  <div class="row mb-2 mt-2 <%= current_setting.affordablecare? && !current_user.can_access?('Enrollment Details Notes') ? 'd-none' : '' %>">
    <div class="col-lg-12">
      <label class="text-dark-grey">Notes</label>
      <textarea 
        name="enrollment_provider[details_attributes][<%= index %>][comment]" 
        class="form-control border border-dark" 
        rows="8"><%= detail&.comment %></textarea>
    </div>
  </div>


  <div class="row mb-3">
    <div class="col-lg-12">
      <label>Upload</label>
      <input 
        type="file" 
        name="enrollment_provider[details_attributes][<%= index %>][upload_payor_file][]" 
        class="form-control" 
        multiple>
      
      <div class="d-flex gap-2">
        <% detail.upload_payor_file.each_with_index do |file, file_index| %>
          <div class="upload-payor-file">
            <input 
              type="hidden" 
              name="enrollment_provider[details_attributes][<%= index %>][upload_payor_file][]" 
              value="<%= file.identifier %>">
            <a href="<%= file.url %>" target="_blank">
              <%= file.identifier %>
              <!-- Optionally, add a remove icon -->
              <span class="remove-icon">×</span>
            </a>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <% detail.application_status_logs.each do |status_log| %>
    <div class="row application-status-history-log">
      <div class="col-lg-12">
        <small><strong><%= status_log.display_summary %></strong></small>
      </div>
    </div>
  <% end %>

   <input type="hidden" name="enrollment_provider[details_attributes][<%= index %>][_destroy]" class="destroy-field" value="0">


  <button type="button" class="btn btn-link text-danger position-absolute end-0 top-0 remove_payer">
    <i class="bi bi-x-circle"></i> Remove
  </button>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var enrollmentStatusSelect = document.getElementById('enrollment_status_id');
    var effectiveDateField = document.getElementById('effective_date_id');

    function toggleVisibility() {
      var selectedStatus = enrollmentStatusSelect.value;

      // Toggle effective date field
      if (selectedStatus === 'effective') {
        effectiveDateField.classList.remove('d-none');
      } else {
        effectiveDateField.classList.add('d-none');
      }
    }

    // Add event listener
    enrollmentStatusSelect.addEventListener('change', toggleVisibility);

    // Initialize visibility on page load
    toggleVisibility();
  });
</script>
<script>
document.addEventListener("DOMContentLoaded", function () {
  document.querySelectorAll("select[data-confirm-on-change]").forEach(function (select) {
    // clone element to remove old event listeners
    const newSelect = select.cloneNode(true);
    select.parentNode.replaceChild(newSelect, select);

    let previousValue = newSelect.value;

    newSelect.addEventListener("change", function () {
      let confirmed = confirm("Are you sure you want to change the status?");
      if (!confirmed) {
        newSelect.value = previousValue;
      } else {
        previousValue = newSelect.value;
      }
    });
  });
});
// Add new question dynamically
function addQuestions(button) {
  let container = $(button).closest('.payer-entry').find('.question-fields');
  let index = $(button).closest('.payer-entry').data('index');
  let q_index = container.children().length;

  let newField = `
    <div class="question-field mb-1 py-3">
      <div class="row">
        <div class="col-lg-6">
          <input type="text"
                 name="enrollment_provider[details_attributes][${index}][questions_attributes][${q_index}][question]"
                 class="form-control border-dark"
                 placeholder="Question">
        </div>
        <div class="col-lg-6">
          <input type="text"
                 name="enrollment_provider[details_attributes][${index}][questions_attributes][${q_index}][answer]"
                 class="form-control border-dark"
                 placeholder="Answer">
        </div>
      </div>
      <input type="hidden"
             name="enrollment_provider[details_attributes][${index}][questions_attributes][${q_index}][_destroy]"
             class="destroy-field" value="0">
      <button type="button" class="btn btn-danger btn-xs py-1 remove-dynamic-fields" onclick="deleteQuestions(this)">
        Remove
      </button>
    </div>
  `;

  container.append(newField);
}

// Mark question for destruction
function deleteQuestions(button) {
  let entry = $(button).closest('.question-field');
  entry.find('.destroy-field').val('1'); // Rails will delete this on save
  entry.hide();
}


</script>

