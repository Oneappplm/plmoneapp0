<div class="question-field mb-1 py-3">
  <input type="hidden" name="enrollment_provider[details_attributes][<%= index %>][questions_attributes][<%= q_index %>][id]" value="<%= q['id'] %>">
  <div class="row">
    <div class="col-lg-6">
      <input type="text" 
             name="enrollment_provider[details_attributes][<%= index %>][questions_attributes][<%= q_index %>][question]" 
             value="<%= q['question'] %>" 
             placeholder="Question" class="form-control border-dark">
    </div>
    <div class="col-lg-6">
      <input type="text" 
             name="enrollment_provider[details_attributes][<%= index %>][questions_attributes][<%= q_index %>][answer]" 
             value="<%= q['answer'] %>" 
             placeholder="Answer" class="form-control border-dark">
    </div>
  </div>

  <input type="hidden" 
         name="enrollment_provider[details_attributes][<%= index %>][questions_attributes][<%= q_index %>][_destroy]" 
         class="destroy-field" value="0">

  <button type="button" class="btn btn-danger btn-sm py-1 mt-2 remove-dynamic-fields" onclick="deleteQuestions(this)">
    <i class="bi bi-trash-fill"></i>
  </button>

</div>
