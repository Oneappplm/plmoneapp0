<div class="container-fluid d-flex flex-column ai-chat-layout">
  <div class="text-center py-3 flex-shrink-0">
    <h2>Welcome, <%= current_user.full_name %> 👋</h2>
    <h4 class="text-muted">
      <i class="fas fa-robot me-2"></i>
      Ask with AI Agent
    </h4>
  </div>

  <div class="flex-grow-1">
    <%= turbo_frame_tag "ai-result-frame" do %>
      <% if @input.present? %>
        <div class="d-flex flex-column gap-3 py-3">
          <%= render 'ai_queries/ai_result' %>
        </div>
      <% else %>
        <div class="d-flex align-items-center justify-content-center h-100" style="margin-top: -10vh;">
          <p class="text-muted fs-5 fw-bold">
            Start a conversation...
          </p>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class="border-top p-3 flex-shrink-0 bg-white">
    <%= form_with url: ai_queries_path,
          method: :post,
          id: "ai-query-form",
          data: { turbo_frame: "ai-result-frame" },
          class: "d-flex gap-2 align-items-center" do %>

      <%= text_field_tag :query, @input,
            class: 'form-control py-3 border-dark',
            placeholder: 'Type your question here...',
            autocomplete: 'off' %>

      <button type="submit" class="btn btn-primary px-4">
        <i class="fas fa-paper-plane"></i>
      </button>

      <%= link_to ai_queries_path,
            class: 'btn btn-outline-danger',
            data: { turbo_frame: "_top" } do %>
        <i class="fas fa-trash"></i>
      <% end %>
    <% end %>
  </div>
</div>

<style>
  html, body {
    height: 100%;
    overflow: hidden;
  }

  .ai-chat-layout {
    height: calc(100vh - 64px);
    overflow-x: hidden;
  }

  #ai-result-frame {
    scroll-behavior: smooth;
  }

  .border-top {
    position: sticky;
    bottom: 0;
    z-index: 10;
  }
</style>
