<%# app/views/ai_queries/results.html.erb %>

<div class="container-fluid d-flex flex-column ai-chat-layout">
  <div class="text-center py-3 flex-shrink-0">
    <h2>Welcome, <%= current_user.full_name %> 👋</h2>
    <h4 class="text-muted">
      <i class="fas fa-robot me-2"></i>
      Ask with AI Agent
    </h4>
  </div>

  <div class="flex-grow-1">
    <%#= turbo_frame_tag "ai-result-frame" do %>
      <% if @records.present? %>

      <!-- AI Explanation -->
        <div class="alert alert-light border shadow-sm mb-4">
          <strong>🤖 AI Response:</strong>
          <p class="mb-0 mt-2 text-muted">
            Showing <strong><%= @records.count %></strong>
            <%= @title %>.
            <% if @intent&.dig(:filter) == :expired %>
              These records have expiration dates earlier than today.
            <% elsif @intent&.dig(:filter) == :active %>
              These records are currently active.
            <% end %>
          </p>
        </div>
        
        <div class="d-flex flex-column gap-3 py-3">

          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-semibold text-secondary mb-0">
              <%= @title %>
            </h5>
            <span class="badge bg-primary">
              <%= @records.count %> Results
            </span>
          </div>

          <!-- Results Table -->
            <div class="card shadow-sm border-0 mb-5">
              <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                  <thead class="table-light">
                    <tr>
                      <% @columns.each do |column| %>
                        <th class="text-uppercase small fw-bold text-muted">
                          <%= column.to_s.titleize %>
                        </th>
                      <% end %>
                    </tr>
                  </thead>
                  <tbody>
                    <% @records.each do |record| %>
                      <tr>
                        <% @columns.each do |column| %>
                          <td>
                            <%= display_value(record, column) %>
                          </td>
                        <% end %>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </div>
        </div>
      <% else %>
        <div class="d-flex align-items-center justify-content-center h-100" style="margin-top: -10vh;">
          <p class="text-muted fs-5 fw-bold">
            Start a conversation...
          </p>
        </div>
      <% end %>
    <%# end %>
  </div>

  <div class="border-top p-3 flex-shrink-0 bg-white">
    <%= form_with url: ai_queries_path, method: :post, local: true, html: { id: "ai-search-form" } do |f| %>
      <div class="input-group">
        <%= f.text_field :query,
              class: "form-control form-control-lg rounded-pill",
              placeholder: "Ask something like 'expired DEA licenses'...",
              autocomplete: "off" %>

        <button class="btn btn-primary rounded-pill ms-2 px-4" type="submit">
          Ask
        </button>
        <%= link_to ai_queries_path,
            class: 'btn btn-outline-danger rounded-pill ms-2 ' do %>
          <i class="fas fa-trash"></i>
        <% end %>
      </div>

      <!-- Thinking Indicator -->
      <div id="ai-thinking" class="text-muted small mt-2 d-none">
        <span class="spinner-border spinner-border-sm me-2"></span>
        AI is thinking...
      </div>
    <% end %>
  </div>
</div>

<style>
  html, body {
    height: 100%;
  }

  .ai-chat-layout {
    height: calc(100vh - 64px); /* adjust if navbar height differs */
  }

  .ai-chat-layout > .flex-grow-1 {
    overflow-y: auto;
    padding-right: 4px; /* prevents scrollbar overlap */
  }

</style>
