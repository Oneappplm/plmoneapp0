<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">

  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 11px;
      line-height: 1.3;
      color: #000;
    }

    .education-letter {
      padding: 0 12px;
    }

    .recipient-block {
      margin-top: 8px;
      margin-bottom: 18px;
    }

    .recipient-block p {
      margin: 0 0 2px 0;
    }

    .letter-title {
      text-align: center;
      font-size: 14px;
      font-weight: bold;
      margin: 18px 0 24px;
    }

    .provider-details {
      width: 100%;
      margin-bottom: 22px;
    }

    .provider-details table {
      width: 100%;
      border-collapse: collapse;
    }

    .provider-details td {
      padding: 2px 0;
      vertical-align: top;
    }

    .provider-details .label {
      width: 120px;
    }

    .provider-details .value {
      font-weight: bold;
    }

    .verification-copy {
      margin-top: 16px;
      margin-bottom: 16px;
    }

    .verification-copy p {
      margin: 0 0 10px;
    }

    .return-instruction {
      font-weight: bold;
      margin: 14px 0 12px;
    }

    .questionnaire {
      margin-top: 24px;
      margin-left: 22px;
      margin-right: 22px;
    }

    .questionnaire p {
      margin: 0 0 9px;
    }

    .question-row {
      margin-bottom: 10px;
    }

    .answer-line {
      display: inline-block;
      border-bottom: 1px solid #000;
      height: 13px;
      vertical-align: bottom;
    }

    .line-program {
      width: 360px;
    }

    .line-degree {
      width: 355px;
    }

    .line-date {
      width: 390px;
    }

    .line-comments {
      width: 100%;
      display: block;
      margin-top: 5px;
    }

    .signature-section {
      margin-top: 36px;
      margin-left: 22px;
      margin-right: 22px;
    }

    .signature-row {
      margin-bottom: 12px;
    }

    .signature-line {
      display: inline-block;
      width: 230px;
      border-bottom: 1px solid #000;
      vertical-align: bottom;
    }

    .date-line {
      display: inline-block;
      width: 155px;
      border-bottom: 1px solid #000;
      vertical-align: bottom;
    }

    .phone-line {
      display: inline-block;
      width: 280px;
      border-bottom: 1px solid #000;
      vertical-align: bottom;
    }

    .print-line {
      display: inline-block;
      width: 330px;
      border-bottom: 1px solid #000;
      vertical-align: bottom;
    }

    .reference-number {
      margin-top: 55px;
      font-size: 10px;
    }

    .reference-line {
      display: inline-block;
      width: 120px;
      border-bottom: 1px solid #000;
      vertical-align: bottom;
    }
  </style>
</head>

<body>
  <div class="education-letter">

    <div class="recipient-block">
      <p><%= Time.current.in_time_zone("Pacific Time (US & Canada)").strftime("%B %-d, %Y") %></p>

      <div style="height:10px;"></div>

      <p><%= @education.institution_name.presence || "" %></p>

      <% if @education.address.present? %>
        <p><%= @education.address %></p>
      <% end %>

      <% if @education.suite_dept_mail_stop.present? %>
        <p><%= @education.suite_dept_mail_stop %></p>
      <% end %>

      <% location_parts = [@education.city, @education.state].compact_blank %>
      <% location = location_parts.join(", ") %>
      <% location = [location, @education.postal_code].compact_blank.join(" ") %>

      <% if location.present? %>
        <p><%= location %></p>
      <% end %>
    </div>

    <div class="letter-title">
      Professional School Education Verification
    </div>

    <div class="provider-details">
      <table>
        <tr>
          <td class="label">Re:</td>
          <td class="value"><%= @ppi.full_name %></td>
        </tr>

        <tr>
          <td class="label">DOB:</td>
          <td class="value"><%= @ppi.birth_date&.strftime("%B %-d, %Y") %></td>
        </tr>

        <tr>
          <td class="label">Program Title:</td>
          <td class="value"><%= @education.program_title.presence || "" %></td>
        </tr>

        <tr>
          <td class="label">Degree Received:</td>
          <td class="value"><%= @education.degree_degree_abbreviation.presence || "" %></td>
        </tr>

        <tr>
          <td class="label">Attendance Dates:</td>
          <td class="value">
            <%= [
                  @education.start_date&.strftime("%m/%d/%Y"),
                  @education.end_date&.strftime("%m/%d/%Y")
                ].compact.join("– ") %>
          </td>
        </tr>
      </table>
    </div>

    <div class="verification-copy">
      <p>
        The noted practitioner has stated completion of education as above.
        A copy of the practitioner’s signed authorization and release is attached.
        Please complete the following questionnaire.
        Any additional information you may have regarding this practitioner is greatly appreciated.
      </p>

      <p class="return-instruction">
        PLEASE FAX THE COMPLETED FORM TO 877.303.5180 OR EMAIL TO CVOACADEMICS@MEDVERSANT.COM
      </p>

      <p>Thank you for your assistance.</p>
    </div>

    <div class="questionnaire">
      <p style="text-align:center;">
        Is the above information correct?
        &nbsp;&nbsp;&nbsp;&nbsp;□ Yes
        &nbsp;&nbsp;&nbsp;&nbsp;□ No
      </p>

      <p>If No, please provide the correct information:</p>

      <div class="question-row">
        Program Title:
        <span class="answer-line line-program"></span>
      </div>

      <div class="question-row">
        Degree Received:
        <span class="answer-line line-degree"></span>
      </div>

      <div class="question-row">
        From:
        <span class="answer-line line-date"></span>
      </div>

      <div class="question-row">
        To:
        <span class="answer-line line-date"></span>
      </div>

      <div class="question-row">
        Comments:
        <span class="answer-line line-comments"></span>
        <span class="answer-line line-comments"></span>
        <span class="answer-line line-comments"></span>
      </div>
    </div>

    <div class="signature-section">
      <div class="signature-row">
        Signature:
        <span class="signature-line"></span>

        &nbsp;&nbsp;Date:
        <span class="date-line"></span>
      </div>

      <div class="signature-row">
        Phone:
        <span class="phone-line"></span>
      </div>

      <div class="signature-row">
        Print Name/Title:
        <span class="print-line"></span>
      </div>
    </div>

    <div class="reference-number">
      Ref No.:
      <span class="reference-line"></span>
    </div>
  </div>
</body>
</html>