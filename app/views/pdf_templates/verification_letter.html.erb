<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    @page {
      margin: 100px 25px; /* leaves space for header/footer */
    }
    body {
      font-family: 'Liberation Serif', serif;
      font-size: 18pt;
      color: #000;
    }

    hr.divider {
      border: none;
      border-top: 1px solid #000;
      margin: 12px 0;
    }


    h2 {
      text-align: center;
      font-size: 18pt;
      font-weight: bold;
      margin-bottom: 0.4in;
      text-decoration: underline;
    }

    p {
      margin: 0 0 8px 0;
    }

    .spacer {
      height: 8px;
    }

    .signature-block {
      margin-top: 0.5in;
    }
  </style>
</head>

<body>
  <!-- ===== BODY ===== -->
  <main>
    <p style="margin-top: 80PX!important;"><%= Date.current.strftime("%B %e, %Y") %></p>
    <div class="spacer"></div>
    <p style="margin-bottom: 0; padding-bottom: 0;"><%= @record.institution_name.presence %></p>
    <p style="margin-top: 0; padding-top: 0;"><%= @record.address.presence %></p>
    <div class="spacer"></div>
    <% if @tab == 'education' %>
      <p style="margin-bottom: 0; padding-bottom: 0;"><%= @record.suite_dept_mail_stop.presence %></p>
    <% end %>
    <p style="margin-top: 0; padding-top: 0;"><%= @record.city.presence %> <%= @record.state.presence %> <%= @record.postal_code.presence %></p>

    <% if @tab == 'education' %>
      <h2>Professional School Education Verification</h2>
    <% elsif  @tab == 'training' %>
      <h2>Professional Training Verification</h2>
    <% end %>  

    <div class="indent">
      <p>Re:&nbsp;&nbsp;<strong style="margin-left:20px !important;"><%= @ppi.full_name %></strong></p>
      <p>DOB:&nbsp;&nbsp;<strong style="margin-left:20px !important;"><%= @ppi.birth_date&.strftime("%B %e, %Y") %></strong></p>
      <div class="spacer"></div>
      <% if @tab == 'education' %>
        <p>Program Title:&nbsp;&nbsp;<strong style="margin-left:20px !important;"><%= @record.program_title.presence %></strong></p>
      <% elsif @tab == 'training' %> 
        <p>Type of Training:&nbsp;&nbsp;<strong style="margin-left:20px !important;"><%= @record.training_area.presence %></strong></p> 
      <% end %>  
      <% if @tab == 'education' %>
        <p>Degree Received:&nbsp;&nbsp;<strong style="margin-left:20px !important;"><%= @record.degree_degree_abbreviation.presence %></strong></p>
      <% elsif @tab == 'training' %>
        <p>Specialty:&nbsp;&nbsp;<strong style="margin-left:20px !important;"><%= @record.specialty_specialty_name.presence %></strong></p>
      <% end %>  
      <% if @tab == 'education' %>
        <p>
          Attendance Dates:&nbsp;&nbsp;
          <strong style="margin-left:20px !important;"><%= [
                @record.start_date&.strftime("%m/%d/%Y"),
                @record.end_date&.strftime("%m/%d/%Y")
              ].compact.join("–") %></strong>
        </p>
      <% elsif @tab == 'training' %>
        <p>From:&nbsp;&nbsp;<strong style="margin-left:20px !important;"><%= @record.start_date&.strftime("%m/%d/%Y") %></strong></p>
        <p>To:&nbsp;&nbsp;<strong style="margin-left:20px !important;"><%= @record.end_date&.strftime("%m/%d/%Y") %></strong></p>
      <% end %>  
    </div>

    <div class="spacer"></div>

    <p style="margin-top: 20px !important;">
      The above named practitioner has applied for membership to the staff of a Heritage Valley Health System hospital.
      The noted practitioner has stated completion of education as above. A copy of the practitioner’s signed authorization and release is attached.
    </p>

    <div class="spacer"></div>

    <p>Is the above information correct?&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Yes&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;No</p>
    <p>If No, please provide the correct information in the spaces provided below:</p>

    <div class="indent">
      <p>Program Title: </p>
      <p>Degree Received: ____________________ &nbsp;&nbsp;From: ____________________ &nbsp;&nbsp;To: ____________________</p>
      <p>Comments:</p>
    </div>

    <p>
      Any additional information you may have regarding this practitioner is greatly appreciated.
    </p>

    <p>
      Consider that without your verification of this information, the application is incomplete and processing cannot move forward.
    </p>

    <p>Thank you in advance for your cooperation.</p>

    <div class="signature-block">
      <p>Print Name/Title: _____________________________________</p>
      <p>Signature: __________________________ Date: ___________</p>
      <p>Phone: ______________________________ Email: ____________________________</p>
    </div>

    <div class="spacer"></div>
    <p style="margin-top: 30px !important; padding-bottom: 30px!important;"><strong>PLEASE FORWARD THIS COMPLETED FORM TO THE FAX NUMBER OR E-MAIL INDICATED BELOW.</strong></p>
  </main>
</body>
</html>
