<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">

  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 10.5px;
      line-height: 1.22;
      color: #000;
    }

    .peer-additional-info {
      width: 92%;
      margin: 6px auto 0;
    }

    .section-heading {
      margin: 4px 0 3px;
      font-size: 14px;
      font-weight: bold;
      text-decoration: underline;
    }

    .section-intro {
      margin: 0 0 13px;
      line-height: 1.25;
      font-size: 12px;
    }

    .question-table {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
    }

    .question-table td {
      padding: 4px 1px;
      vertical-align: top;
    }

    .question-letter {
      width: 20px;
      font-weight: normal;
    }

    .question-text {
      width: auto;
      padding-right: 8px !important;
    }

    .question-answer {
      width: 58px;
      padding-left: 8px !important;
      white-space: nowrap;
    }

    .answer-row {
      margin: 0 0 2px;
      white-space: nowrap;
    }

    .checkbox {
      display: inline-block;
      width: 8px;
      height: 8px;
      margin-right: 4px;
      border: 1px solid #000;
      vertical-align: middle;
      box-sizing: border-box;
    }

    .comment-line {
      width: 86%;
      height: 12px;
      margin-top: 4px;
      border-bottom: 1px solid #000;
    }

    .recommendations {
      margin-top: 16px;
    }

    .recommendations-title,
    .report-title {
      margin: 0 0 6px;
      font-size: 10.5px;
      font-weight: bold;
      text-decoration: underline;
    }

    .recommendation-option,
    .report-option {
      margin: 0 0 4px 20px;
    }

    .recommendation-note {
      margin: 6px 0 0 20px;
      font-weight: bold;
    }

    .report-based-on {
      margin-top: 15px;
    }

    .other-line {
      display: inline-block;
      width: 68%;
      height: 9px;
      margin-left: 5px;
      border-bottom: 1px solid #000;
      vertical-align: bottom;
    }
  </style>
</head>

<body>
  <div class="peer-additional-info">

    <div class="section-heading">
      ADDITIONAL INFORMATION:
    </div>

    <p class="section-intro">
      Please answer the following questions to the best of your knowledge.
      For any “yes” answer to questions A thru E please provide explanation on an additional sheet of paper.
    </p>

    <table class="question-table">
      <tr>
        <td class="question-letter">A.</td>

        <td class="question-text">
          During the time period, has the practitioner ever been placed on probation,
          concurrent or retrospective review, or been subject to monitoring (other
          than routine), mandatory consultations or second opinions (other than for
          utilization review) by a hospital, or health care entity?
        </td>

        <td class="question-answer">
          <div class="answer-row"><span class="checkbox"></span>Yes</div>
          <div class="answer-row"><span class="checkbox"></span>No</div>
        </td>
      </tr>

      <tr>
        <td class="question-letter">B.</td>

        <td class="question-text">
          Did the practitioner ever attend patients while he/she was under the influence of alcohol or drugs?
        </td>

        <td class="question-answer">
          <div class="answer-row"><span class="checkbox"></span>Yes</div>
          <div class="answer-row"><span class="checkbox"></span>No</div>
        </td>
      </tr>

      <tr>
        <td class="question-letter">C.</td>

        <td class="question-text">
          Has the practitioner ever been a defendant in a medical malpractice action?
        </td>

        <td class="question-answer">
          <div class="answer-row"><span class="checkbox"></span>Yes</div>
          <div class="answer-row"><span class="checkbox"></span>No</div>
        </td>
      </tr>

      <tr>
        <td class="question-letter">D.</td>

        <td class="question-text">
          Has the practitioner ever been a defendant in a felony criminal matter?
        </td>

        <td class="question-answer">
          <div class="answer-row"><span class="checkbox"></span>Yes</div>
          <div class="answer-row"><span class="checkbox"></span>No</div>
        </td>
      </tr>

      <tr>
        <td class="question-letter">E.</td>

        <td class="question-text">
          Are you aware of any physical, mental, behavioral or emotional health
          problems, which would prevent this practitioner from competently
          performing the privileges, requested or specialty listed?
        </td>

        <td class="question-answer">
          <div class="answer-row"><span class="checkbox"></span>Yes</div>
          <div class="answer-row"><span class="checkbox"></span>No</div>
        </td>
      </tr>

      <tr>
        <td class="question-letter">F.</td>

        <td class="question-text">
          Are you aware of any other training programs in which this practitioner has
          been enrolled? If yes, please comment:

          <div class="comment-line"></div>
        </td>

        <td class="question-answer">
          <div class="answer-row"><span class="checkbox"></span>Yes</div>
          <div class="answer-row"><span class="checkbox"></span>No</div>
          <div class="answer-row"><span class="checkbox"></span>N/A</div>
        </td>
      </tr>

      <tr>
        <td class="question-letter">G.</td>

        <td class="question-text">
          Can you determine that the practitioner is reasonably competent in the privileges requested or specialty listed?
        </td>

        <td class="question-answer">
          <div class="answer-row"><span class="checkbox"></span>Yes</div>
          <div class="answer-row"><span class="checkbox"></span>No</div>
          <div class="answer-row"><span class="checkbox"></span>N/A</div>
        </td>
      </tr>

      <tr>
        <td class="question-letter">H.</td>

        <td class="question-text">
          Did the practitioner complete his/her training program?
        </td>

        <td class="question-answer">
          <div class="answer-row"><span class="checkbox"></span>Yes</div>
          <div class="answer-row"><span class="checkbox"></span>No</div>
          <div class="answer-row"><span class="checkbox"></span>N/A</div>
        </td>
      </tr>
    </table>

    <div class="recommendations">
      <div class="recommendations-title">
        RECOMMENDATIONS (Please check one)
      </div>

      <div class="recommendation-option">
        <span class="checkbox"></span>
        Recommend as qualified and competent.
      </div>

      <div class="recommendation-option">
        <span class="checkbox"></span>
        Recommend with some reservation.
      </div>

      <div class="recommendation-option">
        <span class="checkbox"></span>
        Do not recommend.
      </div>

      <div class="recommendation-note">
        If you do not recommend or have reservations, please attach explanation.
      </div>
    </div>

    <div class="report-based-on">
      <div class="report-title">
        REPORT IS BASED ON (Please check all appropriate)
      </div>

      <div class="report-option">
        <span class="checkbox"></span>
        Close personal observation.
      </div>

      <div class="report-option">
        <span class="checkbox"></span>
        Working directly with applicant, either in surgery or treatment of patients.
      </div>

      <div class="report-option">
        <span class="checkbox"></span>
        Information contained in the practitioner’s file.
      </div>

      <div class="report-option">
        <span class="checkbox"></span>
        Other
        <span class="other-line"></span>
      </div>
    </div>

  </div>
</body>
</html>