<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">

  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 10.5px;
      line-height: 1.22;
      color: #000;
    }

    .peer-comments-page {
      width: 92%;
      margin: 6px auto 0;
    }

    .comments-heading {
      font-size: 11px;
      font-weight: bold;
      margin-bottom: 10px;
    }

    .response-line {
      width: 100%;
      height: 16px;
      border-bottom: 1px solid #000;
      margin-bottom: 8px;
    }

    .capacity-heading {
      margin-top: 30px;
      margin-bottom: 10px;
      font-size: 11px;
      font-weight: bold;
    }

    .signature-section {
      margin-top: 38px;
    }

    .signature-row {
      width: 100%;
      margin-bottom: 18px;
      white-space: nowrap;
    }

    .field-line {
      display: inline-block;
      height: 12px;
      border-bottom: 1px solid #000;
      vertical-align: bottom;
    }

    .signature-line {
      width: 42%;
    }

    .date-line {
      width: 28%;
    }

    .name-title-line {
      width: 72%;
    }

    .fax-line {
      width: 36%;
    }

    .phone-line {
      width: 31%;
    }
  </style>
</head>

<body>
  <div class="peer-comments-page">

    <div class="comments-heading">
      COMMENTS (Notable strengths/weaknesses)
    </div>

    <div class="response-line"></div>

    <div class="capacity-heading">
      IN WHAT CAPACITY AND HOW LONG HAVE YOU KNOWN THIS PRACTITIONER?
    </div>

    <div class="response-line"></div>

    <div class="signature-section">

      <div class="signature-row">
        Signature:
        <span class="field-line signature-line"></span>

        &nbsp;&nbsp;&nbsp;&nbsp;

        Date:
        <span class="field-line date-line"></span>
      </div>

      <div class="signature-row">
        Print Name/Title:
        <span class="field-line name-title-line"></span>
      </div>

      <div class="signature-row">
        Fax:
        <span class="field-line fax-line"></span>

        &nbsp;&nbsp;&nbsp;&nbsp;

        Phone:
        <span class="field-line phone-line"></span>
      </div>

    </div>

  </div>
</body>
</html>