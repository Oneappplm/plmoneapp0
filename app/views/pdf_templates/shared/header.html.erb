<div style="width:100%; font-family:'Liberation Serif','Times New Roman',serif; padding:5px 10px;">

  <div style="display:table; width:100%; table-layout:fixed;">
    <div style="display:table-row;">

      <!-- LEFT SIDE -->
      <div style="display:table-cell; width:40%; vertical-align:top; text-align:left;">
        <%= image_tag wicked_pdf_asset_base64('heritage_valley_logo.png'),
              style: 'width:300px; height:100px; display:block; margin-bottom:3px;',
              alt: 'Heritage Valley Logo' %>
      </div>

      <!-- RIGHT SIDE -->
      <div style="display:table-cell; width:60%; vertical-align:top; text-align:left; font-size:18px; color:#000;">
        <div style="display:inline-block; width:48%; vertical-align:top; line-height:1.3; margin-right:2%;">
          <p style="margin:0;">
            <strong>Heritage Valley Beaver</strong><br>
            1000 Dutch Ridge Road<br>
            Beaver, PA 15009
          </p>
        </div>

        <div style="display:inline-block; width:48%; vertical-align:top; line-height:1.3;">
          <p style="margin:0;">
            <strong>Heritage Valley Sewickley</strong><br>
            720 Blackburn Road<br>
            Sewickley, PA 15143
          </p>
        </div>
      </div>

    </div>
  </div>
</div>
