<div class="content container-fluid">
  <%= render partial: "verification_platform/encompass_nav" %>
</div>
<div class="container-fluid text-center">
  <h3>Select the folder containing the flat files:
    <input id="file_id" type="file" webkitdirectory mozdirectory name="files" multiple=true/>
  </h3>
  <button class="button btn btn-primary" id="submit-files" disabled>Submit</button>
  <hr>
  <h3>Select PDF file(s):</h3>
  <input id="pdf_files" type="file" accept="application/pdf" multiple />
  <br/>
  <button class="btn btn-success mt-3" id="submit-pdf-files">
    Upload PDF File(s)
  </button>
</div>
<script>
  $(document).ready(function() {
    var inps = document.querySelectorAll('#file_id');
    [].forEach.call(inps, function(inp) {
      inp.onchange = function(e) {
        if(this.files.length > 0){
          $('#submit-files').prop('disabled', false)
        }
      };
    });
    $('#submit-pdf-files').on("click", function() {
      var data = new FormData();
      $.each($("#pdf_files")[0].files, function(i, file) {
        data.append(file.name, file);
      });

      $.ajax({
        type: 'POST',
        url: '/caqh/upload_pdf',
        cache: false,
        contentType: false,
        processData: false,
        data : data,
        beforeSend: function() {
          $('#submit-pdf-files').prop('disabled', true).html('Processing…');
        },
        success: function(result){
          if (result.redirect_url) {
            window.location.href = result.redirect_url;
          } else {
            alert("PDF processed!");
            console.log(result);
          }
        },
        error: function(err){
          alert('Error uploading PDF.');
        },
        complete: function() {
          $("#pdf_files").val('');
          $('#submit-pdf-files').prop('disabled', true).html('Upload PDF File(s)');
        }
      });

      return false;
    });


    $('#submit-files').on("click", function(e){
      var data = new FormData();
      $.each($("input[id='file_id']")[0].files, function(i, file) {
        data.append(file.name.split(".")[0], file);
      });

      $.ajax({
        type: 'POST',
        url: '/caqh/upload',
        cache: false,
        contentType: false,
        processData: false,
        data : data,
        beforeSend: function() {
          $('#submit-files').prop('disabled', true)
          $('#submit-files').html('Processing')
        },
        success: function(result){
          console.log(result);
          alert('Files uploaded successfully!');
        },
        error: function(err){
          console.log(err);
          alert('An error occurred while uploading files.');
        },
        complete: function() {
          $("#file_id").val('')
          $('#submit-files').prop('disabled', true)
          $('#submit-files').html('Submit')
        }
      })
      return false;
    })
  });
</script>
