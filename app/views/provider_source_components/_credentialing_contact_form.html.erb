<form>
<div class="row mb-3">
	<div class="col-lg-8">
    <label class="text-dark-grey">Preferred Method of Contact</label>
		<select class="form-select border-dark" name="cc-preferred-contact" data-model="cred_contact">
			<option value="">Preferred Method of Contact</option>
			<option value="Email">Email</option>
			<option selected="selected" value="Fax">Fax</option>
			<option value="Mail">Mail</option>
		</select>
	</div>
</div>
<div class="row mb-3">
	<div class="col-lg-6">
    <label class="text-dark-grey">First Name <span class="text-danger">*</span></label>
		<input type="text" class="form-control border-dark" required placeholder="First Name" name="cc-first-name" data-model="cred_contact">
	</div>
	<div class="col-lg-6">
    <label class="text-dark-grey">Last Name <span class="text-danger">*</span></label>
		<input type="text" class="form-control border-dark" required placeholder="Last Name" name="cc-last-name" data-model="cred_contact">
	</div>
</div>
<div class="row mb-3">
	<div class="col-lg-6">
    <label class="text-dark-grey">Address Line 1</label>
		<input type="text" class="form-control border-dark" required placeholder="Address Line 1" name="cc-address-line1" data-model="cred_contact">
	</div>
	<div class="col-lg-6">
    <label class="text-dark-grey">Address Line 2</label>
		<input type="text" class="form-control border-dark" required placeholder="Address Line 2" name="cc-address-line2" data-model="cred_contact">
	</div>
</div>
<div class="row mb-3">
	<div class="col-lg-6">
    <label class="text-dark-grey">City <span class="text-danger">*</span></label>
		<input type="text" class="form-control border-dark" required placeholder="City" name="cc-city" data-model="cred_contact">
	</div>
	<div class="col-lg-6">
		<%= HtmlUtils::dropdown name: 'cc-state', label: 'State', data: { model: 'cred_contact' }  %>
	</div>
</div>
<div class="row mb-3">
	<div class="col-lg-6">
    <label class="text-dark-grey">Zip Code <span class="text-danger">*</span></label>
		<input type="text" class="form-control border-dark" required placeholder="Zip Code *" name="cc-zipcode" data-model="cred_contact">
	</div>
</div>

<div class="row mb-3">
	<div class="col-lg-6">
		<div class="row">
			<div class="col-lg-8">
        <label class="text-dark-grey">Telephone Number <span class="text-danger">*</span></label>
				<input type="text" class="form-control border-dark" name="cc-telephone-number" placeholder="Telephone Number *" data-model="cred_contact" required>
			</div>
			<div class="col-lg-4">
        <label class="text-dark-grey">Ext</label>
				<input type="text" class="form-control border-dark" name="cc-ext" placeholder="Ext" data-model="cred_contact">
			</div>
		</div>
	</div>
	<div class="col-lg-6">
    <label class="text-dark-grey">Fax Number <span class="text-danger">*</span></label>
		<input type="text" class="form-control border-dark" name="cc-fax-number" placeholder="Fax Number *" data-model="cred_contact" required>
	</div>
</div>
<div class="row mb-3">
	<div class="col-lg-6">
    <label class="text-dark-grey">Mobile Number</label>
		<input type="text" class="form-control border-dark" required placeholder="Mobile Number" name="cc-mobile-number" data-model="cred_contact">
	</div>
	<div class="col-lg-6">
			<label class="text-dark-grey">Email Address <span class="text-danger">*</span></label>
      <input type="email" class="form-control border-dark" placeholder="Email Address *" required name="cc-email-address" data-model="cred_contact">
      <div class="invalid-feedback">
        Please provide a valid email.
      </div>
		<span class="d-flex align-items-center">
			<input type="checkbox" name="does_not_have_email" data-model="cred_contact">
			<small class="ms-2 fw-bold">Does not have</small>
		</span>
	</div>
</div>
<!-- <div class="row">
	<div class="col-lg-12 mb-3 d-flex justify-content-end">
		  	<button class="btn btn-primary">Save This Record</button>
	</div>
</div> -->
</form>