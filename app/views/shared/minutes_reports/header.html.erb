<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
  </head>
  <body style="margin:0;padding:0;">
    <!-- HEADER WRAPPER -->
    <div style="width:100%; font-family: Helvetica, Arial, sans-serif; font-size:10pt; color:#000; margin:0; padding:0;">
      <table style="width:100%; border-collapse:collapse; margin:0; padding:0;">
        <tr>
          <!-- LEFT EMPTY -->
          <td style="width:20%;"></td>

          <!-- RIGHT SIDE TEXT (single line) -->
          <td style="width:80%; text-align:right; vertical-align:middle; padding:8px 0;line-height:1.5">
            <div style="font-size:12pt; font-weight:700; line-height:1.3; white-space:nowrap;">
              Peer Review Credentialing Committee Minutes by
            </div>
            <div style="width:80%;font-size:12pt; font-weight:700;text-align:right;">
            	Provider Name - NCQA Version
            </div>
          </td>
        </tr>
      </table>

      <!-- BOTTOM BORDER LINE -->
      <div style="border-top:2px solid #000; width:100%; margin-top:6px;"></div>
    </div>
  </body>
</html>
